# Rust Chat Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Database (same as Next.js)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/n0va

# Redis (event bridge between Rust and Next.js)
REDIS_URL=redis://localhost:6379

# JWT Validation (must match NextAuth AUTH_SECRET)
JWT_SECRET=your-jwt-secret-here

# Next.js API (for REST calls back to the monolith)
NEXTJS_API_URL=http://localhost:3000

# Logging
RUST_LOG=info,chat_gateway=debug
