{
  "name": "onespace",
  "version": "0.1.0",
  "private": true,
  "description": "N0VA Workspace — a single Enterprise System built as a Modular Suite",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @n0va/db run db:migrate",
    "db:seed": "pnpm --filter @n0va/db run db:seed",
    "ani:smoke": "tsx packages/ani-smoke-test.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}