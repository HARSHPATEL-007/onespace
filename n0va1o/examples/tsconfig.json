{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "@n0va1o/core": ["packages/core/src"],
      "@n0va1o/sdk": ["packages/sdk/src"],
      "@n0va1o/connectors": ["packages/connectors/src"],
      "@n0va1o/sandbox": ["packages/sandbox/src"],
      "@n0va1o/hitl": ["packages/hitl/src"],
      "@n0va1o/recipes": ["packages/recipes/src"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "require": ["tsconfig-paths/register"]
  },
  "include": ["./*.ts", "../packages/*/src/**/*.ts"]
}
