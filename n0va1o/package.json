{
  "name": "@n0va1o/monorepo",
  "version": "2026.07.0",
  "private": true,
  "description": "N0VA1O Infinite Integration Gateway — Unified MCP Gateway for AI Agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/core && npm run build --workspace packages/sdk && npm run build --workspace packages/connectors && npm run build --workspace packages/sandbox && npm run build --workspace packages/hitl && npm run build --workspace packages/recipes",
    "build:core": "cd packages/core && npx tsc",
    "build:sdk": "cd packages/sdk && npx tsc",
    "build:connectors": "cd packages/connectors && npx tsc",
    "build:sandbox": "cd packages/sandbox && npx tsc",
    "build:hitl": "cd packages/hitl && npx tsc",
    "build:recipes": "cd packages/recipes && npx tsc",
    "example": "npx ts-node -P examples/tsconfig.json -r tsconfig-paths/register examples/full-workflow.ts",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "eslint": "^9.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "tsconfig-paths": "^4.2.0"
  }
}
