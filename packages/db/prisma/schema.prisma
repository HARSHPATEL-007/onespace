/// Unified monitoring object: aggregates all signals for a scope (message, thread, room, topic).
model ConversationMonitor {
  id          String        @id @default(uuid())
  monitorId   String        @unique
  scope       String
  workspaceId String
  channelId   String?
  threadId    String?
  messageId   String?
  signals     Json          @default("{}") // { sentiment, toxicity, conflict_risk, engagement_health }
  insights    Json          @default("{}") // { topic, suggested_expert, faq_candidate }
  actions     String[]      @default([])
  status      MonitorStatus @default(OBSERVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message   ChatMessage?  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([scope, createdAt(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([threadId, createdAt(sort: Desc)])
}

/// Per-message sentiment scores + topic/sender/room aggregation source rows.
model SentimentRecord {
  id          String     @id @default(uuid())
  workspaceId String
  channelId   String?
  threadId    String?
  messageId   String?
  senderId    String?
  topic       String?
  score       Float      @default(0) // -1..1
  confidence  Float      @default(0)
  createdAt   DateTime   @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message   ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([threadId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@index([topic, createdAt(sort: Desc)])
}

/// Toxicity flag with a detected moderation action + review status.
model ToxicityFlag {
  id          String            @id @default(uuid())
  workspaceId String
  channelId   String?
  threadId    String?
  messageId   String?
  senderId    String?
  score       Float             @default(0)
  categories  String[]          @default([]) // HATE, HARASSMENT, PROFANITY, ABUSE, SPAM, OTHER
  action      ModerationAction  @default(ALLOW)
  policy      ModerationPolicy  @default(HUMAN_REVIEW)
  status      ModerationStatus  @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message   ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([messageId])
}

/// Conflict escalation alert with signals + recommended response.
model ConflictAlert {
  id           String           @id @default(uuid())
  workspaceId  String
  channelId    String?
  threadId     String?
  severity     ConflictSeverity @default(LOW)
  riskScore    Float            @default(0)
  signals      Json             @default("{}") // rising_sentiment, reply_burst, disagreement, mentions, sarcasm, latency
  response     ConflictResponse @default(BANNER)
  status       AlertStatus      @default(OPEN)
  frozenUntil  DateTime?
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([threadId, createdAt(sort: Desc)])
}

/// Engagement health snapshot for a room or thread over a window.
model EngagementSnapshot {
  id                       String          @id @default(uuid())
  workspaceId              String
  channelId                String?
  threadId                 String?
  scope                    String
  messageVelocity          Float           @default(0)
  participationDiversity   Float           @default(0)
  replyLatencySec          Float           @default(0)
  unansweredQuestions      Int             @default(0)
  threadResolutionRate     Float           @default(0)
  activeContributorRatio   Float           @default(0)
  conflictToResolutionRatio Float          @default(0)
  sentimentTrend           Float           @default(0)
  focusScore               Float           @default(0)
  burnoutRisk              Float           @default(0)
  healthScore              Float           @default(0)
  status                   HealthStatus    @default(HEALTHY)
  windowStart              DateTime
  windowEnd                DateTime
  createdAt                DateTime        @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope, createdAt(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc)])
}

/// Generated conversation insight for drill-down dashboards.
model ConversationInsight {
  id               String       @id @default(uuid())
  workspaceId      String
  channelId        String?
  kind             InsightKind
  title            String
  summary          String
  explanation      String?      // "why is this trending?"
  confidence       Float        @default(0)
  supportingThreads String[]    @default([])
  topic            String?
  createdAt        DateTime     @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, createdAt(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc)])
}

/// Auto-FAQ entry with source provenance + review workflow.
model FaqEntry {
  id            String    @id @default(uuid())
  workspaceId   String
  question      String
  shortAnswer   String
  sourceThreads String[]  @default([])
  sourceMessages String[] @default([])
  frequency     Int       @default(1)
  confidence    Float     @default(0)
  status        FaqStatus @default(CANDIDATE)
  ownerId       String?
  lastUpdated   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
