   /// Seat within a workspace + assigned role.
model WorkspaceMember {
  id          String       @id @default(uuid())
  workspaceId String
  userId      String
  role        Role         @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Per-workspace RBAC matrix override per module + action.
model WorkspacePermission {
  id        String   @id @default(uuid())
  workspaceId String
  role      Role
  module    String
  action    PermissionAction
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role, module, action])
  @@index([workspaceId])
}

/// Immutable, tenant-scoped provenance trail.
model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  actorId     String?
  module      String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorId])
}

/// Shared asset references used by every content and communication module.
model Attachment {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String
  filename    String
  mimeType    String
  sizeBytes   Int      @default(0)
  storageKey  String
  kind        AttachmentKind @default(FILE)
  checksum    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdById])
}

/// Cross-module in-app notifications.
model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  type        String?
  title       String
  body        String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  ADMIN
}

enum AttachmentKind {
  FILE
  LINK
}
/// N0VA CALENDAR — events.
model CalendarEvent {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  attendees   String[] @default([])
  recurrence  CalendarRecurrence @default(NONE)
  repeatUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
}

enum CalendarRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}


/// N0VA CONTACTS — unified people model.
model Contact {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  phoneE164   String?
  company     String?
  title       String?
  avatarUrl   String?
  notes       String?
  labels      String[]  @default([])
  isFavorite  Boolean   @default(false)
  n0vachatId  String?
  username    String?
  address     String?
  website     String?
  platform    ContactPlatform @default(N0VA)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  chatLinks ContactChatLink[]

  @@index([workspaceId, email])
  @@index([workspaceId, isFavorite])
  @@index([workspaceId, firstName])
  @@index([workspaceId, phone])
  @@index([workspaceId, n0vachatId])
  @@unique([workspaceId, n0vachatId])
}

model ContactChatLink {
  id          String   @id @default(uuid())
  contactId   String
  workspaceId String
  channelId   String?
  userId      String?
  platform    ContactPlatform @default(N0VA)
  status      ChatLinkStatus  @default(ACTIVE)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([workspaceId, userId])
  @@index([channelId])
}

enum ContactPlatform {
  N0VA
  WHATSAPP
  TELEGRAM
  SIGNAL
  IMESSAGE
  SMS
}

enum ChatLinkStatus {
  ACTIVE
  PENDING_INVITE
  BLOCKED
  ARCHIVED
}


/// N0VA FORMS — builders and responses.
model Form {
  id          String         @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  description String?
  fields      Json
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  responses FormResponse[]

  @@index([workspaceId])
}

model FormResponse {
  id          String   @id @default(uuid())
  formId      String
  workspaceId String
  answers     Json
  submittedAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}


/// N0VA KEEP — notes and lists.
model Note {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  title       String    @default("")
  body        String    @default("")
  color       String    @default("default")
  pinned      Boolean   @default(false)
  archived    Boolean   @default(false)
  labels      String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, pinned, archived])
}


/// N0VA CLOUD STORAGE — files, folders, versions, retention, compliance.
model StorageItem {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  isFolder    Boolean   @default(false)
  parentId    String?
  mimeType    String    @default("application/octet-stream")
  sizeBytes   Int       @default(0)
  storageKey  String?
  checksum    String?
  version     Int       @default(1)
  trashedAt   DateTime?
  retentionMode String  @default("STANDARD")
  retainUntil   DateTime?
  complianceLocked Boolean @default(false)
  immutable     Boolean @default(false)
  legalHold     Boolean @default(false)
  legalHoldReason String?
  lastAccessedAt DateTime?
  accessCount   Int     @default(0)
  lockedById    String?
  lockedAt      DateTime?
  restrictedDownload Boolean @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  parent    StorageItem? @relation("StorageFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  StorageItem[] @relation("StorageFolder")
  versions  StorageFileVersion[]
  links     FileLink[]
  fileIndex FileIndex[]

  @@index([workspaceId, parentId, trashedAt])
  @@index([workspaceId, legalHold])
  @@index([workspaceId, retentionMode])
}

/// Immutable revision of a file, with status, approval and compliance state.
model StorageFileVersion {
  id          String   @id @default(uuid())
  itemId      String
  workspaceId String
  versionNumber Int    @default(0)
  status      String   @default("CURRENT")
  approvalStatus String @default("DRAFT")
  changeSummary String?
  sizeBytes   Int      @default(0)
  storageKey  String
  checksum    String?
  createdById String?
  approvedById  String?
  approvedAt    DateTime?
  recalledById  String?
  recalledAt    DateTime?
  recallReason  String?
  isLocked      Boolean @default(false)
  createdAt   DateTime @default(now())

  item StorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, versionNumber])
  @@unique([itemId, versionNumber])
}

/// Content index for files and attachments: extracted text, OCR, entities, topics.
model FileIndex {
  id          String   @id @default(uuid())
  workspaceId String
  objectType  String
  objectId    String
  itemId      String?
  versionNumber Int    @default(0)
  filename    String
  mimeType    String
  extractedText String?
  ocrText     String?
  entities    Json     @default("[]")
  topics      Json     @default("[]")
  indexState  String   @default("PENDING")
  indexedAt   DateTime?
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item      StorageItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, objectType, objectId])
  @@index([workspaceId, indexState])
}

/// Tamper-evident file access audit chain (sha3-512), separate from platform logs.
model FileAccessLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String?
  actorName   String?
  action      String
  objectType  String
  objectId    String
  itemId      String?
  versionId   String?
  versionNumber Int?
  channelId   String?
  module      String?
  outcome     String   @default("SUCCESS")
  policyApplied String?
  ip          String?
  userAgent   String?
  details     Json     @default("{}")
  hash        String
  chainPrev   String?
  chainIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([objectId])
  @@index([workspaceId, action])
}

/// Legal hold on files/folders/workspace scope; overrides deletion and retention.
model FileLegalHold {
  id          String   @id @default(uuid())
  workspaceId String
  scope       String
  objectId    String?
  matterName  String?
  reason      String
  placedById  String
  placedAt    DateTime @default(now())
  noticeIssuedAt DateTime?
  acknowledgedById String?
  acknowledgedAt DateTime?
  releasedById String?
  releasedAt  DateTime?
  active      Boolean  @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
  @@index([objectId])
}

/// File-to-context backlinks: thread, decision, task, calendar, approval, message.
model FileLink {
  id          String   @id @default(uuid())
  workspaceId String
  itemId      String
  objectType  String
  objectId    String
  versionNumber Int?
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item      StorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, objectType, objectId, versionNumber])
  @@index([objectType, objectId])
  @@index([itemId])
}


/// N0VA APPROVALS — AI-detected, policy-routed decision workflows.

/// Canonical approval workflow record raised from chat or module events.
model ApprovalRequest {
  id            String   @id @default(uuid())
  workspaceId   String
  requestType   String
  sourceMessageId String?
  sourceChannelId String?
  requesterId   String
  requesterName String?
  amountCents   Int?
  currency      String   @default("USD")
  policyRuleId  String?
  policyRuleName String?
  thresholdCents Int?
  costCenter    String?
  rationale     String?
  evidence      Json     @default("[]")
  status        String   @default("DETECTED")
  approverChain Json     @default("[]")
  currentApproverIndex Int @default(0)
  dueAt         DateTime?
  escalationAt  DateTime?
  lastRemindedAt DateTime?
  decisionAt    DateTime?
  decisionNote  String?
  decisionById  String?
  erpReference  String?
  erpSyncStatus String   @default("NOT_SYNCED")
  erpSyncAttempts Int    @default(0)
  erpSyncError  String?
  retryUntil    DateTime?
  downstreamStatus String @default("NONE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester   User?       @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  decisionBy  User?       @relation("ApprovalDecider", fields: [decisionById], references: [id], onDelete: SetNull)
  sourceMessage ChatMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  auditEntries ApprovalAuditEntry[]
  comments     ApprovalComment[]
  purchaseOrders PurchaseOrder[]
  paymentSchedules PaymentSchedule[] @relation("ApprovalPayments")

  @@index([workspaceId, status])
  @@index([workspaceId, sourceChannelId, status])
  @@index([status, dueAt])
  @@index([workspaceId, erpSyncStatus])
}

/// Policy matrix: thresholds, approvers, SLAs per request type.
model ApprovalPolicyRule {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String
  requestType   String
  minAmountCents Int?
  maxAmountCents Int?
  costCenter    String?
  approverRole  String?
  approverUserId String?
  backupUserId  String?
  slaMinutes    Int      @default(1440)
  priority      Int      @default(10)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ApprovalRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([workspaceId, active, requestType])
}

/// Tamper-evident approval trail (sha3-512 hash chain, per workspace).
model ApprovalAuditEntry {
  id          String   @id @default(uuid())
  workspaceId String
  approvalId  String
  actorId     String?
  actorName   String?
  action      String
  fromStatus  String?
  toStatus    String?
  details     Json     @default("{}")
  hash        String
  chainPrev   String?
  chainIndex  Int
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approval  ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ApprovalAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, chainIndex])
  @@index([approvalId, chainIndex])
}

/// Comment / request-info thread on an approval.
model ApprovalComment {
  id          String   @id @default(uuid())
  workspaceId String
  approvalId  String
  authorId    String
  authorName  String?
  body        String
  kind        String   @default("COMMENT")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approval  ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  author    User?     @relation("ApprovalCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([approvalId])
}

/// Workspace-level approval config: ERP target and defaults.
model WorkspaceApprovalConfig {
  workspaceId String   @id
  erpProvider String   @default("MOCK")
  erpIntegrationId String?
  autoRaiseThresholdCents Int?
  defaultSlaMinutes Int @default(1440)
  nudgeBeforeMinutes Int @default(120)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Mock ERP — purchase orders.
model PurchaseOrder {
  id            String   @id @default(uuid())
  workspaceId   String
  poNumber      String
  vendorName    String
  description   String?
  amountCents   Int
  currency      String   @default("USD")
  status        String   @default("DRAFT")
  approvalId    String?
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  releasedAt    DateTime?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approval  ApprovalRequest? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  payments  PaymentSchedule[]
  requester User? @relation("PORequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approver  User? @relation("POApprover", fields: [approvedById], references: [id], onDelete: SetNull)

