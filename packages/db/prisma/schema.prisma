// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HUDDLES — Tiered Real-Time Media System
// ═══════════════════════════════════════════════════════════════════════════════

/// Huddle sessions with modes, quality profiles, and governance.
model HuddleSession {
  id                String   @id @default(uuid())
  workspaceId       String
  channelId         String?
  createdById       String
  title             String
  mode              HuddleMode @default(INSTANT)
  status            HuddleSessionStatus @default(SCHEDULED)
  qualityProfile    QualityProfile @default(PREMIUM)
  presenterVideo    String   @default("4k60")
  participantVideo  String   @default("720p30")
  audioCodec        String   @default("opus_48khz_stereo")
  maxParticipants   Int      @default(100)
  guestPolicy       Json     @default("{}")
  recordingEnabled  Boolean  @default(false)
  recordingType     RecordingType @default(COMPOSITE)
  retentionDays     Int      @default(90)
  consentRequired   Boolean  @default(true)
  startedAt         DateTime?
  endedAt           DateTime?
  scheduledFor      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants      HuddleParticipant[]
  recordings        HuddleRecording[]
  breakouts         BreakoutRoom[]
  artifacts         HuddleArtifact[]

  @@index([workspaceId, status])
  @@index([createdById])
}

/// Participant state within a huddle.
model HuddleParticipant {
  id              String   @id @default(uuid())
  huddleId        String
  userId          String?
  displayName     String
  role            HuddleRole @default(ATTENDEE)
  guestToken      String?  @unique
  guestOrg        String?
  audioEnabled    Boolean  @default(true)
  videoEnabled    Boolean  @default(true)
  isPresenter     Boolean  @default(false)
  isSpeaking      Boolean  @default(false)
  handRaised      Boolean  @default(false)
  networkQuality  NetworkQuality @default(GOOD)
  joinedAt        DateTime @default(now())
  leftAt          DateTime?

  huddle          HuddleSession @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([huddleId])
  @@index([userId])
}

/// Server-side recording with composite and raw-track support.
model HuddleRecording {
  id              String   @id @default(uuid())
  huddleId        String
  workspaceId     String
  startedById     String
  recordingType   RecordingType @default(COMPOSITE)
  status          RecordingStatus @default(RECORDING)
  storageKey      String?
  durationSec     Int      @default(0)
  fileSizeBytes   Int      @default(0)
  trackCount      Int      @default(0)
  transcriptKey   String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())

  huddle          HuddleSession  @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedBy       User           @relation(fields: [startedById], references: [id], onDelete: Cascade)
  tracks          RecordingTrack[]

  @@index([huddleId])
}

/// Individual participant recording tracks.
model RecordingTrack {
  id              String   @id @default(uuid())
  recordingId     String
  participantId   String?
  participantName String?
  trackType       TrackType
  storageKey      String
  durationSec     Int      @default(0)
  fileSizeBytes   Int      @default(0)
  isRedacted      Boolean  @default(false)
  createdAt       DateTime @default(now())

  recording       HuddleRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
}

/// Breakout rooms spawned from a parent huddle.
model BreakoutRoom {
  id              String   @id @default(uuid())
  parentHuddleId  String
  workspaceId     String
  createdById     String
  title           String
  assignmentType  AssignmentType @default(MANUAL)
  durationMin     Int?
  status          BreakoutStatus @default(ACTIVE)
  broadcastFromHost String?
  createdAt       DateTime @default(now())
  endedAt         DateTime?

  parentHuddle    HuddleSession @relation(fields: [parentHuddleId], references: [id], onDelete: Cascade)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants    BreakoutParticipant[]

  @@index([parentHuddleId])
}

model BreakoutParticipant {
  id              String   @id @default(uuid())
  breakoutId      String
  userId          String?
  displayName     String
  assignedAt      DateTime @default(now())

  breakout        BreakoutRoom @relation(fields: [breakoutId], references: [id], onDelete: Cascade)

  @@index([breakoutId])
}

/// Artifacts produced by huddles (transcripts, summaries, decisions, tasks).
model HuddleArtifact {
  id              String   @id @default(uuid())
  huddleId        String
  workspaceId     String
  artifactType    HuddleArtifactType
  title           String
  content         String   @default("")
  storageKey      String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  huddle          HuddleSession @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([huddleId])
  @@index([workspaceId, artifactType])
}

