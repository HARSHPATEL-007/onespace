  @@index([workspaceId, patientId, status])
  @@index([workspaceId, drugName])
}

/// Lab Results — FHIR DiagnosticReport, LOINC, SNOMED, ICD-10.
model HealthLabResult {
  id              String   @id @default(uuid())
  workspaceId     String
  patientId       String
  encounterId     String?
  testName        String
  loinc           String?
  category        String   @default("laboratory") // chemistry | hematology | microbiology | genomics
