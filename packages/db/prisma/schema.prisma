/// Predictive Health Alert — sepsis, deterioration, cardiac arrest, etc.
model HealthAlert {
  id             String    @id @default(uuid())
  workspaceId    String
  patientId      String?
  encounterId    String?
  kind           String // sepsis | deterioration | cardiac_arrest | fall | stroke | readmission | aki | ...
  severity       String    @default("moderate") // low | moderate | high | critical
  status         String    @default("active") // active | acknowledged | resolved | dismissed
  score          Float     @default(0)
  confidence     Float     @default(0)
  horizon        String? // 6h | 24h | 7d | 30d
  message        String
  explainability Json      @default("{}")
  actions        Json      @default("[]")
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, severity])
  @@index([workspaceId, patientId])
  @@index([workspaceId, kind])
}

/// Personalized Wellness Plan — nutrition, fitness, sleep, longevity, women's health.
model HealthWellnessPlan {
  id             String   @id @default(uuid())
  workspaceId    String
  patientId      String   @unique
  goals          Json     @default("[]")
  nutrition      Json     @default("{}")
  fitness        Json     @default("{}")
  sleep          Json     @default("{}")
  mentalHealth   Json     @default("{}")
