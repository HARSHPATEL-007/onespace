model HealthSnapshot {
  id                  String         @id @default(uuid())
  workspaceId         String
  scope               WellbeingScope
  scopeId             String
  scopeLabel          String?
  windowHours         Int            @default(24)
  windowStart         DateTime
  windowEnd           DateTime
  messages            Int            @default(0)
  senders             Int            @default(0)
  members             Int            @default(0)
  sentimentScore      Float          @default(0)
  sentimentTrend      Float          @default(0)
  sentimentConfidence Float          @default(0)
  sentimentSampleSize Int            @default(0)
  toxicityScore       Float          @default(0)
  toxicityTrend       Float          @default(0)
  toxicityConfidence  Float          @default(0)
  toxicitySampleSize  Int            @default(0)
  engagementScore     Float          @default(0)
  engagementDetails   Json?
  burnoutRisk         Float          @default(0)
  burnoutComponents   Json?
  cultureAlignment    Float          @default(0)
  cultureComponents   Json?
  environmentComfort  Float          @default(0)
