// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — HEALTH DATA PROVENANCE AND TRUST FABRIC (HDPTF)
// Clinical reasoning and accountability layer — not merely blockchain.
// HL7 FHIR Provenance + W3C PROV + FDA time-stamped audit trail.
// Source → Measurement → Transformation → Inference → Action → Outcome → Immutable Ledger
// ═══════════════════════════════════════════════════════════════════════════════

enum ProvenanceOrigin {
  PATIENT_REPORTED
  CAREGIVER_REPORTED
  CLINICIAN_ENTERED
  DEVICE_GENERATED
  LABORATORY_GENERATED
  IMPORTED
  TRANSFORMED
  INFERRED
  SYNTHETIC
  HUMAN_ADJUDICATED
}

enum TrustLabel {
  MEASURED
  REPORTED
  IMPORTED
  VALIDATED
  DERIVED
  INFERRED
  UNVERIFIED
  STALE
  CONFLICTED
  SYNTHETIC
  CORRECTED
}

enum ProvenanceEventType {
  OBSERVATION_RECEIVED
  OBSERVATION_VALIDATED
  OBSERVATION_NORMALIZED
  OBSERVATION_CORRECTED
  INFERENCE_GENERATED
  INFERENCE_REVIEWED
  ACTION_APPROVED
  ACTION_EXECUTED
  OUTCOME_RECORDED
}

enum SignatureClass {
  HUMAN_CLINICAL
  SYSTEM
  ORGANIZATION
}

enum RetentionClass {
  P0 // Temporary telemetry buffer — short
  P1 // Wellness measurement — patient-configurable
  P2 // Clinical observation — clinical-record retention
  P3 // Signed order or consent — legal and clinical
  P4 // High-risk AI decision — clinical safety and regulatory
  P5 // Incident or CAPA — quality-system
  P6 // Research record — study protocol and legal
  P7 // Security audit — security and compliance
}

/// Versioned device trust profile — firmware update creates new provenance version.
model HealthDeviceTrustProfile {
  id                      String    @id @default(uuid())
  workspaceId             String
  deviceId                String? // links to HealthDevice.id if known
  manufacturer            String
  deviceModel             String
  serialOrAttestation     String?
  firmware                String?
  hardwareRevision        String?
  regulatoryStatus        String?
  intendedUse             String?
  supportedMeasurements   String[]  @default([])
  calibrationRequirements String?
  expectedRanges          Json      @default("{}")
  samplingBehavior        String?
  knownLimitations        String[]  @default([])
  securityStatus          String?
  lastMaintenance         DateTime?
  lastCalibration         DateTime?
  signalQualityAlgorithm  String?
  dataTransferMethod      String?
  timeSyncMethod          String?
  revocationStatus        String? // active | revoked
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, manufacturer, deviceModel, firmware, version])
  @@index([workspaceId, deviceId])
}

/// Generic provenance graph — FHIR Provenance + W3C PROV (Entities/Activities/Agents).
model HealthProvenanceRecord {
  id                  String           @id @default(uuid())
  workspaceId         String
  patientId           String?
  encounterId         String?
  targetResourceType  String // Observation | DiagnosticReport | MedicationRequest | Consent | etc.
  targetResourceId    String
  // W3C PROV
  entityType          String // observation | document | model | feature | alert | order | outcome
  activityType        String // capture | import | transform | infer | review | approve | execute | revise
  agentType           String // patient | clinician | device | laboratory | organization | model | software_service
  agentId             String?
  // FHIR Provenance fields
  fhirProvenance      Json? // full FHIR Provenance resource
  w3cProv             Json? // W3C PROV JSON
  // Upstream/downstream
  parentIds           String[]         @default([]) // upstream provenance record IDs
  childIds            String[]         @default([]) // downstream
  // Origin & trust
  origin              ProvenanceOrigin @default(DEVICE_GENERATED)
  trustLabel          TrustLabel       @default(MEASURED)
  retentionClass      RetentionClass   @default(P2)
  fhirTargetReference String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, targetResourceType, targetResourceId])
  @@index([workspaceId, patientId])
  @@index([origin])
  @@index([trustLabel])
}

/// Observation object — Level 1-3 provenance + FHIR Observation + FHIR Provenance linkage.
model HealthObservationTrust {
  id               String           @id @default(uuid())
  workspaceId      String
  patientId        String
  encounterId      String?
  observationId    String           @unique // obs-...
  code             String // LOINC e.g. 8867-4 (Heart rate), 2708-6 (SpO2)
  value            Json // { amount, unit, display }
  origin           ProvenanceOrigin @default(DEVICE_GENERATED)
  // Level 1: Source
  source           Json             @default("{}") // { device_id, manufacturer, model, firmware, sensor_type, collection_method, collector_identity, consent_basis, geography, residency }
  // Level 2: Measurement
  timing           Json             @default("{}") // { event_time, device_time, ingestion_time, time_zone_offset, clock_offset_ms, synchronization, time_source, sampling_rate, sensor_placement, battery_sufficient, calibration_status, calibration_date, reference_standard, environmental_conditions, motion_artifact, duplicate_status, manual_confirmation }
  quality          Json             @default("{}") // { score, status, motion_artifact, electrode_contact, battery_sufficient, calibration_valid, sampling_complete, quality_method }
  calibration      Json             @default("{}") // { status, last_calibrated, expires, reference_standard }
  // Level 3: Transformation
  transformation   Json             @default("{}") // { raw_payload_hash, parsing_version, decryption_event, unit_conversion, noise_filtering, artifact_rejection, interpolation, gap_filling, sensor_fusion, normalization, reference_range_mapping, derived_feature, missing_value_handling, human_correction, code_version, parameters, input_output_hashes }
  provenanceRef    String? // prov-...
  contentHash      String?
  trustLabel       TrustLabel       @default(MEASURED)
  retentionClass   RetentionClass   @default(P2)
  fhirObservation  Json? // FHIR Observation
  fhirProvenanceId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([code])
  @@index([origin])
}

/// Inference object — Level 4 provenance.
model HealthInferenceTrust {
  id                          String    @id @default(uuid())
  workspaceId                 String
  patientId                   String?
  encounterId                 String?
  inferenceId                 String    @unique // inf-...
  type                        String // clinical_risk_signal, diagnostic, etc.
  statement                   String // "Possible clinical deterioration"
  status                      String    @default("review_required") // review_required | approved | rejected | superseded
  // Model
  modelFamily                 String
  modelVersion                String
  artifactDigest              String?
  promptVersion               String?
  retrievalIndexVersion       String?
  sourceDocuments             String[]  @default([])
  featureSnapshot             Json      @default("{}")
  inputTimestamp              DateTime?
  modelTimestamp              DateTime?
  confidence                  Float?
  calibrationStatus           String?
  uncertainty                 Json      @default("{}") // { predictive_probability, epistemic, aleatoric, calibration_status }
  abstentionChecks            Json      @default("{}")
  policyEngineVersion         String?
  applicableGuideline         String?
  contraindicationsConsidered String[]  @default([])
  humanReviewRequirement      String?
  outputExpiration            DateTime?
  inputs                      Json      @default("[]") // [{ observation_id, role, contribution }]
  evidence                    Json      @default("{}") // { positive_factors, missing_inputs, contradictions, source_freshness }
  validUntil                  DateTime?
  requiresHumanReview         Boolean   @default(true)
  signature                   Json? // { algorithm, key_id, signature }
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([modelFamily, modelVersion])
  @@index([status])
}

/// Action provenance — Level 5.
model HealthActionTrust {
  id            String   @id @default(uuid())
  workspaceId   String
  patientId     String?
  encounterId   String?
  actionId      String   @unique // action-...
  type          String // rapid_response_notification, order, message, care_plan_change
  trigger       Json     @default("{}") // { inference_id, policy_id, alert_id }
  authorization Json     @default("{}") // { required_role, reviewer_id, decision, decision_time, reason }
  execution     Json     @default("{}") // { recipient, sent_at, delivery_status, failure_or_rollback, time_to_action }
  outcomeRef    String? // links to HealthOutcomeTrust
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([type])
}

/// Outcome provenance — Level 6.
model HealthOutcomeTrust {
  id                     String    @id @default(uuid())
  workspaceId            String
  patientId              String?
  encounterId            String?
  outcomeId              String    @unique
  actionId               String? // links to HealthActionTrust.actionId
  followUpMeasurement    Json? // observation ref
  clinicalOutcome        String?
  patientReportedOutcome String?
  adverseEvent           String?
  override               String?
  reassessment           String?
  readmission            Boolean?
  escalation             String?
  resolution             String?
  unresolvedStatus       String?
  outcomeAdjudicator     String?
  outcomeTimestamp       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([actionId])
}

/// Event-sourcing — append-only, derive current state, reconstruct any point in time.
model HealthProvenanceEvent {
  id                 String              @id @default(uuid())
  workspaceId        String
  patientId          String?
  encounterId        String?
  eventId            String              @unique // event-...
  eventType          ProvenanceEventType
  aggregateId        String // resource ID (observation/inference/action)
  actor              String // patient | clinician | device | system
  timestamp          DateTime            @default(now())
  previousStateHash  String?
  currentPayloadHash String?
  parentEventId      String?
  softwareVersion    String?
  policyVersion      String?
  signature          Json? // { class, algorithm, key_id, signature }
  reasonCode         String?
  correlationId      String?
  retentionClass     RetentionClass      @default(P2)
  payload            Json                @default("{}")
  createdAt          DateTime            @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, aggregateId])
  @@index([workspaceId, patientId])
  @@index([eventType])
  @@index([correlationId])
}

/// Correction workflow — preserves history, prevents reliance on wrong info, identifies dependents.
model HealthCorrectionTrust {
  id                 String    @id @default(uuid())
  workspaceId        String
  patientId          String?
  recordId           String // original record ID
  originalValue      Json
  proposedValue      Json
  reason             String?
  evidence           Json?
  reviewStatus       String    @default("pending") // pending | reviewed | approved | rejected
  responsibleOrg     String?
  correctedValue     Json?
  effectiveDate      DateTime?
  superseded         Boolean   @default(false)
  dependentArtifacts Json      @default("[]") // [{ id, type, status: Unaffected | Recomputed | Requires review | Withdrawn | Superseded | Patient notification required | Research correction required | Regulatory report }]
  notifiedRecipients String[]  @default([])
  patientMessage     String? // "Your recorded medication dose was corrected from 10 mg to 20 mg after review by City Hospital on 1 September 2026. ..."
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([recordId])
  @@index([reviewStatus])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — UNIFIED PATIENT COMMAND CENTER
// Personalized, prioritized, explainable daily workspace. Four questions: What matters today? What changed? What next? Who is waiting?
// AHRQ health-literacy: plain language, reduce numbers, evaluate with patients. WCAG 2.2 AA, NHS inclusion.
// ═══════════════════════════════════════════════════════════════════════════════

enum CareContext {
  STABLE_WELLNESS
  NEW_DIAGNOSIS
  POST_DISCHARGE_RECOVERY
  PREGNANCY
  CHRONIC_DISEASE_MONITORING
  ACTIVE_TREATMENT
  MENTAL_HEALTH_SUPPORT
  CAREGIVER_MANAGED_CARE
  PEDIATRIC_ADOLESCENT_CARE
  PALLIATIVE_HOSPICE_CARE
  EMERGENCY_URGENT_FOLLOWUP
}

enum PriorityLevel {
  EMERGENCY // Immediate human help may be needed
  URGENT // Same-day or rapid review
  IMPORTANT // Action due soon
  ROUTINE // Useful but not time-sensitive
  INFORMATIONAL // No action required
}

enum HealthTaskStatus {
  PLANNED
  DUE_TODAY
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
  WAITING_FOR_CLINICIAN
  BLOCKED
  CANCELLED
  NOT_APPLICABLE
}

enum ResultStatus {
  NEW
  AWAITING_CLINICIAN_REVIEW
  REVIEWED
  ACTION_REQUESTED
  REPEAT_RECOMMENDED
  STABLE_OR_EXPECTED
  CONFLICTING
  URGENT_ESCALATION
}

enum WhatChangedCategory {
  NEW
  IMPROVED
  WORSENED
  STABLE
  MISSING
  CORRECTED
  RECLASSIFIED
  AWAITING_REVIEW
  NEWLY_RESTRICTED_BY_CONSENT
  NEWLY_SHARED_WITH_CARE_TEAM
  NEWLY_ADDED_TO_TREATMENT_PLAN
}

/// Patient goals — “What matters to me” (12 types). Evaluated against recommendations, not only clinical risk.
model HealthPatientGoal {
  id          String   @id @default(uuid())
  workspaceId String
  patientId   String
  goalType    String // health_goals, functional_goals, work_caregiving_constraints, preferred_treatment_outcomes, lifestyle_priorities, cultural_religious_considerations, communication_preferences, financial_constraints, treatment_boundaries, advance_care_preferences, accessibility_needs
  title       String
  description String   @default("")
  priority    Priority @default(MEDIUM)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
}

/// Priority engine ranked item — distinguishes AI-generated priority from diagnosis.
model HealthPriorityItem {
  id                  String        @id @default(uuid())
  workspaceId         String
  patientId           String
  title               String // plain-language, e.g. "Possible concern: blood pressure above usual range"
  whatChanged         String? // what changed
  nextStep            String? // recommended next step
  urgency             String? // urgency
  reason              String? // reason shown
  dataSource          String? // home BP monitor, etc.
  timestamp           DateTime      @default(now())
  confidence          String? // evidence status
  responsiblePerson   String? // care team member
  dueAt               DateTime?
  priority            PriorityLevel @default(ROUTINE)
  status              String        @default("awaiting_patient_action") // awaiting_patient_action, completed, snoozed, hidden
  requiresHumanReview Boolean       @default(false)
  whyShown            String? // 3 readings above threshold in 24h
  provenanceRef       String? // prov-...
  isAiGenerated       Boolean       @default(true)
  reviewedByClinician Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([priority])
  @@index([dueAt])
}

/// What changed since reference point — 11 categories, links to supporting record and provenance.
model HealthWhatChangedEvent {
  id                 String              @id @default(uuid())
  workspaceId        String
  patientId          String
  category           WhatChangedCategory
  title              String
  description        String              @default("")
  supportingRecordId String?
  provenanceRef      String? // prov-...
  referencePoint     String? // since_last_visit, since_discharge, since_treatment_started, etc.
  referenceDate      DateTime?
  createdAt          DateTime            @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([category])
  @@index([referencePoint])
}

/// Home-screen snapshot — personalized command center JSON, versioned for what-changed comparison.
model HealthCommandCenterSnapshot {
  id          String      @id @default(uuid())
  workspaceId String
  patientId   String
  asOf        DateTime    @default(now())
  careContext CareContext @default(STABLE_WELLNESS)
  homeScreen  Json // { patient_id, as_of, context: { care_state, last_visit, next_visit }, priorities, medications, appointments, results, trends, messages, preventive_gaps, financial_warnings, what_changed, accessibility }
  createdAt   DateTime    @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([asOf(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — ADAPTIVE COMMUNICATION AND HEALTH LITERACY LAYER
// Universal-precautions, teach-back (AHRQ), 5 reading levels, 3 language layers, 4 modes, WCAG 2.2 AA, NHS inclusion.
// Changes how information is explained without changing clinical meaning. Never adapt truth/safety/uncertainty.
// ═══════════════════════════════════════════════════════════════════════════════

enum ReadingLevel {
  ESSENTIAL // One action and one reason
  PLAIN // Short explanation and next step
  DETAILED // More context and common risks
  CLINICAL // Technical explanation
  RESEARCH // Methods and evidence
}

enum CommunicationRole {
  PATIENT
  CAREGIVER
  CLINICIAN
  RESEARCHER
}

enum TeachBackMethod {
  VOICE_OR_TEXT
  SHOW_ME
}

enum TeachBackResult {
  CORRECT
  PARTIAL
  UNSAFE
  NO_RESPONSE
}

enum AmbiguityRiskTier {
  LOW // Minor wording no safety impact — answer and state assumption
  MODERATE // Missing context could change advice — ask 1-2 questions
  HIGH // Medication/dose/pregnancy/child/serious symptom — do not advise until clarified
  EMERGENCY // Potential immediate danger — urgent safety instruction first
  UNRESOLVABLE // Insufficient/conflicting — abstain and route to human care
}

/// Communication profile — patient-controlled, editable, separate from diagnosis. Ani asks rather than assumes.
model HealthCommunicationProfile {
  id                  String            @id @default(uuid())
  workspaceId         String
  userId              String
  patientId           String? // optional link to HealthPatient if user is patient
  role                CommunicationRole @default(PATIENT)
  preferredLanguage   String            @default("gu-IN") // gu-IN, hi-IN, en-IN, etc.
  fallbackLanguages   String[]          @default(["hi-IN", "en-IN"])
  readingLevel        ReadingLevel      @default(PLAIN)
  preferredModalities String[]          @default(["short_text", "audio", "visual"])
  accessibility       Json              @default("{}") // { low_vision, hearing_impairment, motor_impairment, cognitive_support }
  culturalPreferences Json              @default("{}") // { dietary_pattern, religious_constraints, foods_to_avoid, family_involvement }
  teachBack           Json              @default("{}") // { enabled, preferred_method, frequency }
  technicalDetail     String            @default("on_demand") // on_demand | always | never
  consentScope        String            @default("patient_communication")
  safeMemory          Json              @default("{}") // preferred_language, preferred_name, units, reading_format, audio, accessibility, dietary, caregiver, teach_back_method, show_me_short_first
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([patientId])
}

/// Teach-back — communication-quality event, not clinical diagnosis.
model HealthTeachBackRecord {
  id                       String          @id @default(uuid())
  workspaceId              String
  patientId                String?
  userId                   String?
  teachBackId              String          @unique // tb-...
  topic                    String // inhaler_use, medication, discharge, etc.
  instructionVersion       String // education-2.4
  method                   TeachBackMethod @default(VOICE_OR_TEXT)
  result                   TeachBackResult @default(CORRECT)
  misunderstoodElement     String? // breathing_timing, etc.
  reExplanationMethod      String? // visual_animation, etc.
  secondAttempt            String? // correct, etc.
  escalation               String? // not_required, clinician, pharmacist
  patientPreferenceUpdated Json            @default("{}") // { visual_explanations: true }
  createdAt                DateTime        @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([topic])
}

/// Clarification — ambiguity detection with minimum-question principle + emergency screen.
model HealthClarificationSession {
  id                    String            @id @default(uuid())
  workspaceId           String
  patientId             String?
  userId                String?
  riskLevel             AmbiguityRiskTier @default(LOW)
  clarificationRequired Boolean           @default(false)
  questions             Json              @default("[]") // [{ id, text, type, required }]
  emergencyScreen       Json? // { show_now, message }
  resolved              Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([riskLevel])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — CONSENT-AWARE CARE COORDINATION NETWORK
// Shared operational workspace — patient remains center of control. FHIR CareTeam, RelatedPerson, Consent, Provenance.
// Lease-privilege delegation, 3 visibility layers, warm handoffs, shared timeline, caregiver wellbeing as safety concern.
// ═══════════════════════════════════════════════════════════════════════════════

enum CaregiverRelationship {
  FAMILY_MEMBER
  INFORMAL_CAREGIVER
  PARENT
  LEGAL_GUARDIAN
  HEALTH_CARE_PROXY
  POWER_OF_ATTORNEY_HOLDER
  TRUSTED_CONTACT
  HOME_HEALTH_NURSE
  COMMUNITY_HEALTH_WORKER
  TRANSPORT_PROVIDER
  PHARMACIST
  SPECIALIST
  PRIMARY_CARE_CLINICIAN
  EMERGENCY_RESPONDER
  RESEARCH_COORDINATOR
  SOCIAL_CARE_WORKER
}

enum CaregiverPermission {
  VIEW
  ADD_PATIENT_REPORTED_INFORMATION
  CONFIRM_MEDICATION_ADMINISTRATION
  REQUEST_REFILL
  SCHEDULE_APPOINTMENT
  RESCHEDULE_APPOINTMENT
  ARRANGE_TRANSPORT
  VIEW_PREPARATION_INSTRUCTIONS
  VIEW_RESULTS
  VIEW_MEDICATION_LIST
  SEND_MESSAGES
  RECEIVE_ALERTS
  COMPLETE_CARE_TASKS
  APPROVE_RESEARCH_PARTICIPATION
  DOWNLOAD_RECORDS
  MODIFY_CONSENT
  ACT_DURING_INCAPACITY
  USE_EMERGENCY_ACCESS
}

enum DelegationStatus {
  REQUESTED
  PATIENT_REVIEWED
  VERIFIED
  APPROVED
  ACTIVE
  EXPIRING_SOON
  PAUSED
  REVOKED
  EXPIRED
  ARCHIVED
}

enum CarePlanVisibility {
  SHARED
  ROLE_SPECIFIC
  PRIVATE
}

enum CareTaskStatus {
  PLANNED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  REASSIGNED
  SNOOZED
  MISSED
  BLOCKED
  ESCALATED
  CANCELLED
  REQUIRES_CLINICAL_REVIEW
}

enum MedicationTaskStatus {
  PRESCRIBED
  RECONCILED
  PATIENT_CONFIRMED
  CAREGIVER_NOTIFIED
  DOSE_SCHEDULED
  DOSE_ADMINISTERED_OR_SELF_REPORTED
  MISSED_REFUSED_UNKNOWN
  FOLLOW_UP_ACTION
  CLINICIAN_REVIEW_IF_REQUIRED
}

enum TransportStatus {
  TRANSPORT_NEEDED
  REQUEST_CREATED
  DRIVER_OR_SERVICE_ASSIGNED
  PICKUP_CONFIRMED
  PATIENT_EN_ROUTE
  ARRIVED
  APPOINTMENT_COMPLETED
  RETURN_TRANSPORT_CONFIRMED
}

/// FHIR CareTeam — people and organizations involved in care.
model HealthCareTeam {
  id          String   @id @default(uuid())
  workspaceId String
  patientId   String
  name        String   @default("Care Team")
  status      String   @default("active") // active | inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient         HealthPatient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  members         HealthCareTeamMember[]
  sharedCarePlans HealthSharedCarePlan[]
  tasks           HealthCareTask[]

  @@index([workspaceId, patientId])
}

/// RelatedPerson + CareTeam participant — relationship separate from permissions.
model HealthCareTeamMember {
  id              String                @id @default(uuid())
  workspaceId     String
  patientId       String
  careTeamId      String?
  relatedPersonId String? // FHIR RelatedPerson reference
  userId          String? // linked N0VA User if applicable
  relationship    CaregiverRelationship
  role            String? // FHIR CareTeam participant role
  permissions     CaregiverPermission[] @default([])
  dataCategories  WalletDataDomain[]    @default([]) // reuse WalletDataDomain for category
  isPrimary       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  careTeam  HealthCareTeam? @relation(fields: [careTeamId], references: [id], onDelete: SetNull)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([careTeamId])
}

/// Delegation lifecycle — task-specific, least-privilege, 9 states + 15 fields.
model HealthDelegation {
  id                            String                @id @default(uuid())
  workspaceId                   String
  patientId                     String
  delegateId                    String? // User or RelatedPerson
  delegateEmail                 String?
  delegateName                  String?
  relationship                  CaregiverRelationship
  authorizedTasks               String[]              @default([]) // task-specific
  dataCategories                WalletDataDomain[]    @default([])
  purpose                       String? // FHIR Consent purpose
  startTime                     DateTime?
  endTime                       DateTime?
  geography                     String?
  language                      String?
  communicationChannels         String[]              @default([])
  emergencyPermissions          String[]              @default([])
  conditions                    String?
  patientNotificationPreference String?
  legalDocumentReference        String?
  reviewDate                    DateTime?
  revocationMethod              String?
  status                        DelegationStatus      @default(REQUESTED)
  createdById                   String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([status])
  @@index([delegateId])
}

/// Shared care plan — 3 visibility layers + structure Goal→Objective→Tasks→Owner→Due→Dependencies→Escalation→Evidence→Review.
model HealthSharedCarePlan {
  id                  String             @id @default(uuid())
  workspaceId         String
  patientId           String
  careTeamId          String?
  title               String
  goal                String? // Patient goal
  objective           String? // Clinical or practical objective
  sharedSection       Json               @default("{}") // visible to all authorized
  roleSpecificSection Json               @default("{}") // visible only to selected
  privateSection      Json               @default("{}") // patient only unless separately shared — excluded from AI prompts, shared summaries, caregiver alerts, clinical workflows
  visibility          CarePlanVisibility @default(SHARED)
  consentRef          String? // consent-...
  status              String             @default("active") // active | completed | archived
  createdById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  careTeam  HealthCareTeam?  @relation(fields: [careTeamId], references: [id], onDelete: SetNull)
  tasks     HealthCareTask[]

  @@index([workspaceId, patientId])
  @@index([careTeamId])
}

/// Shared task record — one record across patient/caregiver/clinician views.
model HealthCareTask {
  id                   String         @id @default(uuid())
  workspaceId          String
  patientId            String?
  careTeamId           String?
  sharedCarePlanId     String?
  title                String
  patientGoal          String?
  ownerId              String? // owner
  backupOwnerId        String? // backup owner
  sourceCarePlanId     String?
  dueAt                DateTime?
  location             String?
  requiredEquipment    String?
  instructions         String? // preparation instructions
  accessibilityNeeds   String?
  consentScope         String?
  evidenceOfCompletion String?
  escalationRule       Json           @default("{}") // { after, recipient, wait, condition }
  completionNote       String?
  auditHistory         Json           @default("[]")
  status               CareTaskStatus @default(PLANNED)
  priority             Priority       @default(MEDIUM)
  patientVisible       Boolean        @default(true)
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient        HealthPatient?        @relation(fields: [patientId], references: [id], onDelete: SetNull)
  careTeam       HealthCareTeam?       @relation(fields: [careTeamId], references: [id], onDelete: SetNull)
  sharedCarePlan HealthSharedCarePlan? @relation(fields: [sharedCarePlanId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([careTeamId])
  @@index([status])
  @@index([dueAt])
}

/// Escalation tree — defined in care plan, visible to authorized participants.
model HealthEscalationTree {
  id             String   @id @default(uuid())
  workspaceId    String
  patientId      String?
  event          String // missed_medication, abnormal_vital, fall_detected, etc.
  trigger        Json     @default("{}") // { medication, scheduled_time, status }
  tree           Json     @default("[]") // [{ step, recipient, channel, wait, condition }]
  stopConditions String[] @default([])
  status         String   @default("active") // active | acknowledged | resolved | escalated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([event])
}

/// Caregiver wellbeing — workload dashboard + check-ins, Zarit Burden Interview, not surveillance.
model HealthCaregiverWellbeing {
  id                   String   @id @default(uuid())
  workspaceId          String
  caregiverId          String // RelatedPerson or User
  patientId            String?
  tasksAssigned        Int      @default(0)
  tasksCompleted       Int      @default(0)
  tasksMissed          Int      @default(0)
  avgTaskTimeMin       Float?
  nightInterruptions   Int      @default(0)
  travelBurdenMin      Int?
  patientsSupported    Int      @default(1)
  medicationComplexity String?
  checkInResponse      Json     @default("{}") // { manageable_today, enough_help_7_days, hardest_task, enough_sleep, need_respite, feel_safe }
  capacity             String? // manageable | strained | overloaded | unsafe
  zaritScore           Int? // 0-88, perceived burden, not diagnosis
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, caregiverId])
  @@index([patientId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — MULTIMODAL PERSONAL HEALTH REASONING FABRIC
// Coordinated multimodal fabric — not one general-purpose model. FHIR Clinical Reasoning + CDS Hooks, W3C PROV, FDA CDS.
// Common patient context → Normalization → Temporal/Provenance Graph → Contradiction/Data-Quality → Evidence Retrieval → Specialized Services → Synthesis/Uncertainty → Safety/Consent/Human-Review → Role-specific Answer
// ═══════════════════════════════════════════════════════════════════════════════

/// Governed source registry — organization, title, version, publication/review date, jurisdiction, population, topic, strength, quality, conflicts, applicability, expiration, license, retrieval timestamp.
model HealthEvidenceSource {
  id                     String    @id @default(uuid())
  workspaceId            String
  organization           String
  publicationTitle       String
  version                String    @default("1.0")
  publicationDate        DateTime?
  reviewDate             DateTime?
  jurisdiction           String?
  population             String?
  clinicalTopic          String?
  recommendationStrength String?
  evidenceQuality        String?
  conflictsOfInterest    String?
  applicability          String?
  expiration             DateTime?
  license                String?
  retrievalTimestamp     DateTime  @default(now())
  sourceUrl              String?
  isApproved             Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clinicalTopic])
}

/// Unified multimodal reasoning session — stores full output contract + provenance + model chain.
model HealthReasoningSession {
  id                   String    @id @default(uuid())
  workspaceId          String
  patientId            String?
  encounterId          String?
  question             String
  scope                Json      @default("{}") // { time_range: { start, end }, modalities: [blood_pressure, medications, ...] }
  purpose              String    @default("health_education") // health_education, etc.
  consentRef           String?
  requesterRole        String    @default("patient")
  requesterIdentity    String? // verified
  responsePreferences  Json      @default("{}") // { language: en-IN, reading_level: plain, technical_detail: on_demand }
  // Common patient context — structured package
  patientContext       Json      @default("{}") // { patient: { id, age_context, relevant_anatomy }, encounter: { id, setting, purpose }, active_problems, medications, allergies, observations, laboratory_results, imaging, genomics, family_history, social_context, goals, preferences, consent, data_quality, contradictions, provenance_refs } with source/origin/timestamp/freshness/quality/confidence/consentStatus/clinicalStatus/provenanceRef/whetherClinicianReviewed
  // Reasoning stages — 6
  stageIntent          String? // general education, explanation, trend, medication, symptom guidance, urgent triage, etc. + high-risk screening
  stageRetrieval       Json      @default("{}")
  stageNormalization   Json      @default("{}")
  stageBaseline        Json      @default("{}") // personal baseline median/range/variability/recent trend vs previous visit vs pre-treatment vs population vs clinician target
  stageChanges         Json      @default("{}") // direction, magnitude, duration, persistence, variability, abrupt, treatment relationship, device change, missing, seasonal
  stageContradictions  Json      @default("[]") // [{ severity: informational/moderate/high/critical, example, behavior }]
  // Evidence retrieval — governed
  evidence             Json      @default("[]") // [{ source_title, organization, version, population, recommendation, applicability, limitations, retrieval_date }]
  // Multimodal fusion — reliability and concordance
  fusion               Json      @default("{}") // { device_signal: high quality, manual: not available, patient_report: moderate, clinician_note: recent signed, lab: final, imaging: radiologist reviewed, ai_image: assistive only, synthesis: which agree/disagree }
  // Output contract — 6 sections
  knownFacts           Json      @default("[]")
  modelObservations    Json      @default("[]")
  possibleExplanations Json      @default("[]")
  recommendedNextSteps Json      @default("[]")
  informationNeeded    Json      @default("[]")
  urgentHumanCare      Json      @default("[]")
  contradictions       Json      @default("[]")
  provenanceRefs       String[]  @default([])
  humanReview          Json      @default("{}") // { required: false, reason: null }
  limitations          String[]  @default([])
  modelChain           Json      @default("[]") // [{ name, version, role, input, output, error, confidence, provenance, whether_decisive }]
  status               String    @default("safe_to_present") // safe_to_present, needs_review, abstained
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — ALERT INTELLIGENCE AND RESPONSE SERVICE
// Managed clinical events — not individual notifications. AHRQ specificity, Joint Commission governance, deduplication, clustering, baselines, fatigue prevention.
// Signal Quality → Candidate → Deduplication → Baseline/Context → Priority/Actionability → Suppression/Cooldown → Routing/Escalation → Acknowledgement/Action → Outcome/Fatigue → Policy/Model Improvement
// ═══════════════════════════════════════════════════════════════════════════════

enum AlertCandidateType {
  ELEVATED_BP
  DISCONNECTED_SENSOR
  MISSED_MEDICATION
  MODEL_RISK_SCORE
  LOW_QUALITY_SIGNAL
  NEW_LAB_RESULT
  PATIENT_REPORTED_SYMPTOM
}

enum AlertLifecycleStatus {
  CANDIDATE
  VALIDATED
  DEDUPLICATED
  CLUSTERED
  PRIORITIZED
  ROUTED
  DELIVERED
  ACKNOWLEDGED
  ACTIONED
  RESOLVED
  OUTCOME_RECORDED
  SUPPRESSED
  SNOOZED
  ESCALATED
  EXPIRED
  RETRACTED
  FALSE_POSITIVE
  DUPLICATE
  DATA_QUALITY_ISSUE
  PATIENT_DECLINED
  UNABLE_TO_DELIVER
  AWAITING_CLINICIAN_REVIEW
  NO_OUTCOME_RECORDED
}

enum PriorityTier {
  P0 // Immediate threat — emergency pathway
  P1 // Urgent clinical risk — interrupt + escalation timer
  P2 // Same-day review — prioritized task
  P3 // Action due soon — worklist/patient task
  P4 // Informational trend — dashboard, no interruption
  P5 // Low-value/non-actionable — suppress/log/digest
}

enum AcknowledgementState {
  DELIVERED
  OPENED
  SEEN
  ACKNOWLEDGED
  ACCEPTED
  DEFERRED
  REASSIGNED
  ESCALATED
  ACTION_INITIATED
  RESOLVED
  UNABLE_TO_ACT
  FALSE_POSITIVE
  PATIENT_DECLINED
}

/// Raw candidate event — not yet validated as alert.
model HealthAlertCandidate {
  id            String               @id @default(uuid())
  workspaceId   String
  patientId     String?
  encounterId   String?
  candidateType AlertCandidateType
  source        String? // device, model, lab, patient_report
  value         Json? // { amount, unit, threshold }
  quality       String? // good, poor, uninterpretable
  timestamp     DateTime             @default(now())
  status        AlertLifecycleStatus @default(CANDIDATE)
  provenanceRef String?
  policyVersion String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([candidateType])
  @@index([status])
  @@index([timestamp(sort: Desc)])
}

/// Clustered alert — validated clinical narrative combining related candidates.
model HealthAlertCluster {
  id                   String                @id @default(uuid())
  workspaceId          String
  patientId            String?
  clusterId            String                @unique // cluster-...
  type                 String                @default("clinical_risk_cluster") // clinical_risk_cluster, etc.
  title                String // "Possible respiratory deterioration—bedside review required"
  severity             String                @default("urgent") // urgent, etc.
  urgency              String                @default("same_day") // same_day, immediate, etc.
  actionability        String                @default("high")
  status               AlertLifecycleStatus  @default(CLUSTERED)
  candidateIds         String[]              @default([])
  reason               String? // same patient, time window, clinical syndrome
  scoring              Json                  @default("{}") // { clinical_urgency, confidence, persistence, patient_context, actionability }
  priorityTier         PriorityTier          @default(P2)
  priorityScore        Float? // P = U×C×S×A×R
  routing              Json                  @default("{}") // { primary_role, backup_role, shift, specialty }
  policy               Json                  @default("{}") // { version, human_review_required, suppression_allowed }
  provenanceRef        String?
  explanationRef       String?
  acknowledgementState AcknowledgementState?
  acknowledgedById     String?
  acknowledgedAt       DateTime?
  outcome              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([priorityTier])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

/// Patient-specific baseline — median, range, period, observations, quality, confidence.
model HealthPatientBaseline {
  id            String    @id @default(uuid())
  workspaceId   String
  patientId     String
  metric        String // morning_systolic_bp, etc.
  baseline      Json      @default("{}") // { median, range: [124,140], period: 14_days, observations: 18, quality: acceptable, confidence: moderate }
  adaptation    Json      @default("{}") // { enabled, max_daily_shift: 0.05, requires_clinician_approval_for: [critical_thresholds, post_discharge_period] }
  lastAdaptedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, patientId, metric])
  @@index([workspaceId, patientId])
}

/// Suppression and cooldown policy — every suppression needs reason, rule version, duration, candidates, override, review date, safety impact.
model HealthAlertSuppressionLog {
  id                   String    @id @default(uuid())
  workspaceId          String
  patientId            String?
  candidateId          String?
  clusterId            String?
  reason               String
  ruleVersion          String?
  duration             String? // 10 minutes, etc.
  underlyingCandidates String[]  @default([])
  overrideAvailable    Boolean   @default(true)
  reviewDate           DateTime?
  safetyImpact         String?
  createdAt            DateTime  @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([candidateId])
  @@index([clusterId])
}

/// Outcome and fatigue analytics — links alert to clinical assessment, orders, outcomes, plus burden.
model HealthAlertOutcome {
  id                      String   @id @default(uuid())
  workspaceId             String
  patientId               String?
  alertId                 String? // HealthAlertCluster.clusterId or HealthAlert.id
  candidateId             String?
  outcome                 String // Confirmed clinically important, Confirmed but already known, Not clinically important, False positive, Unable to determine, Harmfully delayed, Preventive success, Patient declined, Data-quality failure
  clinicalAssessment      String?
  repeatMeasurements      String?
  orders                  String[] @default([])
  medicationChanges       String[] @default([])
  messages                String[] @default([])
  admissions              String[] @default([])
  escalations             String[] @default([])
  patientReportedOutcomes String?
  adverseEvents           String?
  resolution              String?
  followUpInterval        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([alertId])
  @@index([outcome])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — PERSONAL HEALTH DIGITAL TWIN SAFEGUARDS
// Bounded, provenance-linked personal health model, not definitive virtual copy. NIST AI RMF transparency, FDA CDS.
// Every attribute shows observed/reported/calculated/inferred/simulated/projected/synthetic with confidence, uncertainty, freshness, provenance, intended use, human review.
// ═══════════════════════════════════════════════════════════════════════════════

enum TwinOrigin {
  OBSERVED
  PATIENT_REPORTED
  CAREGIVER_REPORTED
  CLINICIAN_ENTERED
  IMPORTED
  CALCULATED
  INFERRED
  SIMULATED
  PROJECTED
  SYNTHETIC
  UNKNOWN
}

enum TwinAttributeStatus {
  ACTIVE
  OBSERVED
  ESTIMATED
  INFERRED
  SIMULATED
  PROJECTED
  RESEARCH_ONLY
  CLINICAL_VALIDATION
  DISPUTED
  SUPERSEDED
  EXPIRED
  WITHDRAWN
  RESTRICTED
  REJECTED
  UNABLE_TO_VERIFY
}

enum TwinCapabilityStatus {
  PRODUCTION
  CLINICAL_VALIDATION
  RESEARCH
  CONCEPTUAL
}

/// Bounded, provenance-linked twin attribute — time-versioned, purpose-limited.
model HealthTwinAttribute {
  id               String               @id @default(uuid())
  workspaceId      String
  patientId        String
  attributeId      String               @unique // twin-attribute-...
  name             String // e.g. cardiorespiratory_fitness_estimate
  value            Json // { value, unit }
  origin           TwinOrigin           @default(OBSERVED)
  status           TwinAttributeStatus  @default(ACTIVE)
  observedInputs   String[]             @default([]) // observation IDs
  modelName        String?
  modelVersion     String?
  artifactDigest   String?
  uncertainty      Json                 @default("{}") // { confidence, interval, missing_inputs, known_bias_risks }
  timeValidAt      DateTime?
  timeHorizon      String? // current_estimate, expires_at, etc.
  timeExpiresAt    DateTime?
  provenanceRef    String?
  consentRef       String?
  humanReview      Boolean              @default(false)
  intendedUse      String?
  capabilityStatus TwinCapabilityStatus @default(PRODUCTION)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([origin])
  @@index([status])
  @@index([capabilityStatus])
}

/// Counterfactual simulation — assumptions explicit, not prediction, not treatment instruction.
model HealthTwinSimulation {
  id                       String   @id @default(uuid())
  workspaceId              String
  patientId                String
  simulationId             String   @unique // sim-...
  question                 String // What might change if activity increases?
  baseline                 String? // previous_30_days
  assumptions              String[] @default([]) // Medication remains unchanged, Activity increases by 20%, etc.
  horizon                  String? // 8_weeks
  output                   Json     @default("{}") // { estimated_change, interval, confidence }
  notAPrediction           Boolean  @default(true)
  notATreatmentInstruction Boolean  @default(true)
  review                   String? // clinician_supervision_required_for_clinical_use
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([simulationId])
}

/// Dispute — “I do not agree that this representation is accurate, appropriate, or fair.”
model HealthTwinDispute {
  id          String    @id @default(uuid())
  workspaceId String
  patientId   String
  attributeId String? // links to HealthTwinAttribute.attributeId
  reason      String // Wrong source data, Wrong interpretation, Missing context, Outdated, Cultural context ignored, Model not applicable, Privacy concern, Too sensitive, Patient does not want, Clinician disagreement, Research-use objection
  status      String    @default("disputed") // disputed, reviewed, corrected, retained_with_qualification, withdrawn, requires_clinical_review, unable_to_verify, disagreement_recorded
  resolution  String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([attributeId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — CLOSED-LOOP CARE PATHWAYS
// Versioned, executable care program — FHIR PlanDefinition → ActivityDefinition → CarePlan, AHRQ coordination.
// Eligibility → Verification → Invitation → Enrollment → Baseline → Goals/Risk → Interventions → Tasks/Appointments → Monitoring → Alert/Escalation → Outcome → Completion/Continuation/Re-entry → Quality/Financial/Equity Reporting
// ═══════════════════════════════════════════════════════════════════════════════

enum PathwayDefinitionStatus {
  DRAFT
  CLINICAL_VALIDATION
  ACTIVE
  RETIRED
}

enum EnrollmentStatus {
  NOT_ELIGIBLE
  POTENTIALLY_ELIGIBLE
  AWAITING_VERIFICATION
  INVITED
  ENROLLED
  BASELINE_INCOMPLETE
  ACTIVE
  PAUSED
  ESCALATED
  CLINICIAN_OVERRIDE
  COMPLETED
  UNSUCCESSFUL_COMPLETION
  WITHDRAWN
  LOST_TO_FOLLOW_UP
  RE_ENROLLMENT_ELIGIBLE
}

/// Versioned, executable care program — PlanDefinition is reusable, CarePlan is patient-specific applied plan.
model HealthPathwayDefinition {
  id                String                  @id @default(uuid())
  workspaceId       String
  pathwayId         String // e.g. diabetes-type2-v3
  title             String // Type 2 diabetes support
  version           String                  @default("1.0.0") // semantic version
  status            PathwayDefinitionStatus @default(DRAFT)
  jurisdiction      String? // configured_region
  owner             String? // endocrinology_program
  purpose           String? // support_monitoring_and_clinician_coordinated_care
  eligibility       Json                    @default("{}") // { conditions, exclusions, required_data }
  consent           Json                    @default("{}") // { required, caregiver_sharing, research_use }
  steps             Json                    @default("[]")
  outcomes          Json                    @default("[]")
  exceptions        Json                    @default("[]")
  clinicianOverride Boolean                 @default(true)
  reporting         Json                    @default("{}") // { quality_measures, financial_rules }
  evidenceSources   String[]                @default([])
  population        String?
  effectiveDate     DateTime?
  retirementDate    DateTime?
  changeLog         String?
  validationStatus  String?
  qualityMeasures   String[]                @default([])
  financialRules    String[]                @default([])
  exceptionRules    String[]                @default([])
  modelDependencies String[]                @default([])
  rollbackVersion   String?
  createdById       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pathwayId, version])
  @@index([workspaceId, pathwayId])
  @@index([status])
}

/// Patient enrollment — state machine 15 states, distinguishes not eligible vs eligible not enrolled vs enrolled inactive vs completed vs lost to follow-up.
model HealthPathwayEnrollment {
  id                  String           @id @default(uuid())
  workspaceId         String
  patientId           String
  pathwayId           String
  pathwayVersion      String           @default("1.0.0")
  status              EnrollmentStatus @default(POTENTIALLY_ELIGIBLE)
  candidateId         String? // elig-...
  enrolledAt          DateTime?
  consentRef          String? // consent-...
  goals               String[]         @default([])
  barriers            String[]         @default([])
  caregiverId         String? // authorized-caregiver-token
  reviewOwnerId       String? // care-manager-token
  baseline            Json             @default("{}")
  riskTier            String? // Low/Moderate/High/Critical
  activeInterventions String[]         @default([])
  completionCriteria  Json             @default("{}")
  outcome             Json             @default("{}")
  version             String           @default("1.0.0") // pathway version at enrollment — existing patients remain attached unless controlled migration approved
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, patientId, pathwayId])
  @@index([workspaceId, pathwayId])
  @@index([status])
  @@index([patientId])
}

/// Exception — expected pathway states, not technical failures. 22 types.
model HealthPathwayException {
  id                String    @id @default(uuid())
  workspaceId       String
  patientId         String?
  pathwayId         String?
  enrollmentId      String?
  exceptionType     String // Patient declines, Patient unavailable, Patient lacks transport, Language mismatch, Medication unavailable, etc. — 22 types
  severity          String    @default("moderate") // low/moderate/high
  assignedOwner     String?
  resolutionOptions String[]  @default([])
  dueAt             DateTime?
  status            String    @default("open") // open, resolved, adapted, transferred, patient_declined, unable_to_contact, clinician_closed, emergency_superseded, awaiting_external_service, requires_review
  outcome           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, patientId])
  @@index([exceptionType])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — UNIFIED CLINICAL WORK-QUEUE & INBOX ORCHESTRATION
// One role-aware work environment — FHIR Task as workflow abstraction (Task.owner
// = current accountable party, Task.focus = clinical request/resource acted upon).
// Ingestion → Classification/safety → Dedup/link → Priority/SLA → Ownership/route
// → Work/delegate/escalate → Resolution → Audit/outcome/burden/quality.
// ═══════════════════════════════════════════════════════════════════════════════

enum WorkItemStatus {
  RECEIVED
  CLASSIFIED
  VALIDATED
  ROUTED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  AWAITING_INFORMATION
  AWAITING_EXTERNAL_PARTY
  DELEGATED
  ESCALATED
  RESOLVED
  CLOSED
  DUPLICATE
  RETRACTED
  NOT_ACTIONABLE
}

enum WorkItemPriority {
  STAT
  URGENT
  HIGH
  ROUTINE
  BATCH
  INFORMATIONAL
}

/// Normalized, owned, time-bound work item — original event preserved via sourceRef.
model HealthWorkItem {
  id                 String           @id @default(uuid())
  workspaceId        String
  patientId          String?
  type               String // abnormal_lab, imaging_finding, patient_message, renewal_request, prior_auth, referral, discharge, device_failure, unresolved_alert, research_match, compliance_task
  title              String
  status             WorkItemStatus   @default(RECEIVED)
  priority           WorkItemPriority @default(ROUTINE)
  clinicalUrgency    String? // immediate, same_day, next_business_day, routine, none
  clinicalPriority   String? // stored separately from administrative priority
  adminPriority      String?
  actionability      String? // high / medium / low
  owner              String? // current accountable party (Task.owner)
  requestedPerformer String?
  queue              String // abnormal_labs, imaging, messages, renewals, prior_auth, referrals, discharge, device, alerts, research, compliance
  sourceRef          String? // original event preserved — never disappears on merge/delegate/batch/route
  relatedRefs        String[]         @default([])
  dueAt              DateTime?
  slaPolicy          String? // sla policy id/version, e.g. lab-review-v4
  delegation         Json             @default("{}") // { allowed, scope, requires_clinician_for[] }
  evidence           Json             @default("[]")
  patientVisibility  String           @default("care_team_only")
  auditRef           String?
  resolution         Json             @default("{}") // { reason, evidence } — required for CLOSED
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient?        @relation(fields: [patientId], references: [id], onDelete: SetNull)
  events    HealthWorkItemEvent[]

  @@index([workspaceId, queue])
  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, patientId])
  @@index([owner])
  @@index([dueAt])
}

/// Append-only audit trail — who was responsible, saw, changed; which rule routed; SLA met; patient informed; what happened after.
model HealthWorkItemEvent {
  id          String   @id @default(uuid())
  workspaceId String
  workItemId  String
  actorId     String?
  action      String // CREATED, CLASSIFIED, ROUTED, CLAIMED, ACCEPTED, STARTED, DELEGATED, REASSIGNED, INFO_REQUESTED, ESCALATED, BATCH_PREVIEWED, RESOLVED, REOPENED, DISPUTED, CLOSED, VIEWED
  fromStatus  String?
  toStatus    String?
  owner       String?
  metadata    Json     @default("{}") // rule, template/model version, batch membership, patient communication, timer change reason, etc.
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem  HealthWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, workItemId])
  @@index([workItemId, createdAt])
  @@index([action])
}

/// Queue SLA policy — acknowledgement + resolution/handoff timers per priority, business clock, pause conditions.
model HealthWorkQueuePolicy {
  id              String           @id @default(uuid())
  workspaceId     String
  queue           String
  priority        WorkItemPriority
  ackMinutes      Int // acknowledgement deadline
  resolveMinutes  Int // resolution or handoff deadline
  businessHours   Json             @default("{}") // { business_hours, holidays }
  pauseConditions String[]         @default([]) // awaiting_patient, awaiting_payer, awaiting_external_clinician
  version         String           @default("v1")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, queue, priority, version])
  @@index([workspaceId, queue])
  @@index([active])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — MEDICATION SAFETY COCKPIT
// One reconciled, patient-confirmed medication picture across prescriptions,
// dispensing, claims, photographs, caregiver reports, and actual use.
// FHIR separation preserved: MedicationRequest (prescribed) vs MedicationDispense
// (supplied) vs MedicationStatement (reported) vs MedicationAdministration (given).
// ═══════════════════════════════════════════════════════════════════════════════

enum MedicationRecordStatus {
  PRESCRIBED
  DISPENSED
  PATIENT_REPORTED_CURRENT
  CAREGIVER_REPORTED
  ADMINISTERED
  PATIENT_CONFIRMED_CURRENT
  PATIENT_STOPPED
  CLINICIAN_DISCONTINUED
  UNCERTAIN
  HISTORICAL
  DUPLICATE
  REFUSED
  UNABLE_TO_OBTAIN
  UNKNOWN
}

enum MedicationChangeStatus {
  PROPOSED
  AUTHORIZED
  SAFETY_CHECKED
  EXPLAINED
  PATIENT_CONFIRMED
  PHARMACY_SENT
  ACTIVE
  UNCONFIRMED
  DECLINED
  SUPERSEDED
  CANCELLED
}

enum MedicationAlertSeverity {
  CRITICAL
  HIGH
  MODERATE
  LOW
}

/// Canonical reconciled medication — never "currently taking" from an old Rx/claims row alone.
model MedicationRecord {
  id               String                 @id @default(uuid())
  workspaceId      String
  patientId        String
  canonicalName    String // configured_standard_name
  ingredient       String // configured_ingredient (lowercased at write)
  ingredients      String[]               @default([]) // combination products
  therapeuticClass String?
  strength         String? // configured_strength
  form             String? // tablet
  route            String? // oral
  directions       Json                   @default("{}") // { dose, frequency, timing, as_needed }
  status           MedicationRecordStatus @default(UNKNOWN)
  sources          Json                   @default("[]") // [{ type, ref, timestamp, confidence }]
  indication       String? // documented_or_unknown
  prescriber       String?
  pharmacy         String?
  reconciliation   Json                   @default("{}") // { last_reviewed, reviewer, discrepancies[] }
  safetyContext    Json                   @default("{}") // { renal_check, hepatic_check, pregnancy_check, lactation_check }
  missedDoseRule   String? // medicine-specific instruction, source-controlled
  timeCritical     Boolean                @default(false)
  renalRisk        Boolean                @default(false) // requires renal dosing review
  hepatotoxic      Boolean                @default(false)
  pregnancyRisk    Boolean                @default(false)
  controlledClass  String? // schedule/category when applicable
  createdById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, status])
  @@index([workspaceId, ingredient])
}

/// Photograph reconciliation pipeline — confidence per field, never infer dose from appearance.
model MedicationPhoto {
  id           String   @id @default(uuid())
  workspaceId  String
  patientId    String
  recordId     String?
  imageRef     String // storage ref, never raw bytes in DB
  ocr          Json     @default("{}")
  extracted    Json     @default("{}") // { brand, ingredient, strength, form, confidence per field }
  status       String   @default("CAPTURED") // CAPTURED | QUALITY_CHECKED | EXTRACTED | MATCHED | DUPLICATE | UNCLEAR | CONFIRMED | REVIEW_REQUIRED | LINKED
  reviewerNote String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, status])
  @@index([recordId])
}

/// Patient confirmation — timestamped, never silently replaced by a later feed.
model MedicationConfirmation {
  id          String   @id @default(uuid())
  workspaceId String
  patientId   String
  recordId    String
  answers     Json     @default("{}") // taking_now, strength, frequency, last_taken, indication, stopped_by_clinician, side_effects, affordability, helper, ...
  teachBack   Json     @default("{}") // { question, response, understood }
  confirmedBy String // patient | caregiver:<id> | clinician:<id>
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recordId])
  @@index([workspaceId, patientId])
}

/// Medication change — proposed → authorized → safety-checked → explained → patient-confirmed → pharmacy → active.
model MedicationChange {
  id                  String                 @id @default(uuid())
  workspaceId         String
  patientId           String
  recordId            String?
  changeType          String // start | stop | hold | renew | taper | titrate | dose_change | substitution
  payload             Json                   @default("{}")
  reason              String?
  authorizedBy        String?
  safetyCheck         Json                   @default("{}")
  patientExplanation  String?
  patientConfirmation Json                   @default("{}") // { what_changed, why, start_date, understanding, accepted|declined|needs_clarification, at }
  pharmacyStatus      String                 @default("PENDING") // PENDING | SENT | ACKNOWLEDGED | DISPENSED | FAILED
  status              MedicationChangeStatus @default(PROPOSED)
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, status])
  @@index([recordId])
}

/// Clinician-approved taper/titration schedule — executable plan with monitoring + expiry.
model MedicationTaper {
  id               String    @id @default(uuid())
  workspaceId      String
  patientId        String
  recordId         String
  changeId         String?
  kind             String    @default("TAPER") // TAPER | TITRATION
  reason           String?
  approvedBy       String?
  steps            Json      @default("[]") // [{ start, dose, duration, monitoring[] }]
  pauseRules       String[]  @default([])
  contactRules     String[]  @default([])
  patientConfirmed Boolean   @default(false)
  caregiverAccess  String    @default("task_only")
  status           String    @default("DRAFT") // DRAFT | ACTIVE | PAUSED | COMPLETED | EXPIRED | CANCELLED
  expiresAt        DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, status])
  @@index([recordId])
}

/// Medication safety alert — why, evidence, reviewer, notification + block state.
model MedicationAlert {
  id              String                  @id @default(uuid())
  workspaceId     String
  patientId       String
  recordId        String?
  alertClass      String // critical_allergy_conflict | serious_interaction | duplicate_ingredient | dose_out_of_range | renal_adjustment_needed | hepatic_concern | pregnancy_concern | lactation_concern | monitoring_overdue | taper_interruption | high_risk_missed_dose | controlled_substance_rule | duplicate_prescription | dispense_mismatch | affordability_barrier | adverse_event | unable_to_obtain
  severity        MedicationAlertSeverity @default(MODERATE)
  why             String?
  evidence        Json                    @default("[]")
  source          String?
  confidence      String? // high | moderate | low
  reviewer        String?
  patientNotified Boolean                 @default(false)
  actionBlocked   Boolean                 @default(false)
  reviewedAt      DateTime?
  status          String                  @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | DISMISSED_WITH_REASON
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, status])
  @@index([workspaceId, alertClass])
}

/// Structured adverse-event workflow — uncertainty preserved, causality not required to report.
model MedicationAdverseEvent {
  id           String    @id @default(uuid())
  workspaceId  String
  patientId    String
  recordId     String?
  symptom      String
  onsetAt      DateTime?
  severity     String    @default("MODERATE") // MILD | MODERATE | SEVERE | LIFE_THREATENING
  outcome      String?
  hospitalized Boolean   @default(false)
  actionTaken  String?
  dechallenge  String?
  rechallenge  String?
  reporter     String?
  reportId     String? // authorized safety-system identifier (e.g. MedWatch)
  reportStatus String    @default("DRAFT") // DRAFT | SUBMITTED | ACKNOWLEDGED | FOLLOW_UP
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, reportStatus])
  @@index([recordId])
}

/// Secure pharmacy exchange — sender, recipient, purpose, deadline, owner, audit.
model PharmacyMessage {
  id                String    @id @default(uuid())
  workspaceId       String
  patientId         String
  recordId          String?
  direction         String // TO_PHARMACY | FROM_PHARMACY
  purpose           String // new_prescription | renewal | clarification | substitution | availability | prior_auth | mismatch | interaction | synchronization | packaging | delivery | adherence | adverse_event | reconciliation
  body              String?
  patientAuthorized Boolean   @default(false)
  status            String    @default("PENDING") // PENDING | SENT | ACKNOWLEDGED | RESOLVED | FAILED
  responseDeadline  DateTime?
  owner             String? // clinical owner
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, status])
}

/// Jurisdiction-aware controlled-substance policy registry — versioned, official source.
model ControlledSubstancePolicy {
  id            String    @id @default(uuid())
  workspaceId   String
  jurisdiction  String // configured
  medicineClass String // configured
  rules         Json      @default("[]") // [configured_prescription_validity, configured_refill_limit, configured_monitoring_requirement, configured_pdmp_check]
  source        String? // official_regulatory_reference
  effectiveDate DateTime?
  reviewedAt    DateTime?
  owner         String? // pharmacy_compliance
  version       String    @default("v1")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, jurisdiction, medicineClass, version])
  @@index([workspaceId, jurisdiction])
  @@index([active])
}

/// Affordability barrier → covered options → prescriber/pharmacist decision → patient confirm → pharmacy.
model AffordabilityReview {
  id               String   @id @default(uuid())
  workspaceId      String
  patientId        String
  recordId         String?
  barrier          Json     @default("{}") // { copay, coverage, deductible, formulary, quantity_limits, price, assistance, access, transport, ... }
  options          Json     @default("[]") // [{ option, clinical_note, reviewed_by }]
  selectedBy       String?
  patientConfirmed Boolean  @default(false)
  status           String   @default("OPEN") // OPEN | ROUTED | DECIDED | CONFIRMED | CLOSED
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, status])
}

/// Allergy / intolerance — FHIR AllergyIntolerance equivalent for conflict checks.
model MedicationAllergy {
  id          String   @id @default(uuid())
  workspaceId String
  patientId   String
  substance   String // lowercased at write
  reaction    String?
  severity    String   @default("MODERATE") // MILD | MODERATE | SEVERE
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE | UNCONFIRMED
  source      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, status])
  @@index([workspaceId, substance])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — INTEROPERABILITY CONTROL PLANE
// Dedicated layer between external systems and the clinical data platform:
// connectivity, transformation, terminology, validation, delivery, replay,
// quarantine, rate limits, conformance, data quality. Raw transport layer is
// immutable and never overwritten by normalization — reproducibility, safe replay.
// ═══════════════════════════════════════════════════════════════════════════════

enum InteropProtocol {
  FHIR_R4
  FHIR_R5
  HL7_V2
  DICOM_DIMSE
  DICOMWEB
  PHARMACY_FEED
  CLAIMS_FEED
  DEVICE
  RESEARCH
}

enum InteropMessageStatus {
  RECEIVED
  FRAME_VALIDATED
  PERSISTED
  ACKED
  PARSED
  PROFILE_VALIDATED
  IDENTITY_RESOLVED
  TERMINOLOGY_MAPPED
  DEDUPED
  BUSINESS_VALIDATED
  NORMALIZED
  INGESTED
  QUARANTINED
  SUPERSEDED
  FAILED
}

enum InteropValidationOutcome {
  VALID
  VALID_WITH_WARNING
  REPAIRABLE
  QUARANTINE
  UNSUPPORTED_VERSION
  UNKNOWN_PROFILE
  TERMINOLOGY_UNRESOLVED
  IDENTITY_UNRESOLVED
  DUPLICATE_CANDIDATE
  CONFLICT_REVIEW
}

enum InteropQuarantineStatus {
  OPEN
  IN_REVIEW
  RELEASED
  RESOLVED
  EXPIRED
}

enum InteropConflictStatus {
  OPEN
  SOURCE_PRECEDENCE
  HUMAN_MERGED
  PRESERVED_BOTH
  SUPERSEDED
  INVALID_SOURCE
  PATIENT_CORRECTED
  UNRESOLVED
  ESCALATED
}

enum InteropReplayStatus {
  DRAFT
  PREVIEWED
  APPROVED
  RUNNING
  COMPLETED
  PARTIAL_FAILURE
  ROLLED_BACK
  BLOCKED
}

enum InteropConformanceStatus {
  PASS
  CONDITIONAL_PASS
  FAIL
  NOT_TESTED
  UNSUPPORTED
  DEGRADED
  EXPIRED
}

/// Machine-readable interface contract per partner/protocol/direction.
model InteropInterface {
  id                String                   @id @default(uuid())
  workspaceId       String
  interfaceId       String // e.g. partner-ehr-lab-results-v4
  partner           String
  environment       String                   @default("production") // sandbox | certification | preprod | production
  protocol          InteropProtocol
  version           String? // R4, 2.5.1, etc.
  direction         String                   @default("inbound") // inbound | outbound | bidirectional
  endpoint          String?
  resources         String[]                 @default([]) // Observation, DiagnosticReport, ADT, ORU, ...
  profilePackages   String[]                 @default([]) // US-Core, partner-lab-ig
  terminology       Json                     @default("{}") // { systems: [...] }
  security          Json                     @default("{}") // { auth, encryption, scopes[] }
  limits            Json                     @default("{}") // rate limits per lane
  retry             Json                     @default("{}") // { max_attempts, backoff }
  maintenance       Json                     @default("{}") // windows
  sla               String?
  supportContact    String?
  dataUsePurpose    String?
  retention         String?
  conformanceStatus InteropConformanceStatus @default(NOT_TESTED)
  deprecationDate   DateTime?
  status            String                   @default("active") // active | suspended | retired
  owner             String?
  lastContractTest  DateTime?
  nextReview        DateTime?
  createdById       String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  InteropMessage[]
  reports   InteropConformanceReport[]

  @@unique([workspaceId, interfaceId])
  @@index([workspaceId, partner])
  @@index([workspaceId, protocol])
  @@index([workspaceId, status])
}

/// Raw immutable landing zone row. Raw payload never overwritten after transformation.
model InteropMessage {
  id                String                    @id @default(uuid())
  workspaceId       String
  interfaceId       String?
  interfaceRef      InteropInterface?         @relation(fields: [interfaceId], references: [id], onDelete: SetNull)
  protocol          InteropProtocol
  messageType       String // Observation, ADT_A01, C-STORE, STOW-RS, ...
  direction         String                    @default("inbound")
  rawPayload        String // exact bytes received — immutable
  rawHash           String // sha256 for dedup + integrity
  patientId         String?
  status            InteropMessageStatus      @default(RECEIVED)
  validationOutcome InteropValidationOutcome?
  normalizedRef     String? // pointer to normalized resource(s)
  ackCode           String? // AA | AE | AR (HL7 v2)
  ackAt             DateTime?
  dedupKey          String?
  idempotencyKey    String?                   @unique
  errorDetail       String?
  receivedAt        DateTime                  @default(now())
  createdById       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient     HealthPatient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  validations InteropValidation[]
  quarantines InteropQuarantine[]

  @@index([workspaceId, interfaceId])
  @@index([workspaceId, protocol])
  @@index([workspaceId, status])
  @@index([workspaceId, patientId])
  @@index([rawHash])
  @@index([dedupKey])
  @@index([receivedAt])
}

/// One validation pipeline run — stages + OperationOutcome issues.
model InteropValidation {
  id             String                   @id @default(uuid())
  workspaceId    String
  messageId      String
  message        InteropMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  outcome        InteropValidationOutcome
  stages         Json                     @default("[]") // [{ stage, pass, ms }]
  issues         Json                     @default("[]") // OperationOutcome issues
  mappingVersion String?
  profile        String?
  createdById    String?
  createdAt      DateTime                 @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, messageId])
  @@index([workspaceId, outcome])
}

/// Source→target resource mapping definition, versioned.
model InteropMapping {
  id                 String   @id @default(uuid())
  workspaceId        String
  name               String // partner-ehr LabResult → Observation
  sourceSystem       String
  sourceResource     String
  sourceVersion      String?
  targetResource     String
  targetVersion      String?
  profile            String?
  fieldMappings      Json     @default("[]") // [{ source, target, transform, confidence }]
  terminologyVersion String?
  active             Boolean  @default(true)
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, sourceSystem])
  @@index([workspaceId, active])
}

/// Versioned code translation with confidence, steward, expiry. Ambiguous maps stay uncertain.
model InteropTerminologyMap {
  id             String    @id @default(uuid())
  workspaceId    String
  sourceSystem   String // partner-lab
  sourceCode     String // LOCAL-123
  targetSystem   String // http://loinc.org
  targetCode     String? // null while unresolved
  mappingType    String    @default("possible") // exact | narrower | broader | possible
  confidence     String    @default("low") // high | moderate | low
  mappingVersion String    @default("2026.08")
  reviewStatus   String    @default("pending") // pending | steward_approved | rejected
  expiresAt      DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceSystem, sourceCode, mappingVersion])
  @@index([workspaceId, reviewStatus])
  @@index([workspaceId, targetSystem])
  @@index([expiresAt])
}

/// Quarantine — safety mechanism, not a data graveyard. Blocked from CDS/reporting/patient views until released.
model InteropQuarantine {
  id                String                  @id @default(uuid())
  workspaceId       String
  messageId         String
  message           InteropMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reason            String // malformed_payload | unsupported_version | unknown_patient | ...
  severity          String                  @default("high") // critical | high | moderate | low
  owner             String?
  sla               String? // same_day, etc.
  downstreamBlocked Boolean                 @default(true)
  retryAllowed      Boolean                 @default(false)
  status            InteropQuarantineStatus @default(OPEN)
  resolution        Json                    @default("{}")
  resolvedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, reason])
  @@index([workspaceId, messageId])
}

/// Cross-system disagreement — precedence documents why, never erases alternatives.
model InteropConflict {
  id                  String                @id @default(uuid())
  workspaceId         String
  type                String // medication_status_conflict | allergy_conflict | ...
  recordRefs          String[]              @default([])
  patientId           String?
  severity            String                @default("clinical_review_required")
  automaticResolution String                @default("blocked") // blocked | source_precedence
  proposedResolution  Json?
  owner               String?
  status              InteropConflictStatus @default(OPEN)
  resolutionNote      String?
  createdById         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([workspaceId, patientId])
}

/// Replay job — dry-run, idempotent, authorized. Never production→production without protection.
model InteropReplay {
  id             String              @id @default(uuid())
  workspaceId    String
  scope          String              @default("single") // single | batch | time_window | partner | mapping_version
  messageIds     String[]            @default([])
  reason         String?
  targetEnv      String              @default("sandbox")
  mappingVersion String?
  dryRun         Boolean             @default(true)
  status         InteropReplayStatus @default(DRAFT)
  approvedBy     String?
  results        Json                @default("{}") // { delivered, failed, compared, duplicates_suppressed }
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, targetEnv])
}

/// Bulk Data async export job with integrity + scope + expiry tracking.
model InteropBulkJob {
  id              String    @id @default(uuid())
  workspaceId     String
  interfaceId     String?
  status          String    @default("kicked_off") // kicked_off | in_progress | completed | completed_with_warnings | failed | cancelled | expired
  resourceTypes   String[]  @default([])
  groupRef        String?
  scope           String?
  jobRef          String? // remote job identifier / status URL
  files           Json      @default("[]") // [{ url, resource_type, count, sha256 }]
