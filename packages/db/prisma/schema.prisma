  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([lastActivity])
}

model TaskDashboardProjection {
  id           String   @id @default(uuid())
  tenantId     String
  assigneeId   String
  total        Int      @default(0)
  open         Int      @default(0)
  inProgress   Int      @default(0)
  done         Int      @default(0)
  overdue      Int      @default(0)
  highPriority Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, assigneeId])
}

model InboxProjectionItem {
  id          String   @id @default(uuid())
  tenantId    String?
  userId      String
  sourceEvent String
  sourceId    String?
  kind        String
  title       String
  body        String?
  link        String?
  urgent      Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

