// ═══════════════════════════════════════════════════════════════════════════════
// N0VA COLLABORATION LAYER — Presence, Cursors, Embeds, Adaptive Panes
// ═══════════════════════════════════════════════════════════════════════════════

/// Real-time presence sessions for workspace collaboration awareness.
model PresenceSession {
  id                  String         @id @default(uuid())
  userId              String
  workspaceId         String
  status              PresenceStatus @default(ONLINE)
  activeResource      String?
  activeResourceType  String?
  activeSection       String?
  typingInChannel     String?
  cursorX             Int?
  cursorY             Int?
  cursorResourceId    String?
  selectionStart      Int?
  selectionEnd        Int?
  selectionResourceId String?
  viewportX           Int?
  viewportY           Int?
  viewportWidth       Int?
  viewportHeight      Int?
  lastHeartbeat       DateTime       @default(now())
  joinedAt            DateTime       @default(now())
  color               String         @default("#7c5cfc")
  customStatus        String?        @default("")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, activeResource])
  @@index([userId, workspaceId])
}

/// Live embed instances shared in chat channels.
model LiveEmbed {
  id            String          @id @default(uuid())
  channelId     String
  workspaceId   String
  messageId     String?
  sourceType    EmbedSourceType
  sourceId      String
  title         String
  description   String?
  thumbnailUrl  String?
  url           String
  metadata      Json            @default("{}")
  lastUpdatedAt DateTime        @default(now())
  createdAt     DateTime        @default(now())

  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([workspaceId, sourceType])
}

/// Adaptive pane state per user per workspace.
/// Per-user workspace-adaptive UI state (spec: adaptive workspace modes).
/// currentMode is the effective mode; explicit selections always beat
/// inferred ones, and inference only ever suggests (never switches).
model AdaptivePaneState {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  currentMode WorkspaceMode @default(COLLABORATION)
  activePane  PaneType      @default(NONE)
  paneWidth   Int           @default(360)
  collapsed   Boolean       @default(false)

  /// Where the effective mode came from: manual | locked | inferred.
  stateSource         String         @default("manual")
  stateConfidence     Float          @default(1)
  /// Optional lock window; after this the mode reverts to inferred.
  expiresAt           DateTime?
  /// Per-mode overrides: { notifications: "digest_only", modules: [...], ai_behavior: "quiet" }.
  modeOverrides       Json           @default("{}")
  /// Latest inference suggestion (never auto-applied).
  suggestedMode       WorkspaceMode?
  suggestedConfidence Float          @default(0)
  suggestedAt         DateTime?
  suggestedReasons    Json           @default("[]")
  /// Last inferred mode + when it was computed (for fade-in fallback).
  inferredMode        WorkspaceMode?
  inferredConfidence  Float          @default(0)
  inferredAt          DateTime?
  lastSwitchAt        DateTime?
  updatedAt           DateTime       @updatedAt
  createdAt           DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

/// Presentation mode sessions.
model PresentationSession {
  id          String    @id @default(uuid())
  workspaceId String
  startedById String
  channelId   String?
  title       String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedBy User         @relation(fields: [startedById], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

/// Sub-vocal command palette configuration.
model SubVocalConfig {
  id                  String   @id @default(uuid())
  userId              String
  workspaceId         String
  enabled             Boolean  @default(false)
  confidenceThreshold Float    @default(0.7)
  showConfidence      Boolean  @default(true)
  ephemeralConfirm    Boolean  @default(true)
  sessionKey          String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

