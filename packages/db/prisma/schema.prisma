  AUTO_CREATED
}

/// N0VA VOICE (Project Echo) — a transcribed recording (note/memo/huddle/upload/live).
model VoiceRecording {
  id                  String       @id @default(uuid())
  voiceId             String       @unique
  workspaceId         String
  createdById         String
  source              VoiceSource  @default(NOTE)
  status              VoiceStatus  @default(PENDING)
  title               String       @default("")
  audioKey            String       @default("")
  audioSizeBytes      Int          @default(0)
  audioDurationMs     Int          @default(0)
  mimeType            String       @default("audio/webm")
  language            String       @default("en")
  consent             VoiceConsent @default(INFORMED)
  retentionDays       Int          @default(90)
  roomRef             String?
  threadRef           String?
  timezone            String?
  transcriptText      String       @default("")
  correctedTranscript String?
  transcriptVersion   Int          @default(1)
  confidenceAvg       Float?
  qualityStats        Json?
  summary             Json?
  meta                Json?
  transcribedAt       DateTime?
  completedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  segments    VoiceTranscriptSegment[]
  extractions VoiceExtraction[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([status])
  @@index([source])
  @@index([roomRef])
}

/// Timestamped, speaker-labeled transcript segment (original + corrected versions).
model VoiceTranscriptSegment {
  id            String  @id @default(uuid())
  recordingId   String
  order         Int
  startMs       Int
  endMs         Int
  speaker       String  @default("SPEAKER_00")
  text          String
