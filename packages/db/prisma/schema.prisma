/// N0VA1O - integration gateway.
model Integration {
  id            String   @id @default(uuid())
  workspaceId   String
  createdById   String?
  provider      String
  name          String
  category      String   @default("other")
  status        String   @default("connected")
  config        Json
  enabled       Boolean  @default(true)
  mcpEnabled    Boolean  @default(false)
  webhookEnabled Boolean @default(true)
  webhookSecret String?
  webhookPath   String?
  rateLimitPerMin Int    @default(120)
  retryMax      Int      @default(3)
  timeoutMs     Int      @default(15000)
   allowlistTools Json         @default("[]")
   blocklistTools Json         @default("[]")
   /// The currently-selected account for multi-account switching (spec §3.6).
   activeConnectionId String? @unique
   lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

   workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
   createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
   logs       IntegrationLog[]
   accessRequests IntegrationAccessRequest[]
   connections  IntegrationConnection[]
   activeConnection IntegrationConnection? @relation("ActiveConnection", fields: [activeConnectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt(sort: Desc)])
}

model IntegrationLog {
  id            String      @id @default(uuid())
  integrationId String
  workspaceId   String
  level         String      @default("info")
  direction     String      @default("outbound")
  statusCode    Int?
  durationMs    Int?
  idempotencyKey String?
  method        String?
  path          String?
  meta          Json?
  message       String
  createdAt     DateTime    @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

/// N0VA1O MCP - governed tool access requests (blocked destructive tools).
enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model IntegrationAccessRequest {
  id               String    @id @default(uuid())
  integrationId    String
  workspaceId      String
  requestedById    String?
  requesterLabel   String    @default("mcp-agent")
  tool             String
  reason           String    @default("")
  /// The exact arguments the agent passed (JSON object). Stored for review
  /// so an approver can see the precise parameters that were blocked.
  toolArguments    Json?
  /// The agent's chain-of-thought / reasoning that led to the request,
  /// if provided by the caller. Enables the Interrogation Room review panels.
  reasoningChain   Json?
  /// A compact lineage of prior tool calls in the same session, so reviewers
  /// can see what data the agent accessed before requesting the action.
  sessionContext   Json?
  status           AccessRequestStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  /// Cryptographic signature (base64) over the decision, applied at approval
  /// time. Lets admins digitally sign off via the Interrogation Room.
  approvedSignature String?
  createdAt        DateTime  @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/// N0VA1O JIT authentication — tenant-isolated per-account credential envelopes.
model IntegrationConnection {
  id              String   @id @default(uuid())
  integrationId   String
  workspaceId     String
  /// Human-readable label for this account (e.g. "prod Meta BM #1").
  accountLabel    String?
  /// OAuth2 / apiKey / basic / webhook — mirrors the catalog auth type.
  authType        String
   /// Encrypted token envelope (AES-256-GCM per tenant key). Never plaintext.
   encryptedToken  String
   /// OAuth2 refresh token (encrypted). Enables transparent token refresh.
   refreshToken    String?
   /// When the refresh token itself expires (if the provider rotates it).
   refreshTokenExpiresAt DateTime?
   /// The plaintext scopes this connection is authorized for (scope pruning).
  allowedScopes  Json?    @default("[]")
  /// Action-level allowlist from the catalog (e.g. ["read_campaigns", "update_budget"]).
  allowedActions Json?    @default("[]")
  /// Action-level blocklist (e.g. ["delete_account", "modify_billing"]).
  blockedActions Json?    @default("[]")
  /// Token lifecycle state machine state.
  tokenState     TokenState @default(ACTIVE)
  /// When the access token expires (for proactive refresh).
  expiresAt       DateTime?
  /// When the credential was last refreshed / verified.
  lastRefreshed   DateTime?
  status          ConnectionStatus @default(ACTIVE)
  /// Health-score 0..1 surfaced by the self-improving auth optimizer.
  healthScore     Float?   @default(1.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

   integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
   workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
   activeForIntegration Integration? @relation("ActiveConnection")

   @@index([workspaceId, integrationId])
  @@index([expiresAt])
  @@index([tokenState])
}

/// Token lifecycle state machine (spec §3.1.1)
enum TokenState {
  PROVISIONING
  ACTIVE
  REFRESHING
  DEGRADED
  FAILED
  REVOKED
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

