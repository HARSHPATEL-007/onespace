// ═══════════════════════════════════════════════════════════════════════════════
// N0VA FEDERATION — Sovereign Interoperability Stack
// ═══════════════════════════════════════════════════════════════════════════════

model FederationConnection {
  id             String             @id @default(uuid())
  workspaceId    String
  protocol       FederationProtocol
  mode           FederationMode
  remoteDomain   String
  remoteRoomId   String?
  localChannelId String?
  trustLevel     TrustLevel         @default(PARTNER)
  status         FederationStatus   @default(PENDING)
  capabilities   String[]           @default([])
  config         Json               @default("{}")
  lastSyncAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identities FederatedIdentity[]
  auditLogs  FederationAuditLog[]

  @@index([workspaceId, protocol])
  @@index([remoteDomain])
}

model FederatedIdentity {
  id               String     @id @default(uuid())
  connectionId     String
  workspaceId      String
  externalUserId   String
  externalProtocol String
  localAlias       String
  displayName      String?
  trustLevel       TrustLevel @default(PARTNER)
  roleMapping      String     @default("guest")
  avatarUrl        String?
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  connection FederationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalUserId])
  @@index([workspaceId])
}

model FederationPolicy {
  id           String               @id @default(uuid())
  workspaceId  String
  policyType   FederationPolicyType @default(WHITELIST)
  domainRules  Json                 @default("[]")
  contentRules Json                 @default("[]")
  enabled      Boolean              @default(true)
  breakGlass   Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
}

model FederationAuditLog {
  id           String   @id @default(uuid())
  connectionId String?
  workspaceId  String
  action       String
  actorId      String?
  details      Json     @default("{}")
  createdAt    DateTime @default(now())

  connection FederationConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt(sort: Desc)])
}

model GuestAccess {
  id           String      @id @default(uuid())
  workspaceId  String
  channelId    String?
  guestEmail   String
  guestName    String
  accessTier   GuestTier   @default(VIEWER)
  invitedById  String
  roomScope    String[]    @default([])
  expiresAt    DateTime?
  lastAccessAt DateTime?
  status       GuestStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([guestEmail])
}

enum FederationProtocol {
  N0VA_NATIVE
  MATRIX
  XMPP
  SLACK_BRIDGE
  DISCORD_BRIDGE
}

enum FederationMode {
  PRODUCTION
  BETA
  PLANNED
