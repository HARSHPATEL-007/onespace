// ═══════════════════════════════════════════════════════════════════════════════
// N0VA THREADS — Conversation Memory & Decision System
// ═══════════════════════════════════════════════════════════════════════════════

/// Rich metadata for threaded conversations.
model ThreadMetadata {
  id               String           @id @default(uuid())
  threadId         String           @unique
  rootMessageId    String
  channelId        String
  workspaceId      String
  title            String           @default("Thread")
  parentThreadId   String?
  depth            Int              @default(0)
  branchPath       Json             @default("[]")
  summaryShort     String?          @default("")
  summaryBullets   Json             @default("[]")
  lastActivityAt   DateTime         @default(now())
  replyCount       Int              @default(0)
  participantCount Int              @default(0)
  labels           String[]         @default([])
  visibility       ThreadVisibility @default(ROOM)
  status           ThreadStatus     @default(ACTIVE)
  frozenUntil      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  channel      ChatChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentThread ThreadMetadata?    @relation("ThreadNesting", fields: [parentThreadId], references: [id], onDelete: Cascade)
  childThreads ThreadMetadata[]   @relation("ThreadNesting")
  decisions    ThreadDecision[]
  actionItems  ThreadActionItem[]
  bookmarks    ThreadBookmark[]
  exports      ThreadExport[]
  pins         ThreadPin[]

  @@index([channelId])
  @@index([workspaceId, status])
  @@index([rootMessageId])
  @@index([parentThreadId])
}

/// Extracted decisions from thread conversations.
model ThreadDecision {
  id              String         @id @default(uuid())
  threadId        String
  workspaceId     String
  sourceMessageId String?
  sourceQuote     String?
  decisionText    String
  authorName      String?
  status          DecisionStatus @default(PROPOSED)
  approvedBy      String?
  approvedAt      DateTime?
  linkedTaskId    String?
  linkedDocId     String?
  confidence      Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  thread    ThreadMetadata @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([workspaceId, status])
}

/// Extracted action items from thread conversations.
model ThreadActionItem {
  id              String           @id @default(uuid())
  threadId        String
  workspaceId     String
  sourceMessageId String?
  sourceQuote     String?
  title           String
  ownerName       String?
  ownerUserId     String?
  dueDate         DateTime?
  priority        ActionPriority   @default(MEDIUM)
  status          ActionStatus     @default(OPEN)
  confidence      Float            @default(0)
  extractedBy     ExtractionMethod @default(AI_AUTO)
  confirmedBy     String?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  thread    ThreadMetadata @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([workspaceId, status])
  @@index([ownerUserId])
  @@index([dueDate])
}

/// Pinning and bookmarks for threads.
model ThreadPin {
  id          String      @id @default(uuid())
  threadId    String
  workspaceId String
  userId      String
  pinType     PinType     @default(ROOM)
  priority    PinPriority @default(NORMAL)
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  thread    ThreadMetadata @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, pinType])
  @@index([userId])
}

/// Personal bookmarks within threads.
model ThreadBookmark {
  id          String   @id @default(uuid())
  threadId    String
  workspaceId String
  userId      String
  messageId   String?
  note        String?
  createdAt   DateTime @default(now())

  thread    ThreadMetadata @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Thread export records.
model ThreadExport {
  id          String       @id @default(uuid())
  threadId    String
  workspaceId String
  createdById String
  format      ExportFormat
  exportMode  ExportMode
  content     String
  fileSize    Int          @default(0)
  createdAt   DateTime     @default(now())

  thread    ThreadMetadata @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([workspaceId])
}

