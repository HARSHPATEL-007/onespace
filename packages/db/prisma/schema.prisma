  @@index([tenantId])
}

model ComplianceProjection {
  id           String   @id @default(uuid())
  tenantId     String?
  kind         String
  objectId     String?
  title        String
  status       String   @default("WATCH")
  severity     String   @default("INFO")
  linkedEvents String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
  @@index([kind])
}

model EventSubscription {
  id             String   @id @default(uuid())
  consumerKey    String
  eventTypes     String[] @default([])
  handlerVersion Int      @default(1)
  filterJson     Json     @default("{}")
  enabled        Boolean  @default(true)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([consumerKey])
}

