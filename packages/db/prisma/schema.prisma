// ═══════════════════════════════════════════════════════════════════════════════
// N0VA NOTIFICATION ENGINE — Policy-Driven Attention System
// ═══════════════════════════════════════════════════════════════════════════════

/// Canonical notification event with scoring metadata.
model NotificationEvent {
  id              String             @id @default(uuid())
  recipientId     String
  workspaceId     String
  sourceType      String
  sourceId        String?
  roomId          String?
  threadId        String?
  title           String
  body            String?
  link            String?
  signals         Json               @default("{}")
  priorityScore   Int                @default(0)
  channelPlan     String[]           @default([])
  ruleHits        String[]           @default([])
  status          NotificationStatus @default(QUEUED)
  digestId        String?
  escalationLevel Int                @default(0)
  acknowledgedAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  recipient         User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries        DeliveryRecord[]
  digest            NotificationDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)
  escalationRecords EscalationRecord[]

  @@index([recipientId, status])
  @@index([recipientId, priorityScore(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([digestId])
}

/// Delivery records per channel for reliability tracking.
model DeliveryRecord {
  id             String          @id @default(uuid())
  notificationId String
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  attemptCount   Int             @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  notification NotificationEvent @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel])
  @@index([status, createdAt])
}

/// User-defined notification rules with operator-based filters.
model NotificationRule {
  id             String       @id @default(uuid())
  userId         String
  workspaceId    String
  name           String
  enabled        Boolean      @default(true)
  priority       RulePriority @default(NORMAL)
  conditions     Json         @default("[]")
  actions        Json         @default("[]")
  stopProcessing Boolean      @default(false)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, order])
}

/// User notification preferences per channel and category.
model UserNotificationPrefs {
  id                 String          @id @default(uuid())
  userId             String
  workspaceId        String
  channelPrefs       Json            @default("{}")
  quietHoursStart    String?
  quietHoursEnd      String?
  focusModeEnabled   Boolean         @default(false)
  digestFrequency    DigestFrequency @default(HOURLY)
  escalationLevel    Int             @default(2)
  perRoomOverrides   Json            @default("{}")
  perSenderOverrides Json            @default("{}")
  updatedAt          DateTime        @updatedAt
  createdAt          DateTime        @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

/// AI-generated digests for burst compression.
model NotificationDigest {
  id              String       @id @default(uuid())
  workspaceId     String
  userId          String
  roomId          String?
  title           String
  summary         String
  highlights      Json         @default("[]")
  decisionChanges Json         @default("[]")
  actionItems     Json         @default("[]")
  mentions        Json         @default("[]")
  messageCount    Int          @default(0)
  status          DigestStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  deliveredAt     DateTime?

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    NotificationEvent[]

  @@index([userId, status])
}

/// Escalation tracking for unacknowledged critical alerts.
model EscalationRecord {
  id               String    @id @default(uuid())
  notificationId   String
  userId           String
  workspaceId      String
  currentLevel     Int       @default(0)
  maxLevel         Int       @default(3)
  nextEscalationAt DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  notification NotificationEvent @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, currentLevel])
}

// ── Notification Enums ────────────────────────────────────────────────────────

enum NotificationStatus {
  QUEUED
  SCORING
  FILTERED
  SUPPRESSED
  DELIVERING
  DELIVERED
  ACKNOWLEDGED
  FAILED
  DIGESTED
}

enum DeliveryChannel {
  WEBSOCKET
  FCM
  APNS
  SMS
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum RulePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum DigestFrequency {
  REALTIME
  HOURLY
  DAILY
  WEEKLY
}

enum DigestStatus {
  PENDING
  GENERATING
  READY
  DELIVERED
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA BOTS — Automation & Orchestration Platform
// ═══════════════════════════════════════════════════════════════════════════════

model Bot {
  id              String    @id @default(uuid())
  workspaceId     String
  createdById     String
  name            String
  avatarUrl       String?
  description     String    @default("")
  persona         Json      @default("{}")
  knowledgeScopes String[]  @default([])
  permissions     Json      @default("{}")
  status          BotStatus @default(ACTIVE)
  rateLimitPerMin Int       @default(60)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  triggers   BotTrigger[]
  executions BotExecution[]
  webhooks   BotWebhook[]
  auditLogs  BotAuditLog[]

  @@index([workspaceId, status])
}

model BotTrigger {
  id        String         @id @default(uuid())
  botId     String
  type      BotTriggerType
  config    Json           @default("{}")
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())

  bot        Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  executions BotExecution[]

  @@index([botId, type])
}

model BotExecution {
  id           String          @id @default(uuid())
  botId        String
  triggerId    String?
  triggerType  String
  input        Json            @default("{}")
  output       Json            @default("{}")
  status       ExecutionStatus @default(PENDING)
  durationMs   Int             @default(0)
  errorMessage String?
  createdAt    DateTime        @default(now())

  bot     Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  trigger BotTrigger? @relation(fields: [triggerId], references: [id], onDelete: SetNull)

  @@index([botId, status])
  @@index([createdAt(sort: Desc)])
}

model BotWebhook {
  id        String           @id @default(uuid())
  botId     String
  direction WebhookDirection
  url       String
  secret    String?
  events    String[]         @default([])
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, direction])
}

model BotAuditLog {
  id        String   @id @default(uuid())
  botId     String
  action    String
  actorId   String?
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt(sort: Desc)])
}

enum BotStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum BotTriggerType {
  SLASH_COMMAND
  MENTION
  WEBHOOK
  SCHEDULED
  AI_TRIGGER
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum WebhookDirection {
  INCOMING
  OUTGOING
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA SEARCH — Hybrid Retrieval System (Lexical + Semantic + Neural)
// ═══════════════════════════════════════════════════════════════════════════════

/// Unified search index for all workspace content.
model SearchIndex {
  id             String            @id @default(uuid())
  workspaceId    String
  contentType    SearchContentType
  contentId      String
  title          String
  body           String
  excerpt        String            @default("")
  embedding      String            @default("")
  embeddingModel String            @default("n0va-embed-v3")
  lexicalVector  String            @default("")
  entities       Json              @default("[]")
  metadata       Json              @default("{}")
  permissions    Json              @default("{}")
  indexedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, contentType, contentId])
  @@index([workspaceId, contentType])
  @@index([workspaceId, indexedAt(sort: Desc)])
}

/// Search query log for analytics and suggestions.
model SearchQueryLog {
  id             String          @id @default(uuid())
  workspaceId    String
  userId         String
  query          String
  queryType      SearchQueryType @default(NATURAL)
  filters        Json            @default("{}")
  resultCount    Int             @default(0)
  topScore       Float           @default(0)
  latencyMs      Int             @default(0)
  clickedResults String[]        @default([])
  createdAt      DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

/// Search suggestions based on query history and content.
model SearchSuggestion {
  id          String   @id @default(uuid())
  workspaceId String
  query       String
  suggestion  String
  score       Float    @default(0)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, score(sort: Desc)])
}

// ── Search Enums ──────────────────────────────────────────────────────────────

enum SearchContentType {
  MESSAGE
  THREAD
  THREAD_SUMMARY
  DECISION
  ACTION_ITEM
  PIN
  BOOKMARK
  ATTACHMENT
  STORAGE_ITEM
  LIVE_EMBED
  CONTACT
  MEETING
  NOTIFICATION
}

enum SearchQueryType {
  NATURAL
  KEYWORD
  SEMANTIC
  HYBRID
  OPERATOR
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HUDDLES — Tiered Real-Time Media System
// ═══════════════════════════════════════════════════════════════════════════════

/// Huddle sessions with modes, quality profiles, and governance.
model HuddleSession {
  id               String              @id @default(uuid())
  workspaceId      String
  channelId        String?
  createdById      String
  title            String
  mode             HuddleMode          @default(INSTANT)
  status           HuddleSessionStatus @default(SCHEDULED)
  qualityProfile   QualityProfile      @default(PREMIUM)
  presenterVideo   String              @default("4k60")
  participantVideo String              @default("720p30")
  audioCodec       String              @default("opus_48khz_stereo")
  maxParticipants  Int                 @default(100)
  guestPolicy      Json                @default("{}")
  recordingEnabled Boolean             @default(false)
  recordingType    RecordingType       @default(COMPOSITE)
  retentionDays    Int                 @default(90)
  consentRequired  Boolean             @default(true)
  startedAt        DateTime?
  endedAt          DateTime?
  scheduledFor     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants HuddleParticipant[]
  recordings   HuddleRecording[]
  breakouts    BreakoutRoom[]
  artifacts    HuddleArtifact[]

  @@index([workspaceId, status])
  @@index([createdById])
}

/// Participant state within a huddle.
model HuddleParticipant {
  id             String         @id @default(uuid())
  huddleId       String
  userId         String?
  displayName    String
  role           HuddleRole     @default(ATTENDEE)
  guestToken     String?        @unique
  guestOrg       String?
  audioEnabled   Boolean        @default(true)
  videoEnabled   Boolean        @default(true)
  isPresenter    Boolean        @default(false)
  isSpeaking     Boolean        @default(false)
  handRaised     Boolean        @default(false)
  networkQuality NetworkQuality @default(GOOD)
  joinedAt       DateTime       @default(now())
  leftAt         DateTime?

  huddle HuddleSession @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([huddleId])
  @@index([userId])
}

/// Server-side recording with composite and raw-track support.
model HuddleRecording {
  id            String          @id @default(uuid())
  huddleId      String
  workspaceId   String
  startedById   String
  recordingType RecordingType   @default(COMPOSITE)
  status        RecordingStatus @default(RECORDING)
  storageKey    String?
  durationSec   Int             @default(0)
  fileSizeBytes Int             @default(0)
  trackCount    Int             @default(0)
  transcriptKey String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime        @default(now())

  huddle    HuddleSession    @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedBy User             @relation(fields: [startedById], references: [id], onDelete: Cascade)
  tracks    RecordingTrack[]

  @@index([huddleId])
}

/// Individual participant recording tracks.
model RecordingTrack {
  id              String    @id @default(uuid())
  recordingId     String
  participantId   String?
  participantName String?
  trackType       TrackType
  storageKey      String
  durationSec     Int       @default(0)
  fileSizeBytes   Int       @default(0)
  isRedacted      Boolean   @default(false)
  createdAt       DateTime  @default(now())

  recording HuddleRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
}

/// Breakout rooms spawned from a parent huddle.
model BreakoutRoom {
  id                String         @id @default(uuid())
  parentHuddleId    String
  workspaceId       String
  createdById       String
  title             String
  assignmentType    AssignmentType @default(MANUAL)
  durationMin       Int?
  status            BreakoutStatus @default(ACTIVE)
  broadcastFromHost String?
  createdAt         DateTime       @default(now())
  endedAt           DateTime?

  parentHuddle HuddleSession         @relation(fields: [parentHuddleId], references: [id], onDelete: Cascade)
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants BreakoutParticipant[]

  @@index([parentHuddleId])
}

model BreakoutParticipant {
  id          String   @id @default(uuid())
  breakoutId  String
  userId      String?
  displayName String
  assignedAt  DateTime @default(now())

  breakout BreakoutRoom @relation(fields: [breakoutId], references: [id], onDelete: Cascade)

  @@index([breakoutId])
}

/// Artifacts produced by huddles (transcripts, summaries, decisions, tasks).
model HuddleArtifact {
  id           String             @id @default(uuid())
  huddleId     String
  workspaceId  String
  artifactType HuddleArtifactType
  title        String
  content      String             @default("")
  storageKey   String?
  metadata     Json               @default("{}")
  createdAt    DateTime           @default(now())

  huddle    HuddleSession @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([huddleId])
  @@index([workspaceId, artifactType])
}

// ── Huddle Enums ──────────────────────────────────────────────────────────────

enum HuddleMode {
  INSTANT
  SCHEDULED
  PERSISTENT
  BREAKOUT
}

enum HuddleSessionStatus {
