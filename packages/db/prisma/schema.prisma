  MENTAL_HEALTH
  SUBSTANCE_USE
  GENOMICS
  REPRODUCTIVE_HEALTH
  VOICE_RECORDINGS
  BEHAVIORAL
  BIOMETRIC
  LOCATION
  RESEARCH_DATA
  ENVIRONMENTAL
  FINANCIAL_INSURANCE
}

enum WalletPurpose {
  TREATMENT
  PAYMENT
  CARE_COORDINATION
  WELLNESS
  RESEARCH
  QUALITY_IMPROVEMENT
  PUBLIC_HEALTH
  EMERGENCY_RESPONSE
