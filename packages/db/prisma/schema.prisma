  updatedAt      DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Telehealth Session — video consultations with FHIR + N0VA Meet bridge.
model HealthTelehealthSession {
  id              String    @id @default(uuid())
  workspaceId     String
  patientId       String
  encounterId     String?
  providerId      String?
  providerName    String?
  status          String    @default("scheduled") // scheduled | waiting | in_progress | completed | cancelled | no_show
  scheduledAt     DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  durationSec     Int?
  modality        String    @default("video") // video | audio | chat
  meetRoomId      String?
  recordingUrl    String?
  notes           String    @default("")
  fhirAppointment Json?
