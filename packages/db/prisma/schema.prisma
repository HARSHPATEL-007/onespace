/// Seat within a workspace + assigned role.
model WorkspaceMember {
  id          String       @id @default(uuid())
  workspaceId String
  userId      String
  role        Role         @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Per-workspace RBAC matrix override per module + action.
model WorkspacePermission {
  id          String           @id @default(uuid())
  workspaceId String
  role        Role
  module      String
  action      PermissionAction
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role, module, action])
  @@index([workspaceId])
}

/// Immutable, tenant-scoped provenance trail.
model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String?
  module      String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorId])
}

/// Shared asset references used by every content and communication module.
model Attachment {
  id          String         @id @default(uuid())
  workspaceId String
  createdById String
  filename    String
  mimeType    String
  sizeBytes   Int            @default(0)
  storageKey  String
  kind        AttachmentKind @default(FILE)
  checksum    String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdById])
}

/// Cross-module in-app notifications.
model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  type        String?
  title       String
  body        String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  ADMIN
}

enum AttachmentKind {
  FILE
  LINK
}

/// N0VA CALENDAR — events.
model CalendarEvent {
  id          String             @id @default(uuid())
  workspaceId String
  createdById String?
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean            @default(false)
  attendees   String[]           @default([])
  recurrence  CalendarRecurrence @default(NONE)
  repeatUntil DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
}

enum CalendarRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

/// N0VA CONTACTS — unified people model.
model Contact {
  id          String          @id @default(uuid())
  workspaceId String
  createdById String?
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  phoneE164   String?
  company     String?
  title       String?
  avatarUrl   String?
  notes       String?
  labels      String[]        @default([])
  isFavorite  Boolean         @default(false)
  n0vachatId  String?
  username    String?
  address     String?
  website     String?
  platform    ContactPlatform @default(N0VA)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  chatLinks ContactChatLink[]

  @@unique([workspaceId, n0vachatId])
  @@index([workspaceId, email])
  @@index([workspaceId, isFavorite])
  @@index([workspaceId, firstName])
  @@index([workspaceId, phone])
  @@index([workspaceId, n0vachatId])
}

model ContactChatLink {
  id          String          @id @default(uuid())
  contactId   String
  workspaceId String
  channelId   String?
  userId      String?
  platform    ContactPlatform @default(N0VA)
  status      ChatLinkStatus  @default(ACTIVE)
  lastUsedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([workspaceId, userId])
  @@index([channelId])
}

enum ContactPlatform {
  N0VA
  WHATSAPP
  TELEGRAM
  SIGNAL
  IMESSAGE
  SMS
}

enum ChatLinkStatus {
  ACTIVE
  PENDING_INVITE
  BLOCKED
  ARCHIVED
}

/// N0VA FORMS — builders and responses.
model Form {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  description String?
  fields      Json
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  responses FormResponse[]

  @@index([workspaceId])
}

model FormResponse {
  id          String   @id @default(uuid())
  formId      String
  workspaceId String
  answers     Json
  submittedAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

/// N0VA KEEP — notes and lists.
model Note {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  title       String   @default("")
  body        String   @default("")
  color       String   @default("default")
  pinned      Boolean  @default(false)
  archived    Boolean  @default(false)
  labels      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, pinned, archived])
}

/// N0VA CLOUD STORAGE — files, folders, versions, retention, compliance.
model StorageItem {
  id                 String    @id @default(uuid())
  workspaceId        String
  createdById        String?
  name               String
  isFolder           Boolean   @default(false)
  parentId           String?
  mimeType           String    @default("application/octet-stream")
  sizeBytes          Int       @default(0)
  storageKey         String?
  checksum           String?
  version            Int       @default(1)
  trashedAt          DateTime?
  retentionMode      String    @default("STANDARD")
  retainUntil        DateTime?
  complianceLocked   Boolean   @default(false)
  immutable          Boolean   @default(false)
  legalHold          Boolean   @default(false)
  legalHoldReason    String?
  lastAccessedAt     DateTime?
  accessCount        Int       @default(0)
  lockedById         String?
  lockedAt           DateTime?
  restrictedDownload Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  parent    StorageItem?         @relation("StorageFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  StorageItem[]        @relation("StorageFolder")
  versions  StorageFileVersion[]
  links     FileLink[]
  fileIndex FileIndex[]

  @@index([workspaceId, parentId, trashedAt])
  @@index([workspaceId, legalHold])
  @@index([workspaceId, retentionMode])
}

/// Immutable revision of a file, with status, approval and compliance state.
model StorageFileVersion {
  id             String    @id @default(uuid())
  itemId         String
  workspaceId    String
  versionNumber  Int       @default(0)
  status         String    @default("CURRENT")
  approvalStatus String    @default("DRAFT")
  changeSummary  String?
  sizeBytes      Int       @default(0)
  storageKey     String
  checksum       String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  recalledById   String?
  recalledAt     DateTime?
  recallReason   String?
  isLocked       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  item StorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, versionNumber])
  @@index([itemId])
  @@index([itemId, versionNumber])
}

/// Content index for files and attachments: extracted text, OCR, entities, topics.
model FileIndex {
  id            String    @id @default(uuid())
  workspaceId   String
  objectType    String
  objectId      String
  itemId        String?
  versionNumber Int       @default(0)
  filename      String
  mimeType      String
  extractedText String?
  ocrText       String?
  entities      Json      @default("[]")
  topics        Json      @default("[]")
  indexState    String    @default("PENDING")
  indexedAt     DateTime?
  updatedAt     DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item      StorageItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, objectType, objectId])
  @@index([workspaceId, indexState])
}

/// Tamper-evident file access audit chain (sha3-512), separate from platform logs.
model FileAccessLog {
  id            String   @id @default(uuid())
  workspaceId   String
  actorId       String?
  actorName     String?
  action        String
  objectType    String
  objectId      String
  itemId        String?
  versionId     String?
  versionNumber Int?
  channelId     String?
  module        String?
  outcome       String   @default("SUCCESS")
  policyApplied String?
  ip            String?
  userAgent     String?
  details       Json     @default("{}")
  hash          String
  chainPrev     String?
  chainIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([objectId])
  @@index([workspaceId, action])
}

/// Legal hold on files/folders/workspace scope; overrides deletion and retention.
model FileLegalHold {
  id               String    @id @default(uuid())
  workspaceId      String
  scope            String
  objectId         String?
  matterName       String?
  reason           String
  placedById       String
  placedAt         DateTime  @default(now())
  noticeIssuedAt   DateTime?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  releasedById     String?
  releasedAt       DateTime?
  active           Boolean   @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
  @@index([objectId])
}

/// File-to-context backlinks: thread, decision, task, calendar, approval, message.
model FileLink {
  id            String   @id @default(uuid())
  workspaceId   String
  itemId        String
  objectType    String
  objectId      String
  versionNumber Int?
  createdById   String?
  createdAt     DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item      StorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, objectType, objectId, versionNumber])
  @@index([objectType, objectId])
  @@index([itemId])
}

/// N0VA APPROVALS — AI-detected, policy-routed decision workflows.

/// Canonical approval workflow record raised from chat or module events.
model ApprovalRequest {
  id                   String    @id @default(uuid())
  workspaceId          String
  requestType          String
  sourceMessageId      String?
  sourceChannelId      String?
  requesterId          String
  requesterName        String?
  amountCents          Int?
  currency             String    @default("USD")
  policyRuleId         String?
  policyRuleName       String?
  thresholdCents       Int?
  costCenter           String?
  rationale            String?
  evidence             Json      @default("[]")
  status               String    @default("DETECTED")
  approverChain        Json      @default("[]")
  currentApproverIndex Int       @default(0)
  dueAt                DateTime?
  escalationAt         DateTime?
  lastRemindedAt       DateTime?
  decisionAt           DateTime?
  decisionNote         String?
  decisionById         String?
  erpReference         String?
  erpSyncStatus        String    @default("NOT_SYNCED")
  erpSyncAttempts      Int       @default(0)
  erpSyncError         String?
  retryUntil           DateTime?
  downstreamStatus     String    @default("NONE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester        User?                @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  decisionBy       User?                @relation("ApprovalDecider", fields: [decisionById], references: [id], onDelete: SetNull)
  sourceMessage    ChatMessage?         @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  auditEntries     ApprovalAuditEntry[]
  comments         ApprovalComment[]
  purchaseOrders   PurchaseOrder[]
  paymentSchedules PaymentSchedule[]    @relation("ApprovalPayments")

  @@index([workspaceId, status])
  @@index([workspaceId, sourceChannelId, status])
  @@index([status, dueAt])
  @@index([workspaceId, erpSyncStatus])
}

/// Policy matrix: thresholds, approvers, SLAs per request type.
model ApprovalPolicyRule {
  id             String   @id @default(uuid())
  workspaceId    String
  name           String
  requestType    String
  minAmountCents Int?
  maxAmountCents Int?
  costCenter     String?
  approverRole   String?
  approverUserId String?
  backupUserId   String?
  slaMinutes     Int      @default(1440)
  priority       Int      @default(10)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("ApprovalRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([workspaceId, active, requestType])
}

/// Tamper-evident approval trail (sha3-512 hash chain, per workspace).
model ApprovalAuditEntry {
  id          String   @id @default(uuid())
  workspaceId String
  approvalId  String
  actorId     String?
  actorName   String?
  action      String
  fromStatus  String?
  toStatus    String?
  details     Json     @default("{}")
  hash        String
  chainPrev   String?
  chainIndex  Int
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approval  ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actor     User?           @relation("ApprovalAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, chainIndex])
  @@index([approvalId, chainIndex])
}

/// Comment / request-info thread on an approval.
model ApprovalComment {
  id          String   @id @default(uuid())
  workspaceId String
  approvalId  String
  authorId    String
  authorName  String?
  body        String
  kind        String   @default("COMMENT")
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approval  ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  author    User?           @relation("ApprovalCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([approvalId])
}

/// Workspace-level approval config: ERP target and defaults.
model WorkspaceApprovalConfig {
  workspaceId             String   @id
  erpProvider             String   @default("MOCK")
  erpIntegrationId        String?
  autoRaiseThresholdCents Int?
  defaultSlaMinutes       Int      @default(1440)
  nudgeBeforeMinutes      Int      @default(120)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Mock ERP — purchase orders.
model PurchaseOrder {
  id            String    @id @default(uuid())
  workspaceId   String
  poNumber      String
  vendorName    String
  description   String?
  amountCents   Int
  currency      String    @default("USD")
  status        String    @default("DRAFT")
  approvalId    String?
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approval  ApprovalRequest?  @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  payments  PaymentSchedule[]
  requester User?             @relation("PORequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approver  User?             @relation("POApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

/// Mock ERP — scheduled payments (downstream of approved invoices/POs/expenses).
model PaymentSchedule {
  id          String    @id @default(uuid())
  workspaceId String
  poId        String?
  invoiceId   String?
  approvalId  String?
  amountCents Int
  currency    String    @default("USD")
  status      String    @default("SCHEDULED")
  scheduledAt DateTime  @default(now())
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  po        PurchaseOrder?   @relation(fields: [poId], references: [id], onDelete: SetNull)
  approval  ApprovalRequest? @relation("ApprovalPayments", fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

/// N0VA TASKS — lists and tasks.
model TaskList {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  color       String   @default("default")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([workspaceId])
}

model Task {
  id              String    @id @default(uuid())
  listId          String
  workspaceId     String
  createdById     String?
  sourceChannelId String?
  title           String
  notes           String?
  dueDate         DateTime?
  completedAt     DateTime?
  assigneeId      String?
  priority        Priority  @default(MEDIUM)
  position        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  list TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([workspaceId, completedAt])
  @@index([listId, position])
  @@index([workspaceId, sourceChannelId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// N0VA DOCS - rich documents.
model Doc {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  title       String   @default("Untitled")
  content     String   @default("")
  version     Int      @default(1)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  revisions DocRevision[]
  comments  DocComment[]

  @@index([workspaceId, updatedAt(sort: Desc)])
}

model DocRevision {
  id          String   @id @default(uuid())
  docId       String
  workspaceId String
  content     String
  createdById String?
  createdAt   DateTime @default(now())

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt(sort: Desc)])
}

model DocComment {
  id          String   @id @default(uuid())
  docId       String
  workspaceId String
  createdById String
  authorName  String
  text        String
  createdAt   DateTime @default(now())

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
}

/// N0VA CHAT - channels and messages.
model ChatChannel {
  id             String          @id @default(uuid())
  workspaceId    String
  createdById    String?
  name           String
  topic          String          @default("")
  description    String          @default("")
  kind           ChatChannelKind @default(CHANNEL)
  isPrivate      Boolean         @default(false)
  classification String?
  retentionTier  String?
  pinnedAt       DateTime?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages              ChatMessage[]
  members               ChatMember[]
  pins                  ChatPin[]
  bookmarks             ChatBookmark[]
  chatPolls             ChatPoll[]             @relation("ChatPollChannel")
  reminders             Reminder[]             @relation("ReminderChannel")
  chatLinks             ContactChatLink[]
  liveEmbeds            LiveEmbed[]
  presentationSessions  PresentationSession[]
  threadMetadata        ThreadMetadata[]
  conversationMonitors  ConversationMonitor[]
  sentimentRecords      SentimentRecord[]
  toxicityFlags         ToxicityFlag[]
  conflictAlerts        ConflictAlert[]
  engagementSnapshots   EngagementSnapshot[]
  smartReplySuggestions SmartReplySuggestion[]
  conversationInsights  ConversationInsight[]

  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([workspaceId, kind])
}

model ChatMessage {
  id           String    @id @default(uuid())
  channelId    String
  workspaceId  String
  createdById  String
  authorName   String
  authorAvatar String?
  body         String
  bodyHtml     String?
  lang         String?
  reactions    Json      @default("[]")
  parentId     String?
  editedAt     DateTime?
  pinnedAt     DateTime?
  deletedAt    DateTime?
  ttlSeconds   Int?
  expiresAt    DateTime?
  viewedBy     Json      @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  channel               ChatChannel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent                ChatMessage?           @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies               ChatMessage[]          @relation("ThreadReplies")
  edits                 ChatMessageEdit[]
  attachments           ChatAttachment[]
  pins                  ChatPin[]
  bookmarks             ChatBookmark[]
  conversationMonitors  ConversationMonitor[]
  sentimentRecords      SentimentRecord[]
  toxicityFlags         ToxicityFlag[]
  smartReplySuggestions SmartReplySuggestion[]
  approvalRequests      ApprovalRequest[]
  deliveries            ChatMessageDelivery[]
  poll                  ChatPoll?              @relation("ChatPollMessage", fields: [pollId], references: [id], onDelete: SetNull)
  pollId                String?                @unique

  @@index([channelId, createdAt(sort: Desc)])
  @@index([parentId])
  @@index([channelId, pinnedAt])
}

model ChatMember {
  id         String         @id @default(uuid())
  channelId  String
  userId     String
  lastReadAt DateTime?
  role       ChatMemberRole @default(MEMBER)
  mutedUntil DateTime?
  createdAt  DateTime       @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model ChatMessageEdit {
  id        String   @id @default(uuid())
  messageId String
  oldBody   String
  newBody   String
  editedAt  DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt(sort: Desc)])
}

model ChatAttachment {
  id           String   @id @default(uuid())
  messageId    String
  workspaceId  String
  filename     String
  mimeType     String
  sizeBytes    Int      @default(0)
  storageKey   String
  thumbnailKey String?
  checksum     String?
  createdAt    DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatPin {
  id         String   @id @default(uuid())
  messageId  String
  channelId  String
  pinnedById String
  createdAt  DateTime @default(now())

  message  ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel  ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinnedBy User        @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([messageId])
  @@index([channelId])
}

model ChatSearchIndex {
  id           String   @id @default(uuid())
  messageId    String   @unique
  channelId    String
  workspaceId  String
  authorName   String
  body         String
  searchVector String   @default("")
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([workspaceId])
}

/// Saved search queries per user per workspace.
model ChatSavedSearch {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  name        String
  query       String
  filters     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([userId, updatedAt(sort: Desc)])
}

/// Personal bookmarks on chat messages.
model ChatBookmark {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  messageId   String
  channelId   String
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([workspaceId, userId])
  @@index([channelId])
}

/// Poll attached to a chat message (slash /poll).
model ChatPoll {
  id          String     @id @default(uuid())
  workspaceId String
  channelId   String
  question    String
  options     Json       @default("[]") // [{ text }]
  createdById String
  status      PollStatus @default(OPEN)
  expiresAt   DateTime?
  closedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace      @relation("ChatPollWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   ChatChannel    @relation("ChatPollChannel", fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User           @relation("ChatPollCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  message   ChatMessage?   @relation("ChatPollMessage")
  messageId String?        @unique
  votes     ChatPollVote[]

  @@index([workspaceId, channelId, createdAt(sort: Desc)])
}

/// One user vote per poll.
model ChatPollVote {
  id          String   @id @default(uuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  poll ChatPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
}

/// Personal reminders created from chat (slash /remind).
model Reminder {
  id              String         @id @default(uuid())
  workspaceId     String
  userId          String
  text            String
  remindAt        DateTime
  channelId       String?
  sourceMessageId String?
  targetUserId    String?
  status          ReminderStatus @default(PENDING)
  firedAt         DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())

  workspace Workspace    @relation("ReminderWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User         @relation("ReminderOwner", fields: [userId], references: [id], onDelete: Cascade)
  channel   ChatChannel? @relation("ReminderChannel", fields: [channelId], references: [id], onDelete: SetNull)

  @@index([userId, status, remindAt])
  @@index([workspaceId, status])
}

enum PollStatus {
  OPEN
  CLOSED
}

enum ReminderStatus {
  PENDING
  FIRED
  CANCELLED
}

enum ChatChannelKind {
  CHANNEL
  DM
  ANNOUNCEMENT
}

enum ChatArtifactType {
  MESSAGE
  FILE
  EXPORT
  AI_ARTIFACT
}

enum ChatRetentionTier {
  STANDARD
  EXTENDED
  COMPLIANCE
  GOVERNANCE
  BLOCKCHAIN
  LEGAL_HOLD
}

enum ChatGovernanceRole {
  COMPLIANCE_OFFICER
  SECURITY_ADMIN
  LEGAL_ADMIN
  AUDITOR
  GUEST
}

enum ChatApprovalAction {
  LOWER_RETENTION
  REMOVE_LEGAL_HOLD
  EXPORT_CONFIDENTIAL
  DISABLE_WATERMARK
  GRANT_TENANT_ACCESS
}

enum ChatApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChatKeyPurpose {
  PRODUCTION
  BACKUP
  LEGAL_HOLD_VAULT
}

/// Policy + enforcement state for a governed chat object (message, file, export, AI artifact).
model ChatComplianceRecord {
  id                   String            @id @default(uuid())
  workspaceId          String
  objectType           ChatArtifactType
  objectId             String
  classification       String            @default("")
  classificationSource String            @default("AUTO")
  retentionMode        ChatRetentionTier @default(STANDARD)
  retainUntil          DateTime?
  legalHold            Boolean           @default(false)
  legalHoldReason      String?
  watermarkEnabled     Boolean           @default(true)
  watermarkStyle       String            @default("DYNAMIC")
  watermarkViewerScope String            @default("USER_TIMESTAMP_VERSION")
  encAlgorithm         String            @default("AES-256-GCM")
  keySource            String            @default("HSM")
  keyVersion           String?
  algTag               String?
  pqReady              Boolean           @default(false)
  pqRequired           Boolean           @default(false)
  contentHash          String?
  chainPrev            String?
  chainIndex           Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([objectType, objectId])
  @@index([workspaceId, retentionMode])
  @@index([workspaceId, legalHold])
}

/// Configurable retention policy per artifact scope, anchored to creation or closure.
model ChatRetentionPolicy {
  id           String            @id @default(uuid())
  workspaceId  String
  name         String
  tier         ChatRetentionTier
  scope        ChatArtifactType
  durationDays Int?
  anchor       String            @default("CREATION")
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, tier, scope])
}

/// Tamper-evident audit trail with hash chain, stored separately from messages.
model ChatAuditLog {
  id            String   @id @default(uuid())
  workspaceId   String
  actorId       String
  actorName     String?
  action        String
  objectType    String?
  objectId      String?
  channelId     String?
  outcome       String   @default("SUCCESS")
  policyApplied String?
  ip            String?
  userAgent     String?
  details       Json     @default("{}")
  hash          String
  chainPrev     String?
  chainIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([objectId])
}

/// Indefinite protection until explicitly released.
model ChatLegalHold {
  id           String            @id @default(uuid())
  workspaceId  String
  scope        String
  objectType   ChatArtifactType?
  objectId     String?
  reason       String
  placedBy     String
  placedById   String
  placedAt     DateTime          @default(now())
  releasedBy   String?
  releasedById String?
  releasedAt   DateTime?
  active       Boolean           @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

/// Approval workflow for sensitive governance actions.
model ChatApproval {
  id            String             @id @default(uuid())
  workspaceId   String
  action        ChatApprovalAction
  objectId      String?
  objectType    ChatArtifactType?
  rationale     String
  requestedById String
  status        ChatApprovalStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime           @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?     @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

/// Governance role assignments beyond the built-in room roles.
model ChatGovernanceAssignment {
  id          String             @id @default(uuid())
  workspaceId String
  userId      String
  role        ChatGovernanceRole
  createdById String
  createdAt   DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

/// Per-workspace compliance settings.
model ChatComplianceConfig {
  workspaceId          String   @id
  watermarkEnabled     Boolean  @default(true)
  watermarkStyle       String   @default("DYNAMIC")
  watermarkViewerScope String   @default("USER_TIMESTAMP_VERSION")
  externalStronger     Boolean  @default(true)
  pqRequired           Boolean  @default(false)
  exportRedaction      Boolean  @default(true)
  derivedPropagation   Boolean  @default(true)
  keyRotationDays      Int      @default(180)
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Crypto-agile key envelope: data keys wrapped by a master key, never raw in app code.
model ChatKeyRecord {
  id               String         @id @default(uuid())
  workspaceId      String
  purpose          ChatKeyPurpose
  algorithm        String         @default("AES-256-GCM")
  keyVersion       Int            @default(1)
  wrappedKey       String
  iv               String
  tag              String
  masterKeyVersion Int            @default(1)
  pqReady          Boolean        @default(false)
  pqRequired       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  rotatedAt        DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, purpose])
}

/// Hyper-context envelope: links, actions, and causal chain for a chat message.
model ChatHyperContext {
  messageId   String   @id
  workspaceId String
  threadId    String?
  causalChain Json     @default("[]")
  links       Json     @default("[]")
  actions     Json     @default("[]")
  extractedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([threadId])
}

/// User-confirmable link suggestions with provenance and confidence.
model ChatLinkSuggestion {
  id          String   @id @default(uuid())
  workspaceId String
  messageId   String
  module      String
  objectId    String
  relation    String
  score       Float
  source      String   @default("AUTO")
  confidence  Float
  status      String   @default("SUGGESTED")
  reweight    Float?
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, messageId])
}

/// Auto-created task drafts derived from commitment intents.
model ChatTaskProposal {
  id             String    @id @default(uuid())
  workspaceId    String
  messageId      String
  title          String
  ownerUserId    String?
  dueDate        DateTime?
  priority       String    @default("MEDIUM")
  sourceQuote    String
  linkedEntities Json      @default("[]")
  status         String    @default("DRAFT")
  confidence     Float
  externalTaskId String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// Tentative events / scheduling suggestions from scheduling intent.
model ChatEventProposal {
  id              String    @id @default(uuid())
  workspaceId     String
  messageId       String
  title           String
  startsAt        DateTime?
  endsAt          DateTime?
  attendeeUserIds Json      @default("[]")
  agendaDraft     String    @default("")
  suggestedRoom   String?
  status          String    @default("SUGGESTED")
  linkedMeetingId String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// Approval-worthy items surfaced from chat (budget, purchase, release, legal, access).
model ChatApprovalRequest {
  id                   String    @id @default(uuid())
  workspaceId          String
  messageId            String
  requestType          String
  approverUserId       String?
  requiredEvidence     Json      @default("[]")
  linkedObjectIds      Json      @default("[]")
  rationale            String
  amount               Float?
  status               String    @default("DRAFT")
  deadline             DateTime?
  governanceApprovalId String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// Transactional outbox: message+event writes commit atomically with enqueued domain events.
model ChatOutboxEvent {
  id             String    @id @default(uuid())
  workspaceId    String
  messageId      String?
  actionType     String
  module         String
  payload        Json      @default("{}")
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  idempotencyKey String    @unique
  causeEventId   String?
  error          String?
  causalOrder    Int       @default(0)
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// Compensation log for failed saga steps.
model ChatCompensationLog {
  id            String   @id @default(uuid())
  workspaceId   String
  outboxEventId String?
  step          String
  reason        String
  compensatedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Rich-content preview cache (server-side OG + adapter metadata, TTL-aware)
model ChatUnfurlCache {
  id          String   @id @default(uuid())
  workspaceId String
  url         String
  kind        String // og | n0va_doc | n0va_sheet | n0va_task | n0va_meeting | n0va_crm | n0va_file | github | jira
  title       String?
  description String?
  imageUrl    String?
  siteName    String?
  structured  Json?    @default("{}")
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime
  etag        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, url])
  @@index([workspaceId, kind])
  @@index([expiresAt])
}

/// Hyper-context automation policy.
model ChatHyperConfig {
  workspaceId        String   @id
  autoCreateTasks    Boolean  @default(true)
  taskConfidence     Float    @default(0.85)
  autoCreateEvents   Boolean  @default(true)
  eventConfidence    Float    @default(0.85)
  autoRaiseApprovals Boolean  @default(false)
  approvalConfidence Float    @default(0.9)
  maxLinks           Int      @default(12)
  notifyOnAutoCreate Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA DELIVERY MATRIX — policy-driven reliability, retry, breaker, quota, DLQ
// ═══════════════════════════════════════════════════════════════════════════════

enum DeliverySemantic {
  AT_MOST_ONCE
  AT_LEAST_ONCE
  EFFECTIVELY_ONCE
  BOUNDED_LOSS
}

enum ChatDeliveryState {
  PENDING
  SENDING
  QUEUED
  DELAYED
  RETRIED
  PARTIALLY_DELIVERED
  FAILED
  CONFIRMED
  CANCELLED
}

enum ChatAttemptOutcome {
  SUCCESS
  TRANSIENT
  PERMANENT
  MALFORMED
  UNAUTHORIZED
  QUOTA_DEFERRED
  QUOTA_EXCEEDED
  BREAKER_OPEN
  DEDUPED
  TIMEOUT
  DLQ
  DEFERRED
}

enum ChatBreakerState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum ChatDLQStatus {
  QUARANTINED
  REQUEUED
  DROPPED
  RELEASED
}

/// Per-channel delivery policy (spec §12 data model).
model ChatDeliveryPolicy {
  id                      String           @id @default(uuid())
  workspaceId             String
  channelKind             String           @default("CHANNEL") // CHANNEL | DM | ANNOUNCEMENT | ALL
  target                  String           @default("chat") // chat | notifications | approvals | telemetry | media | voice | broker
  deliverySemantic        DeliverySemantic @default(AT_LEAST_ONCE)
  latencyTargetMs         Int              @default(5000)
  priority                Int              @default(0) // higher = more critical
  retryMaxAttempts        Int              @default(5)
  retryBackoff            String           @default("EXPONENTIAL_JITTER") // FIXED | LINEAR | EXPONENTIAL | EXPONENTIAL_JITTER
  retryMaxDurationSec     Int              @default(300)
  breakerEnabled          Boolean          @default(true)
  breakerFailureThreshold Float            @default(0.5)
  breakerWindowMs         Int              @default(60000)
  breakerCooldownSec      Int              @default(60)
  breakerHalfOpenProbes   Int              @default(1)
  quotaEnabled            Boolean          @default(true)
  quotaTenantDailyLimit   Int              @default(10000)
  quotaTenantHourlyLimit  Int              @default(2000)
  quotaBurstLimit         Int              @default(50)
  quotaBudgetCost         Int              @default(1)
  active                  Boolean          @default(true)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channelKind, target])
  @@index([workspaceId, active])
}

/// Per-message aggregate delivery tracking with user-visible states.
model ChatMessageDelivery {
  id             String              @id @default(uuid())
  workspaceId    String
  channelId      String
  messageId      String
  target         String              @default("chat")
  channelKind    String              @default("CHANNEL")
  state          ChatDeliveryState   @default(PENDING)
  payload        Json                @default("{}")
  attemptCount   Int                 @default(0)
  maxAttempts    Int                 @default(5)
  correlationId  String
  idempotencyKey String              @unique
  targetCount    Int                 @default(0)
  deliveredCount Int                 @default(0)
  lastOutcome    ChatAttemptOutcome?
  lastError      String?
  nextRetryAt    DateTime?
  enqueuedAt     DateTime            @default(now())
  firstAttemptAt DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  queueWaitMs    Int?
  totalLatencyMs Int?
  dedupHit       Boolean             @default(false)
  dlqId          String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  message   ChatMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attempts  ChatDeliveryAttempt[]
  dlq       ChatDeliveryDLQ?      @relation("MessageDeliveryDLQ", fields: [dlqId], references: [id], onDelete: SetNull)

  @@index([channelId, state])
  @@index([workspaceId, state, nextRetryAt])
}

/// Observability record per delivery attempt (spec §10).
model ChatDeliveryAttempt {
  id            String             @id @default(uuid())
  deliveryId    String
  workspaceId   String
  attempt       Int
  outcome       ChatAttemptOutcome
  reason        String?
  latencyMs     Int?
  breakerState  ChatBreakerState?
  quotaConsumed Int                @default(0)
  queueWaitMs   Int?
  retryAfterMs  Int?
  at            DateTime           @default(now())

  delivery  ChatMessageDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([deliveryId, attempt])
  @@index([workspaceId, at(sort: Desc)])
}

/// DB-backed circuit breaker per target/path (spec §3).
model ChatBreaker {
  id              String           @id @default(uuid())
  workspaceId     String
  target          String
  path            String           @default("write") // read | write
  state           ChatBreakerState @default(CLOSED)
  failures        Int              @default(0)
  total           Int              @default(0)
  windowStartedAt DateTime         @default(now())
  openedAt        DateTime?
  cooldownUntil   DateTime?
  halfOpenProbes  Int              @default(0)
  lastProbeAt     DateTime?
  lastError       String?
  updatedAt       DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, target, path])
  @@index([workspaceId])
}

/// DB-backed quota counters with lazy daily/hourly/burst windows (spec §4).
model ChatQuotaCounter {
  id          String   @id @default(uuid())
  workspaceId String
  scope       String // tenant | connector | channel
  scopeKey    String
  bucket      String // daily | hourly | burst
  windowStart DateTime @default(now())
  used        Int      @default(0)
  burstUsed   Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, scopeKey, bucket])
  @@index([workspaceId])
}

/// Dead-letter / holding queue with reason codes and replay (spec §8).
model ChatDeliveryDLQ {
  id            String        @id @default(uuid())
  workspaceId   String
  deliveryId    String?       @unique
  channelId     String?
  messageId     String?
  target        String        @default("chat")
  reasonCode    String // PERMANENT | MALFORMED | UNAUTHORIZED | QUOTA_EXCEEDED | BREAKER | POISON
  reason        String?
  attempts      Int           @default(0)
  payload       Json          @default("{}")
  status        ChatDLQStatus @default(QUARANTINED)
  quarantinedAt DateTime      @default(now())
  requeueAt     DateTime?
  requeuedAt    DateTime?
  resolvedAt    DateTime?
  lastError     String?

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  delivery  ChatMessageDelivery? @relation("MessageDeliveryDLQ")

  @@index([status])
  @@index([workspaceId, status])
  @@index([requeueAt])
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Personalization profile per user — notification rules, DND windows,
/// bookmarks/pins and preference telemetry (spec §1–§10).
model ChatPersonalizationProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  workspaceId          String
  prioritySort         String    @default("ACTIONABILITY_RECENCY") // ACTIONABILITY_RECENCY | RECENCY | PINNED_FIRST
  digestEnabled        Boolean   @default(false)
  workingHoursStart    Int       @default(540) // minutes from midnight, 09:00
  workingHoursEnd      Int       @default(1020) // 17:00
  workdays             String    @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\"]")
  timezone             String    @default("UTC")
  calendarAwareDnd     Boolean   @default(false)
  aiSuggestionsEnabled Boolean   @default(true)
  pauseUntil           DateTime? // global "pause notifications until <time>" override (non-emergency)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules       ChatNotificationRule[]
  dndWindows  ChatDndWindow[]
  pinnedItems ChatPinnedItem[]
  events      ChatPreferenceEvent[]
}

/// §1 — rule-based notification preferences (scope × value × mode).
model ChatNotificationRule {
  id          String    @id @default(uuid())
  profileId   String
  scope       String // room | sender | keyword | mention | thread | file | task | approval | channel | global
  value       String // room/sender id, keyword, or channel type (desktop|mobile|email|push)
  mode        String // ALWAYS | MENTIONS_ONLY | DIGEST | SILENT
  urgency     Int       @default(0) // 0..3 — 3 = crisis
  bypassDnd   Boolean   @default(false)
  snoozeUntil DateTime?
  source      String    @default("USER") // USER | SUGGESTED | PRESET
  reason      String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile ChatPersonalizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, active])
  @@index([scope, value])
}

/// §4/§5 — DND windows (one-off, recurring, workday, calendar, travel, weekend, meeting).
model ChatDndWindow {
  id              String    @id @default(uuid())
  profileId       String
  kind            String // ONE_OFF | RECURRING | WORKDAY | CALENDAR_BLOCK | TRAVEL | WEEKEND | MEETING
  days            String    @default("[]") // ["mon","tue",...]
  startMin        Int // minutes from midnight
  endMin          Int
  startDate       DateTime?
  endDate         DateTime?
  calendarEventId String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile ChatPersonalizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, active])
}

/// §3 — bookmarks and pins (personal recall + ranking signal). The legacy
/// ChatBookmark (message bookmarks) and ChatPin (room pins) remain; this model
/// covers unified pins across messages, threads, rooms, files, tasks and
/// approvals with pin-until and shared semantics.
model ChatPinnedItem {
  id               String    @id @default(uuid())
  profileId        String
  kind             String // MESSAGE | THREAD | ROOM | FILE | TASK | APPROVAL
  refId            String
  shared           Boolean   @default(false)
  pinned           Boolean   @default(false)
  pinUntil         DateTime?
  pinUntilResolved Boolean   @default(false) // keep until referenced item resolves (approval decided / task completed)
  note             String?
  position         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile ChatPersonalizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, refId])
  @@index([profileId, pinned])
}

/// §6 — team/workspace default rules (between user rules and org policy in the hierarchy).
model ChatWorkspaceDefaultRule {
  id          String   @id @default(uuid())
  workspaceId String
  scope       String // room | sender | keyword | mention | thread | file | task | approval | channel | global
  value       String // room/sender id, keyword, or channel type (desktop|mobile|email|push)
  mode        String // ALWAYS | MENTIONS_ONLY | DIGEST | SILENT
  urgency     Int      @default(0) // 0..3 — 3 = crisis
  bypassDnd   Boolean  @default(false)
  active      Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, scope, value])
  @@index([workspaceId, active])
}

/// §10 — preference telemetry (why-fired, suppression, acceptance, overrides).
model ChatPreferenceEvent {
  id          String   @id @default(uuid())
  profileId   String
  kind        String // NOTIFICATION | DND_OVERRIDE | PIN | DIGEST | RECOMMENDATION | CLICK
  action      String // DELIVERED | SUPPRESSED | DIGESTED | BYPASSED | ACCEPTED | REJECTED | ...
  messageId   String?
  roomId      String?
  channelType String?
  reason      String?
  createdAt   DateTime @default(now())

  profile ChatPersonalizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, kind])
}

// ── NEURAL — opt-in experimental research platform (§1–§14) ─────────────────
// Raw neural signals are never stored; only derived coarse states and explicit
// commands, under granular revocable consent with access logging.

/// §1/§11 — per-user tier + per-user calibration (personalized flow models).
model NeuralProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  workspaceId String
  tier        Int      @default(0) // 0..6 — capability tier, default 0 (no sensing)
  calibration String   @default("{}") // JSON: {corrections, samples, acceptedCorrections, withinPersonAccuracy, calibrationSessions}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// §4 — coarse user-controlled state sharing with audience + auto-expiry.
model NeuralSharing {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  state       String // available | focused | in_meeting | low_interruption_tolerance | open_to_collaboration | needs_recovery | uncertain
  audience    String // NOBODY | PEOPLE | ROOM | DELAYED_AGGREGATE
  personIds   String    @default("[]") // JSON
  roomId      String?
  precision   String    @default("COARSE")
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId, active])
  @@index([workspaceId, active])
}

/// §3/§8 — decoded command transcript: preview, confirm, execute, cancel.
model NeuralCommand {
  id          String   @id @default(uuid())
  sessionId   String?
  huddleId    String?
  userId      String
  workspaceId String
  kind        String // mute | join | bookmark | create_task | send | agree | clarify | pause | raise_hand
  decoded     String? // visible decoded text preview
  confidence  Float
  threshold   Float    @default(0.7)
  source      String // INFERENCE | EXPLICIT
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | EXECUTED | REJECTED
  detail      String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([huddleId])
}

/// §9 — access log for every neural-data operation.
model NeuralAccessLog {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  operation   String // read | infer | share | delete | command | consent | session | huddle
  target      String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

/// N0VA MAIL - messages, threads and labels.
model MailMessage {
  id              String        @id @default(uuid())
  workspaceId     String
  threadId        String
  direction       MailDirection @default(IN)
  folder          MailFolder    @default(INBOX)
  status          MailStatus    @default(SENT)
  fromName        String        @default("")
  fromEmail       String
  toEmails        Json
  ccEmails        Json          @default("[]")
  bccEmails       Json          @default("[]")
  subject         String        @default("(no subject)")
  body            String        @default("")
  bodyHtml        String?       @default("")
  isRead          Boolean       @default(false)
  isStarred       Boolean       @default(false)
  isForwarded     Boolean       @default(false)
  inReplyToId     String?
  signatureId     String?
  autoRespond     Boolean       @default(false)
  snoozeUntil     DateTime?
  scheduledAt     DateTime?
  sentAt          DateTime      @default(now())
  /// AI fields
  aiPriority      MailPriority  @default(MEDIUM)
  aiCategory      MailCategory  @default(WORK)
  aiSentiment     String        @default("neutral")
  aiSummary       String?       @default("")
  aiProcessed     Boolean       @default(false)
  /// Compliance fields
  legalHold       Boolean       @default(false)
  retentionReview Boolean       @default(false)
  mailboxId       String?
  /// Delivery tracking
  deliveryStatus  String?       @default("pending")
  deliveredAt     DateTime?
  deliveryError   String?
  accountId       String?
  createdAt       DateTime      @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  labels      MailLabelMap[]
  attachments MailAttachment[]
  comments    MailComment[]
  mailTasks   MailTask[]
  mailbox     Mailbox?         @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  account     EmailAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, folder, sentAt(sort: Desc)])
  @@index([workspaceId, threadId])
  @@index([workspaceId, status, scheduledAt])
  @@index([workspaceId, snoozeUntil])
  @@index([workspaceId, aiPriority])
  @@index([workspaceId, aiCategory])
  @@index([workspaceId, legalHold])
  @@index([workspaceId, mailboxId])
}

enum MailStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

enum MailPriority {
  HIGH
  MEDIUM
  LOW
}

enum MailCategory {
  PERSONAL
  WORK
  NEWSLETTER
  NOTIFICATION
  PROMOTIONAL
  SPAM
}

model MailLabel {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#7c5cfc")
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  MailLabelMap[]
}

model MailLabelMap {
  id          String @id @default(uuid())
  messageId   String
  labelId     String
  workspaceId String

  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  label   MailLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([messageId, labelId])
}

enum MailDirection {
  IN
  OUT
}

enum MailFolder {
  INBOX
  SENT
  ARCHIVE
  TRASH
}

/// N0VA MAIL — thread-level conversation aggregate (denormalized for fast list rendering).
model MailThread {
  id           String     @id @default(uuid())
  workspaceId  String
  threadId     String
  folder       MailFolder @default(INBOX)
  subject      String     @default("(no subject)")
  isRead       Boolean    @default(false)
  isStarred    Boolean    @default(false)
  unreadCount  Int        @default(0)
  messageCount Int        @default(0)
  participants Json       @default("[]")
  latestSentAt DateTime   @default(now())
  latestMsgId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, threadId])
  @@index([workspaceId, folder, latestSentAt(sort: Desc)])
  @@index([workspaceId, isRead, unreadCount])
}

/// N0VA MAIL — saved draft messages.
model MailDraft {
  id          String          @id @default(uuid())
  workspaceId String
  createdById String?
  subject     String          @default("(no subject)")
  toEmails    String[]        @default([])
  ccEmails    String[]        @default([])
  body        String          @default("")
  status      MailDraftStatus @default(DRAFT)
  threadId    String?
  scheduledAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailDrafts", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt(sort: Desc)])
}

enum MailDraftStatus {
  DRAFT
  SCHEDULED
  SENDING
}

/// N0VA MAIL — automation rules for auto-label, auto-archive, forward, webhook.
model MailRule {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  description String    @default("")
  enabled     Boolean   @default(true)
  priority    Int       @default(100)
  /// Array of condition clauses, each { field, operator, value(s), not?: boolean }
  conditions  Json      @default("[]")
  /// Array of action objects, each { type, ...params }
  actions     Json      @default("[]")
  lastRunAt   DateTime?
  runCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailRules", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, priority, enabled])
  @@index([workspaceId, createdAt(sort: Desc)])
}

/// N0VA MAIL — attachment references (metadata in DB, blobs in object storage).
model MailAttachment {
  id          String   @id @default(uuid())
  workspaceId String
  messageId   String
  filename    String
  mimeType    String
  sizeBytes   Int      @default(0)
  storageKey  String
  checksum    String?
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// N0VA MAIL — custom domain configuration for inbound/outbound routing.
model MailDomain {
  id              String    @id @default(uuid())
  workspaceId     String
  createdById     String?
  domain          String
  /// DNS / Auth
  dkimKey         String?
  spfRecord       String?
  dmarcPolicy     String?
  mtaSts          String?
  tlsRpt          String?
  bimiUrl         String?
  mxRecords       Json      @default("[]")
  /// Privacy
  privacyEnabled  Boolean   @default(true)
  registrar       String    @default("")
  whoisProxy      Boolean   @default(true)
  /// Routing
  catchAllEnabled Boolean   @default(true)
  catchAllTarget  String    @default("")
  /// Status
  verified        Boolean   @default(false)
  healthStatus    String    @default("unknown")
  lastChecked     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?        @relation("createdMailDomains", fields: [createdById], references: [id], onDelete: SetNull)
  dnsRecords DnsRecord[]
  aliases    EmailAlias[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, verified])
}

/// N0VA MAIL — individual DNS records for domain configuration.
model DnsRecord {
  id         String   @id @default(uuid())
  domainId   String
  type       String
  name       String
  value      String
  priority   Int      @default(0)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  domain MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, type])
}

/// N0VA MAIL — email aliases for catch-all and explicit routing.
model EmailAlias {
  id          String   @id @default(uuid())
  domainId    String
  workspaceId String
  createdById String?
  localPart   String
  description String   @default("")
  forwardTo   String
  isActive    Boolean  @default(true)
  isWildcard  Boolean  @default(false)
  spamFilter  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain    MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("createdEmailAliases", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([domainId, localPart])
  @@index([workspaceId, isActive])
  @@index([forwardTo])
}

/// N0VA MAIL — reverse aliases for outbound replies.
model ReverseAlias {
  id           String   @id @default(uuid())
  aliasId      String
  workspaceId  String
  relayAddress String
  targetEmail  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([relayAddress])
  @@index([workspaceId, aliasId])
}

/// N0VA MAIL — data breach events detected for aliases.
model BreachEvent {
  id          String   @id @default(uuid())
  workspaceId String
  aliasEmail  String
  source      String
  severity    String   @default("medium")
  details     String   @default("")
  detectedAt  DateTime @default(now())
  isResolved  Boolean  @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, detectedAt(sort: Desc)])
  @@index([workspaceId, severity])
}

/// N0VA MAIL — contact / address book entries per workspace.
model MailContact {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  firstName   String   @default("")
  lastName    String   @default("")
  email       String
  phone       String   @default("")
  company     String   @default("")
  jobTitle    String   @default("")
  notes       String   @default("")
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailContacts", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, lastName, firstName])
  @@index([workspaceId, isFavorite])
}

/// N0VA MAIL — custom signatures for outgoing mail.
model MailSignature {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  content     String   @default("")
  contentHtml String?  @default("")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailSignatures", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, isDefault])
}

/// N0VA MAIL — auto-responder / out-of-office configuration.
model MailAutoResponder {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  enabled     Boolean   @default(false)
  subject     String    @default("Out of Office")
  body        String    @default("I am currently out of office.")
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailAutoResponders", fields: [createdById], references: [id], onDelete: SetNull)
}

/// N0VA MAIL — user-created nested folders.
model MailUserFolder {
  id             String   @id @default(uuid())
  workspaceId    String
  createdById    String?
  name           String
  parentFolderId String?
  color          String   @default("#7c5cfc")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("createdMailUserFolders", fields: [createdById], references: [id], onDelete: SetNull)
  parentFolder MailUserFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders MailUserFolder[] @relation("FolderHierarchy")

  @@unique([workspaceId, parentFolderId, name])
  @@index([workspaceId, parentFolderId])
}

/// N0VA MAIL — shared mailboxes (e.g., support@, info@, sales@).
model Mailbox {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  email       String
  description String   @default("")
  isActive    Boolean  @default(true)
  autoAssign  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("createdMailboxes", fields: [createdById], references: [id], onDelete: SetNull)
  members   MailboxMember[]
  messages  MailMessage[]

  @@unique([workspaceId, email])
  @@index([workspaceId, isActive])
}

/// N0VA MAIL — shared mailbox members and roles.
model MailboxMember {
  id        String      @id @default(uuid())
  mailboxId String
  userId    String
  role      MailboxRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, userId])
  @@index([userId])
}

enum MailboxRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// N0VA MAIL — internal comments on email threads (private notes).
model MailComment {
  id          String   @id @default(uuid())
  workspaceId String
  messageId   String
  authorId    String
  body        String
  isResolve   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([workspaceId, authorId])
}

/// N0VA MAIL — email delegation (send on behalf of another user).
model MailDelegation {
  id          String    @id @default(uuid())
  workspaceId String
  delegatorId String
  delegateId  String
  canSend     Boolean   @default(true)
  canRead     Boolean   @default(true)
  canDelete   Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  delegator User      @relation("delegationOwner", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegate  User      @relation("delegationDelegate", fields: [delegateId], references: [id], onDelete: Cascade)

  @@unique([delegatorId, delegateId])
  @@index([workspaceId, delegatorId])
  @@index([workspaceId, delegateId])
}

/// N0VA MAIL — email-to-task conversion (Kanban pipeline).
model MailTask {
  id          String       @id @default(uuid())
  workspaceId String
  messageId   String
  createdById String?
  assigneeId  String?
  title       String
  description String       @default("")
  status      TaskStatus   @default(TODO)
  priority    MailPriority @default(MEDIUM)
  dueDate     DateTime?
  listId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("createdMailTasks", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  User?       @relation("assignedMailTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, priority])
  @@index([workspaceId, assigneeId])
  @@index([messageId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

/// N0VA MAIL — shared drafts (co-authoring).
model MailSharedDraft {
  id          String   @id @default(uuid())
  workspaceId String
  messageId   String?
  createdById String
  subject     String   @default("")
  body        String   @default("")
  bodyHtml    String?  @default("")
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User                          @relation("createdSharedDrafts", fields: [createdById], references: [id], onDelete: Cascade)
  collaborators MailSharedDraftCollaborator[]

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/// N0VA MAIL — shared draft collaborators.
model MailSharedDraftCollaborator {
  id            String    @id @default(uuid())
  sharedDraftId String
  userId        String
  role          String    @default("editor")
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())

  sharedDraft MailSharedDraft @relation(fields: [sharedDraftId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharedDraftId, userId])
}

/// N0VA MAIL — server-side routing rules for tiered inbox filtering.
model MailRoutingRule {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  description String   @default("")
  tier        MailTier @default(TIER2)
  /// Condition: "to_contains", "to_equals", "from_contains", "subject_contains", "domain_matches"
  condition   String
  /// Value to match against (e.g., "@banking.com", "newsletter")
  matchValue  String
  /// Action: "tag", "folder", "priority", "block", "forward", "auto_delete"
  action      String
  actionValue String   @default("")
  isActive    Boolean  @default(true)
  priority    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdRoutingRules", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, tier, isActive])
  @@index([workspaceId, priority])
}

enum MailTier {
  TIER1
  TIER2
  TIER3
}

/// N0VA MAIL — master inbox security settings.
model MailInboxSecurity {
  id                String    @id @default(uuid())
  workspaceId       String
  masterEmail       String    @default("")
  provider          String    @default("")
  mfaEnabled        Boolean   @default(false)
  mfaType           String    @default("totp")
  hardwareKey       Boolean   @default(false)
  passphraseHint    String    @default("")
  recoveryEmail     String    @default("")
  lastSecurityCheck DateTime?
  securityScore     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
}

/// N0VA MAIL — security events (breaches, spam, auth alerts).
model MailSecurityEvent {
  id          String    @id @default(uuid())
  workspaceId String
  type        String
  severity    String    @default("medium")
  source      String    @default("")
  aliasEmail  String    @default("")
  details     String    @default("")
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  isResolved  Boolean   @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, detectedAt(sort: Desc)])
  @@index([workspaceId, type, severity])
}

/// N0VA MAIL — Email Accounts (SMTP/IMAP configuration)
model EmailAccount {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  smtpConfig  Json?
  imapConfig  Json?
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  MailMessage[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, isDefault])
}

/// N0VA MAIL — eDiscovery: Legal Holds
model MailLegalHold {
  id                   String    @id @default(uuid())
  workspaceId          String
  name                 String
