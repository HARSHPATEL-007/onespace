  @@index([workspaceId, status])
  @@index([workspaceId, interfaceId])
}

/// Topic-based subscription with delivery/backlog/ordering/expiry monitoring.
model InteropSubscription {
  id             String    @id @default(uuid())
  workspaceId    String
  interfaceId    String?
  topic          String
  criteria       String?
  channel        String    @default("rest-hook") // rest-hook | websocket | polling
  endpoint       String?
  status         String    @default("active") // active | suspended | endpoint_unreachable | auth_failed | backlog_growing | rejected | expired | revoked | dead_lettered
  lastDeliveryAt DateTime?
  backlog        Int       @default(0)
  failureState   String?
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, topic])
}

/// Interface incident — viewer outage = operational incident; missing study affecting care = clinical work item.
model InteropIncident {
  id               String   @id @default(uuid())
  workspaceId      String
  kind             String // validation_failure | patient_match_degradation | missing_results | dicom_failure | viewer_outage | terminology_outage | subscription_backlog | bulk_corruption | duplicate_delivery | data_leakage | rate_limit_saturation | certificate_expiry | conformance_regression
