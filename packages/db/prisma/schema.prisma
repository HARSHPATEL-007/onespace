// N0VA SEARCH — Hybrid Retrieval System (Lexical + Semantic + Neural)
// ═══════════════════════════════════════════════════════════════════════════════

/// Unified search index for all workspace content.
model SearchIndex {
  id              String   @id @default(uuid())
  workspaceId     String
  contentType     SearchContentType
  contentId       String
  title           String
  body            String
  excerpt         String   @default("")
  embedding       String   @default("")
  embeddingModel  String   @default("n0va-embed-v3")
  lexicalVector   String   @default("")
  entities        Json     @default("[]")
  metadata        Json     @default("{}")
  permissions     Json     @default("{}")
  indexedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, contentType, contentId])
  @@index([workspaceId, contentType])
  @@index([workspaceId, indexedAt(sort: Desc)])
