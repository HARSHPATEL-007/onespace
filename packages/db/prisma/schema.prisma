/// N0VA BOOKLM+EDUCATION Epistemics — every generated output carries one of
/// five epistemic states, stored as metadata (never mere wording).
enum EpistemicState {
  SOURCE_FACT
  SOURCE_SYNTHESIS
  MODEL_INFERENCE
  SPECULATION
  LEARNER_CONTRIBUTION
}

/// Learner-friendly verification labels for claim↔evidence entailment.
enum VerificationLabel {
  DIRECTLY_SUPPORTED
  QUALIFIED_SUPPORT
  SYNTHESIZED
  REASONED_INFERENCE
  UNCERTAIN
  CONFLICTING
  NOT_FOUND
  REQUIRES_REVIEW
}

/// Canonical evidence span types.
enum EvidenceType {
  DEFINITION
  OBSERVATION
  STATISTIC
  PROCEDURE
  OPINION
  CLAIM
  EXAMPLE
}

/// Claim-graph edge vocabulary (claim↔claim and claim↔evidence).
enum ClaimRelation {
  SUPPORTS
  PARTIALLY_SUPPORTS
  CONTRADICTS
  QUALIFIES
  DEFINES
  EXAMPLES
  EXTENDS
  DEPENDS_ON
  SUPERSEDES
  DERIVED_FROM
  LEARNER_PROPOSED
  REQUIRES_VERIFICATION
}

/// Hallucination-resistant answer modes.
enum AnswerMode {
  STRICT
  GUIDED
  EXPLORATORY
  EXAM
}

/// Evidence challenge taxonomy (learner/instructor disputes).
enum ChallengeCategory {
  NOT_SUPPORTED
  CORRELATION_NOT_CAUSATION
  LOST_QUALIFIER
  WRONG_DOMAIN
  EXTRACTION_ERROR
  OUTDATED_SOURCE
  OTHER
}

/// Claim-level evidence graph: which sources support / contradict / qualify an answer.
model EvidenceCitation {
  id               String          @id @default(uuid())
  workspaceId      String
  setId            String?
  itemId           String?
  claim            String
  quote            String          @default("")
  sourceKind       LearningKind    @default(NOTE)
  sourceTitle      String          @default("")
  sourceDocId      String?
  locatorPage      Int?
  locatorParagraph Int?
  locatorTimestamp String          @default("")
  sourceVersion    String          @default("")
  authority        Int             @default(50)
  freshnessAt      DateTime?
  support          EvidenceSupport @default(SUPPORTS)
  confidence       Float           @default(0.5)
  provenance       String          @default("")
  createdById      String?
  createdAt        DateTime        @default(now())

  // Epistemics: canonical evidence object (all nullable/defaulted — backward compatible)
  contentHash           String           @default("")
  locatorHeading        String           @default("")
  lineStart             Int?
  lineEnd               Int?
  evidenceType          EvidenceType     @default(CLAIM)
  sourceType            String           @default("note")
  extractionConfidence  Float            @default(0.5)
  freshnessScore        Float?
  sourceDate            DateTime?
  epistemicState        EpistemicState    @default(SOURCE_FACT)
  verificationLabel     VerificationLabel @default(DIRECTLY_SUPPORTED)
  accessScope           String           @default("course-private")
  language              String           @default("")
  license               String           @default("")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  set       LearningSet?  @relation(fields: [setId], references: [id], onDelete: Cascade)
  item      LearningItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  challenges EvidenceChallenge[]

  @@index([workspaceId, setId])
  @@index([workspaceId, itemId])
  @@index([workspaceId, sourceDocId])
}

/// Atomic claim nodes: every grounded answer is decomposed into atomic claims
/// before generation; coverage is measured at claim level.
model ClaimNode {
  id               String            @id @default(uuid())
  workspaceId      String
  setId            String?
  answerId         String?
  text             String
  normalizedKey    String            @default("")
  position         Int               @default(0)
  epistemicState   EpistemicState    @default(SOURCE_FACT)
  verificationLabel VerificationLabel @default(UNCERTAIN)
  confidence       Float             @default(0.5)
  weight           Float             @default(1.0)
  createdById      String?
  createdAt        DateTime          @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  set       LearningSet?   @relation(fields: [setId], references: [id], onDelete: Cascade)
  answer    AnswerRecord?  @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, answerId])
  @@index([workspaceId, setId])
}

/// Claim-graph edges: claim↔claim and claim↔evidence. Endpoints are
/// polymorphic (fromType/fromId, toType/toId with types CLAIM | EVIDENCE)
/// so one vocabulary covers derivation, support, and contradiction paths.
model ClaimEdge {
  id              String        @id @default(uuid())
  workspaceId     String
  setId           String?
  answerId        String?
  fromType        String        @default("CLAIM")
  fromId          String
  toType          String        @default("EVIDENCE")
  toId            String
  relation        ClaimRelation @default(SUPPORTS)
  strength        Float         @default(0.5)
  confidence      Float         @default(0.5)
  direction       String        @default("forward")
  evidenceSpan    String        @default("")
  modelVersion    String        @default("")
  validatedStatus String        @default("UNREVIEWED")
  validatedById   String?
  createdAt       DateTime      @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  answer    AnswerRecord? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, answerId])
  @@index([workspaceId, fromId])
  @@index([workspaceId, toId])
}

/// Instructor governance console: source authority policy per course (set).
model SourcePolicy {
  id                    String   @id @default(uuid())
  workspaceId           String
  setId                 String
  approvedSources       String[] @default([])
  restrictedSources     String[] @default([])
  requireTwoSources     Boolean  @default(false)
  requireCurrentVersion Boolean  @default(false)
  requireHumanReview    Boolean  @default(false)
  examMode              Boolean  @default(false)
  examExternalSources   Boolean  @default(false)
  allowedInferenceLevel String   @default("marked")
  minCoverage           Float    @default(0.5)
  minIndependentSources Int      @default(1)
  retrievalWeights      Json?
  freshnessLambda       Json?
  updatedById           String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, setId])
}

/// Learner/instructor evidence challenges: dispute a citation with reason.
model EvidenceChallenge {
  id          String            @id @default(uuid())
  workspaceId String
  evidenceId  String
  setId       String?
  category    ChallengeCategory @default(OTHER)
  reason      String
  learnerNote String            @default("")
  status      AppealStatus      @default(OPEN)
  userId      String
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence  EvidenceCitation  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, evidenceId])
  @@index([workspaceId, status])
}

/// Auditable grounded answers: question, mode, query type, multi-dimensional
/// evidence-quality scores, source versions used, model/retrieval versions.
model AnswerRecord {
  id              String     @id @default(uuid())
  workspaceId     String
  setId           String?
  question        String
  mode            AnswerMode @default(GUIDED)
  queryType       String     @default("general")
  answer          String     @default("")
  scores          Json?
  versionsUsed    Json?
  modelVersion    String     @default("")
  retrievalVersion String    @default("")
  refused         Boolean    @default(false)
  createdById     String?
  createdAt       DateTime   @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  claims    ClaimNode[]
  edges     ClaimEdge[]

  @@index([workspaceId, setId])
}

/// N0VA BOOKLM+EDUCATION Personal Graph — learner model, memory, adaptive planning.
enum MasteryStatus {
  UNKNOWN
  EXPOSED
  RECOGNIZED
  EMERGING
  PRACTICED
  RELIABLE
  TRANSFER_CAPABLE
  DURABLE
  INDEPENDENT
  MENTOR_CAPABLE
  DECAYING
  CONTESTED
  MISAPPLIED
  SUPERSEDED
}

enum ConceptDependencyRel {
  PREREQUISITE_OF
  PART_OF
  GENERALIZES
  SPECIALIZES
  ANALOGOUS_TO
  CONTRASTS_WITH
  COMMONLY_CONFUSED_WITH
  ENABLES
  APPLIED_IN
  ASSESSED_BY
  EXPLAINED_BY
  SUPERSEDED_BY
  REQUIRES_SKILL
  REQUIRES_CONTEXT
}

enum DependencyKind {
  HARD
  SOFT
  HIDDEN
  LOCAL
  TRANSFER
  REMEDIAL
}

enum MisconceptionStatus {
  CANDIDATE
  EVIDENCE_GATHERING
  TESTING
  CLARIFICATION
  CONFIRMED
  DISMISSED
  REMEDIATION
  REASSESSED
  RESOLVED
  DORMANT
  PERSISTENT
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  DISMISSED
  EXPIRED
}

/// Learner-specific knowledge graph nodes.
model LearnerConcept {
  id          String             @id @default(uuid())
  workspaceId String
  setId       String?
  key         String
  label       String
  kind        LearnerConceptKind @default(CONCEPT)
  description String             @default("")
  createdAt   DateTime           @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  set       LearningSet?     @relation(fields: [setId], references: [id], onDelete: Cascade)
  edgesFrom ConceptEdge[]    @relation("ConceptFrom")
  edgesTo   ConceptEdge[]    @relation("ConceptTo")
  mastery   LearnerMastery[]
  misconceptions Misconception[]
  observations   MasteryObservation[]
  depsFrom       ConceptDependency[] @relation("DepFrom")
  depsTo         ConceptDependency[] @relation("DepTo")

  @@unique([workspaceId, setId, key])
  @@index([workspaceId, setId])
}

model ConceptEdge {
  id          String          @id @default(uuid())
  workspaceId String
  fromId      String
  toId        String
  relation    ConceptRelation @default(RELATED)
  weight      Float           @default(1.0)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from      LearnerConcept @relation("ConceptFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        LearnerConcept @relation("ConceptTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Per-learner mastery with decay + spaced repetition scheduling.
/// `mastery` is the aggregate; `dimensions` holds the 10 separate dimensions
/// (recognition, recall, conceptual, procedural, application, transfer,
/// analysis, creation, metacognition, collaboration) with estimate intervals.
model LearnerMastery {
  id                String   @id @default(uuid())
  workspaceId       String
  conceptId         String
  userId            String
  mastery           Float    @default(0)
  confidence        Float    @default(0.5)
  evidenceCount     Int      @default(0)
  misconceptionFlag Boolean  @default(false)
  easeFactor        Float    @default(2.5)
  intervalDays      Float    @default(1)
  decayRate         Float    @default(0.05)
  lastSeenAt        DateTime @default(now())
  nextReviewAt      DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Personal graph: dimensions, state machine, transfer, verification
  dimensions       Json?
  dimensionRanges  Json?
  status           MasteryStatus @default(UNKNOWN)
  stateEvidence    String        @default("")
  lastVerifiedAt   DateTime?
  transferContexts Json?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  concept   LearnerConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, conceptId, userId])
  @@index([workspaceId, userId, nextReviewAt])
  @@index([workspaceId, userId, status])
}

/// N0VA BOOKLM+EDUCATION Adaptive Loop — closed-loop pedagogical control.
enum OverrideKind {
  SET_LEVEL
  LOCK_DIFFICULTY
  ASSIGN_REPAIR_PATH
  EXEMPT_CONCEPT
  FORCE_MODALITY
  CUSTOM_MISCONCEPTION_RULE
  MARK_VERIFIED
  PAUSE_PERSONALIZATION
  RESTORE_STATE
}

enum OverrideScope {
  CONCEPT
  COURSE
  PROFILE
  GLOBAL
}

/// Closed-loop adaptive learning: observe → diagnose → intervene → measure.
/// Every loop records state before/after, evidence, strategy, alternatives,
/// response, estimated gain, overrides, and model/policy/curriculum versions.
model AdaptiveLoop {
  id               String   @id @default(uuid())
  workspaceId      String
  setId            String?
  conceptId        String?
  userId           String
  stateBefore      Json?
  evidence         String[] @default([])
  strategy         String   @default("")
  alternatives     String[] @default([])
  contentRef       String   @default("")
  difficulty       Json?
  response         Json?
  learningGain     Float?
  gainConfidence   Float    @default(0.5)
  overriddenById   String?
  overrideReason   String   @default("")
  modelVersion     String   @default("")
  policyVersion    String   @default("")
  curriculumVersion String  @default("")
  createdAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, conceptId])
  @@index([workspaceId, setId])
}

/// Per-learner per-concept difficulty state: ladder level 0-9 plus the
/// 13 difficulty dimensions, so one dimension moves without flattening all.
model DifficultyState {
  id          String   @id @default(uuid())
  workspaceId String
  conceptId   String
  userId      String
  level       Int      @default(1)
  dims        Json?
  targetBand  Float    @default(0.75)
  eta         Float    @default(0.4)
  mu          Float    @default(0.3)
  nu          Float    @default(0.2)
  locked      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, conceptId, userId])
  @@index([workspaceId, userId])
}

/// Item-level retrieval memory state (stability/retrievability scheduler).
model RetrievalItem {
  id            String    @id @default(uuid())
  workspaceId   String
  setId         String?
  conceptId     String
  userId        String
  itemKey       String
  stabilityDays Float     @default(1)
  retrievability Float    @default(0.5)
  difficulty    Float     @default(0.5)
  lastAttempt   DateTime?
  nextDue       DateTime  @default(now())
  contextCount  Int       @default(0)
  transferCount Int       @default(0)
  scheduleType  String    @default("expanding")
  format        String    @default("recall")
  successes     Int       @default(0)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, conceptId, userId, itemKey])
  @@index([workspaceId, userId, nextDue])
}

/// Instructor-configured adaptive policy per course (set).
model AdaptivePolicy {
  id                  String   @id @default(uuid())
  workspaceId         String
  setId               String
  difficultyMin       Int      @default(0)
  difficultyMax       Int      @default(9)
  prereqThreshold     Float    @default(0.4)
  hintLimit           Int      @default(3)
  masteryDefinition   Json?
  transferRequired    Boolean  @default(true)
  minIntervalHours    Int      @default(12)
  interleaving        Json?
  accommodations      Json?
  escalationThreshold Int      @default(3)
  externalAllowed     Boolean  @default(true)
  weights             Json?
  highStakesReview    Boolean  @default(false)
  version             Int      @default(1)
  updatedById         String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, setId])
}

/// Instructor overrides with reason, author, timestamp, scope, expiration.
model InstructorOverride {
  id         String        @id @default(uuid())
  workspaceId String
  setId      String?
  targetType String
  targetId   String
  kind       OverrideKind
  payload    Json?
  reason     String
  authorId   String
  scope      OverrideScope @default(CONCEPT)
  expiresAt  DateTime?
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, targetId, active])
}

/// Transparent session plans: generated, learner-modifiable, accepted.
model SessionPlan {
  id           String   @id @default(uuid())
  workspaceId  String
  setId        String?
  userId       String
  plan         Json
  rationale    String[] @default([])
  accepted     Boolean  @default(false)
  modification String   @default("")
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
}

/// Modality effectiveness per learner×concept (never a fixed trait).
model ModalityEffect {
  id        String   @id @default(uuid())
  workspaceId String
  conceptId String?
  userId    String
  modality  String
  gainSum   Float    @default(0)
  trials    Int      @default(0)
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, conceptId, userId, modality])
  @@index([workspaceId, userId])
}

/// Learner-controlled profiles: academic, role, certification, project,
/// language, research, teaching, personal-interest, accessibility, intensive.
model LearnerProfile {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  name        String
  kind        String    @default("academic")
  goals       Json?
  priorities  Json?
  vocabulary  String    @default("")
  modalities  String[]  @default([])
  timeCapMin  Int?
  standards   String    @default("")
  sharing     Json?
  privacy     Json?
  isDefault   Boolean   @default(false)
  expiresAt   DateTime?
  preferences Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learnerGoals LearnerGoal[]

  @@index([workspaceId, userId])
}

/// Learner goals requiring competencies; owned by the learner.
model LearnerGoal {
  id               String     @id @default(uuid())
  workspaceId      String
  userId           String
  profileId        String?
  title            String
  description      String     @default("")
  competencyKeys   String[]   @default([])
  deadline         DateTime?
  status           GoalStatus @default(ACTIVE)
  progress         Float      @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   LearnerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, status])
}

/// Event-sourced mastery observations: every learner-state update points to
/// evidence (assessment, task, explanation, transfer attempt, correction…).
model MasteryObservation {
  id            String   @id @default(uuid())
  workspaceId   String
  conceptId     String
  userId        String
  profileId     String?
  dimension     String   @default("recall")
  value         Float
  confidence    Float    @default(0.5)
  sourceType    String   @default("assessment")
  sourceId      String   @default("")
  context       String   @default("")
  novelty       Float    @default(0)
  modelVersion  String   @default("")
  visibility    String   @default("learner-and-instructor")
  correctionOf  String?
  createdAt     DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  concept   LearnerConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([workspaceId, conceptId, userId, createdAt])
  @@index([workspaceId, userId, createdAt])
}

/// Misconception objects with lifecycle; learner-facing label is always
/// "current interpretation to revisit" — never a stigmatizing diagnosis.
model Misconception {
  id                 String             @id @default(uuid())
  workspaceId        String
  conceptId          String
  userId             String
  statement          String
  detectedFrom       String[]           @default([])
  confidence         Float              @default(0.5)
  severity           String             @default("medium")
  affectedConceptIds String[]           @default([])
  counterevidence    String[]           @default([])
  status             MisconceptionStatus @default(CANDIDATE)
  learnerAcknowledged Boolean           @default(false)
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  concept   LearnerConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, status])
  @@index([workspaceId, conceptId])
}

/// Typed concept dependencies with prerequisite intelligence
/// (hard/soft/hidden/local/transfer/remedial) and approval metadata.
model ConceptDependency {
  id           String               @id @default(uuid())
  workspaceId  String
  setId        String?
  fromId       String
  toId         String
  relation     ConceptDependencyRel @default(PREREQUISITE_OF)
  kind         DependencyKind       @default(SOFT)
  confidence   Float                @default(0.5)
  mandatory    Boolean              @default(false)
  scope        String               @default("")
  approved     Boolean              @default(false)
  approvedById String?
  alternatives Json?
  createdAt    DateTime             @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from      LearnerConcept @relation("DepFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        LearnerConcept @relation("DepTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([workspaceId, toId])
  @@index([workspaceId, fromId])
}

/// Explainable recommendations: reason codes, evidence, alternatives,
/// expected benefit, confidence — the learner may accept, reject, or dismiss.
model Recommendation {
  id              String               @id @default(uuid())
  workspaceId     String
  userId          String
  setId           String?
  profileId       String?
  action          String
  reasonCodes     String[]             @default([])
  explanation     String[]             @default([])
  evidence        String[]             @default([])
  alternatives    String[]             @default([])
  expectedBenefit String               @default("")
  confidence      Float                @default(0.5)
  status          RecommendationStatus @default(PROPOSED)
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, status])
}

/// Learner-controlled corrections: first-class graph events with scope,
/// impact preview, and undo — never a silent overwrite.
model GraphCorrection {
  id         String   @id @default(uuid())
  workspaceId String
  userId     String
  targetType String
  targetId   String
  field      String
  oldValue   String   @default("")
  newValue   String
  reason     String   @default("")
  scope      String   @default("profile")
  undone     Boolean  @default(false)
  createdAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, targetId])
}

/// Adaptive study plan / learner profile per set.
model StudyPlan {
  id               String   @id @default(uuid())
  workspaceId      String
  setId            String
  userId           String
  goal             String   @default("")
  nextAction       String   @default("")
  nextActionReason String   @default("")
  difficulty       String   @default("NOVICE")
  modality         String   @default("text")
  streakDays       Int      @default(0)
  workloadCapMin   Int      @default(30)
  lastActiveAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  set       LearningSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, setId, userId])
}

/// Assessment attempts with integrity + accommodation metadata.
model QuizAttempt {
  id             String          @id @default(uuid())
  workspaceId    String
  setId          String
  userId         String
  mode           QuizAttemptMode @default(PRACTICE)
  score          Int             @default(0)
  total          Int             @default(0)
  durationSec    Int             @default(0)
  integrityFlags String          @default("")
  accommodation  String          @default("")
  startedAt      DateTime        @default(now())
  submittedAt    DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  set       LearningSet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses QuizResponse[]

  @@index([workspaceId, setId, userId])
}

model QuizResponse {
  id             String  @id @default(uuid())
  attemptId      String
  prompt         String
  answer         String
  picked         String  @default("")
  correct        Boolean @default(false)
  responseTimeMs Int     @default(0)
  confidence     Float   @default(0.5)
  conceptKey     String  @default("")

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

/// Multi-agent tutor sessions with explicit orchestration + memory controls.
/// N0VA BOOKLM+EDUCATION Tutor Memory — permissioned, typed, inspectable
/// hierarchy. Every memory has scope, owner, purpose, confidence, provenance,
/// retention, and a deletion path. Lower scopes never silently escalate.
enum MemoryScope {
  TASK
  SESSION
  COURSE
  LONG_TERM
  CLASSROOM
  TENANT
  SYSTEM
}

enum MemoryStatus {
  CANDIDATE
  PROPOSED
  CONFIRMED
  ACTIVE
  REVALIDATED
  STALE
  EXPIRED
  DELETED
  ARCHIVED
}

enum MemoryClassification {
  TASK_LOCAL
  SESSION_DERIVED
  LEARNER_DECLARED
  ASSESSMENT_DERIVED
  INSTRUCTOR_VERIFIED
  COURSE_SCOPED
  CLASSROOM_SHARED
  TENANT_POLICY
  SYSTEM_POLICY
  SENSITIVE
  UNTRUSTED_DOCUMENT
  MODEL_HYPOTHESIS
}

enum ClassroomMemoryStatus {
  PROPOSED
  APPROVED
  REVOKED
  SUPERSEDED
}

/// Canonical memory object: typed, scoped, versioned, expiring.
model MemoryRecord {
  id               String               @id @default(uuid())
  workspaceId      String
  ownerId          String
  profileId        String?
  scope            MemoryScope          @default(SESSION)
  type             String               @default("learner_attribute")
  key              String
  value            String               @default("")
  valueJson        Json?
  status           MemoryStatus         @default(ACTIVE)
  confidence       Float                @default(0.5)
  confidenceLevel  String               @default("weak")
  provenance       Json?
  evidenceRefs     String[]             @default([])
  lastVerifiedAt   DateTime?
  lastUsedAt       DateTime?
  expiresAt        DateTime?
  visibility       String               @default("learner_only")
  deletionPolicy   String               @default("learner_controlled")
  version          Int                  @default(1)
  classification   MemoryClassification @default(SESSION_DERIVED)
  sensitive        Boolean              @default(false)
  courseId         String?
  sectionId        String?
  paused           Boolean              @default(false)
  tombstoneOf      String?
  createdById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, ownerId, scope, status])
  @@index([workspaceId, courseId, scope, status])
  @@index([workspaceId, expiresAt])
}

/// Instructor-approved classroom namespace: course → section → shared memory.
model ClassroomMemory {
  id          String                 @id @default(uuid())
  workspaceId String
  setId       String
  section     String                 @default("default")
  key         String
  value       String
  status      ClassroomMemoryStatus  @default(PROPOSED)
  version     Int                    @default(1)
  proposedById String?
  approvedById String?
  expiresAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, setId, section, status])
}

/// Memory audit trail: operation metadata + policy results, never deleted
/// personal content.
model MemoryEvent {
  id          String   @id @default(uuid())
  workspaceId String
  memoryId    String?
  operation   String
  actor       String   @default("")
  actorRole   String   @default("")
  policyResult String  @default("")
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, memoryId, createdAt])
  @@index([workspaceId, operation])
}

/// Instructor-configured teaching-mode policy per course (set): allowed
/// modes, course default, exam lockdown config.
model TeachingModePolicy {
  id          String   @id @default(uuid())
  workspaceId String
  setId       String
  mode        String
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  examConfig  Json?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, setId, mode])
}

/// Explainable pedagogy — versioned decision records with evidence, strategy
/// scoring, confidence decomposition, controls, and post-intervention review.
/// Originals are immutable; reviews append, never rewrite.
enum PedagogyDecisionStatus {
  PROPOSED
  PENDING_LEARNER
  ACCEPTED
  MODIFIED
  REJECTED
  DEFERRED
  ESCALATED
  DELIVERED
  MEASURED
  REVIEWED
}

/// Versioned pedagogical decision record (detail for educators/auditors).
model DecisionRecord {
  id               String   @id @default(uuid())
  workspaceId      String
  setId            String?
  userId           String
  conceptId        String?
  trigger          String   @default("")
  issueType        String   @default("insufficient_evidence")
  issueDescription String   @default("")
  severity         String   @default("moderate")
  evidence         Json?
  chosenMode       String   @default("")
  chosenAction     String   @default("")
  alternatives     Json?
  expectedTarget   String   @default("")
  successMeasure   String   @default("")
  confOverall      Float    @default(0.5)
  confIssue        Float    @default(0.5)
  confStrategy     Float    @default(0.5)
  confOutcome      Float    @default(0.5)
  status           PedagogyDecisionStatus @default(PROPOSED)
  controlBy        String?
  controlNote      String   @default("")
  provenance       Json?
  version          Int      @default(1)
  supersedesId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviews   DecisionReview[]

  @@index([workspaceId, userId, status])
  @@index([workspaceId, setId, status])
}

/// Post-intervention self-monitoring: prediction retained, outcome appended.
model DecisionReview {
  id                String   @id @default(uuid())
  workspaceId       String
  decisionId        String
  predictedOutcome  String   @default("")
  observedOutcome   String   @default("")
  predictionError   String   @default("")
  effectiveness     Float?
  nextAction        String   @default("")
  confidenceUpdate  Json?
  createdAt         DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision  DecisionRecord  @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, decisionId])
}

/// N0VA BOOKLM+EDUCATION Multi-Agent Tutor — supervised agents, event-driven
/// orchestration, versioned shared state. Learner state lives in the state
/// service; agents propose, only authorized parties commit.
enum AgentTaskStatus {
  REQUESTED
  RUNNING
  COMPLETED
  FAILED
  DEGRADED
}

enum EscalationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model TutorSession {
  id          String    @id @default(uuid())
  workspaceId String
  setId       String?
  userId      String
  mode        TutorMode @default(DIRECT)
  agent       String    @default("tutor")
  status      String    @default("open")
  summary     String    @default("")
  intent      String    @default("")
  plan        Json?
  degraded    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions PedagogicalDecision[]
  tasks     AgentTask[]
  events    AgentEvent[]
  escalations Escalation[]
  snapshots StateSnapshot[]

  @@index([workspaceId, userId])
}

model TutorMemory {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  sessionId   String?
  scope       TutorMemoryScope @default(SESSION)
  key         String
  value       String
  confidence  Float            @default(0.5)
  provenance  String           @default("")
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, scope])
}

/// Explainable pedagogical decisions: issue, evidence, strategy, alternatives, outcome, confidence.
model PedagogicalDecision {
  id              String   @id @default(uuid())
  workspaceId     String
  sessionId       String
  detectedIssue   String
  evidenceUsed    String   @default("")
  chosenStrategy  String
  alternatives    String   @default("")
  expectedOutcome String   @default("")
  confidence      Float    @default(0.5)
  learnerOverride String   @default("")
  createdAt       DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Agent registry: mandate, tools, version, confidence limits, allowed
/// actions, data scopes. Seeded per workspace; versions frozen for exams.
model TutorAgent {
  id              String   @id @default(uuid())
  workspaceId     String
  key             String
  name            String
  mandate         String   @default("")
  tools           String[] @default([])
  version         String   @default("1.0")
  confidenceLimit Float    @default(0.45)
  allowedActions  String[] @default([])
  dataScopes      String[] @default([])
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

/// Strict-contract agent tasks: artifacts, claims, state proposals, warnings,
/// next actions, model version. Failures degrade visibly, never silently.
model AgentTask {
  id           String          @id @default(uuid())
  workspaceId  String
  sessionId    String
  agentKey     String
  intent       String          @default("")
  target       Json?
  constraints  Json?
  status       AgentTaskStatus @default(REQUESTED)
  artifacts    Json?
  claims       Json?
  proposals    Json?
  warnings     String[]        @default([])
  nextActions  String[]        @default([])
  modelVersion String          @default("")
  latencyMs    Int?
  error        String          @default("")
  createdAt    DateTime        @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sessionId])
  @@index([workspaceId, agentKey])
}

/// Append-only event log: replay, debugging, rollback, audit, evaluation.
model AgentEvent {
  id          String   @id @default(uuid())
  workspaceId String
  sessionId   String
  taskId      String?
  type        String
  payload     Json?
  actor       String   @default("orchestrator")
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sessionId, createdAt])
}

/// Versioned shared learner-state snapshots (read-only for agents by default).
model StateSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  sessionId   String
  userId      String
  state       Json
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sessionId, version])
}

/// Accountable escalation layer: packet, recommendation, resolution state.
model Escalation {
  id             String           @id @default(uuid())
  workspaceId    String
  sessionId      String?
  setId          String?
  userId         String
  topic          String           @default("")
  issue          String
  evidence       String[]         @default([])
  disagreement   Json?
  recommendation String           @default("")
  learnerVisible Boolean          @default(true)
  urgency        String           @default("normal")
  status         EscalationStatus @default(OPEN)
  resolution     String           @default("")
  resolvedById   String?
  createdAt      DateTime         @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   TutorSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, userId])
}

/// Rubric-aware grading with audit trail + appeals.
model Assessment {
  id          String   @id @default(uuid())
  workspaceId String
  setId       String?
  title       String
  description String   @default("")
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  criteria  RubricCriterion[]
  grades    Grade[]

  @@index([workspaceId, setId])
}

model RubricCriterion {
  id           String @id @default(uuid())
  assessmentId String
  label        String
  description  String @default("")
  weight       Float  @default(1)
  maxPoints    Float  @default(10)

  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  evidence   GradeEvidence[]

  @@index([assessmentId])
}

model Grade {
  id           String   @id @default(uuid())
  workspaceId  String
  assessmentId String
  userId       String
  totalPoints  Float    @default(0)
  maxPoints    Float    @default(0)
  explanation  String   @default("")
  blindKey     String   @default("")
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence   GradeEvidence[]
  audits     GradeAudit[]
  appeals    GradeAppeal[]

  @@index([workspaceId, assessmentId])
  @@index([assessmentId, userId])
}

model GradeEvidence {
  id            String @id @default(uuid())
  gradeId       String
  criterionId   String
  points        Float  @default(0)
  evidenceQuote String @default("")
  reasoning     String @default("")

  grade     Grade           @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([gradeId])
}

model GradeAudit {
  id          String   @id @default(uuid())
  gradeId     String
  workspaceId String
  actorId     String
  action      String
  detail      String   @default("")
  createdAt   DateTime @default(now())

  grade     Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([gradeId])
}

model GradeAppeal {
  id          String       @id @default(uuid())
  gradeId     String
  workspaceId String
  userId      String
  reason      String
  status      AppealStatus @default(OPEN)
  resolution  String       @default("")
  createdAt   DateTime     @default(now())

  grade     Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gradeId])
}

/// Collaborative annotation + research workspace threads.
model LearningAnnotation {
  id          String   @id @default(uuid())
  workspaceId String
  setId       String?
  itemId      String?
  userId      String
  quote       String   @default("")
  comment     String
  threadId    String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, setId])
  @@index([workspaceId, itemId])
}

/// N0VA VOICE - call log.
model CallLog {
  id          String        @id @default(uuid())
  workspaceId String
  direction   CallDirection @default(IN)
  contactName String        @default("")
  number      String
  durationSec Int           @default(0)
  status      String        @default("completed")
  note        String        @default("")
  favorite    Boolean       @default(false)
  startedAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt(sort: Desc)])
}

enum CallDirection {
  IN
  OUT
}

/// N0VA VAULT - encrypted secrets.
model VaultEntry {
  id             String    @id @default(uuid())
  workspaceId    String
  createdById    String?
  name           String
  encryptedValue String
  hint           String    @default("")
  category       String    @default("general")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt(sort: Desc)])
}

/// N0VA WORKSPACE STUDIO - automations.
model Automation {
  id          String            @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  trigger     AutomationTrigger @default(MANUAL)
  action      AutomationAction  @default(LOG)
  config      Json
  enabled     Boolean           @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      AutomationRun[]

  @@index([workspaceId, updatedAt(sort: Desc)])
}

enum AutomationTrigger {
  MANUAL
  SCHEDULE
  EVENT
}

enum AutomationAction {
  LOG
  NOTIFY
  CREATE_DOC
}

model AutomationRun {
  id           String   @id @default(uuid())
  automationId String
  workspaceId  String
  status       String   @default("success")
  detail       String   @default("")
  durationMs   Int      @default(0)
  startedAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([automationId, startedAt(sort: Desc)])
}

/// N0VA1O - integration gateway.
model Integration {
  id                 String    @id @default(uuid())
  workspaceId        String
  createdById        String?
  provider           String
  name               String
  category           String    @default("other")
  status             String    @default("connected")
  config             Json
  enabled            Boolean   @default(true)
  mcpEnabled         Boolean   @default(false)
  webhookEnabled     Boolean   @default(true)
  webhookSecret      String?
  webhookPath        String?
  rateLimitPerMin    Int       @default(120)
  retryMax           Int       @default(3)
  timeoutMs          Int       @default(15000)
  allowlistTools     Json      @default("[]")
  blocklistTools     Json      @default("[]")
  /// The currently-selected account for multi-account switching (spec §3.6).
  activeConnectionId String?   @unique
  lastSyncAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace                Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy                User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  logs                     IntegrationLog[]
  accessRequests           IntegrationAccessRequest[]
  connections              IntegrationConnection[]
  activeConnection         IntegrationConnection?     @relation("ActiveConnection", fields: [activeConnectionId], references: [id], onDelete: SetNull)
  connectorCircuits        ConnectorCircuit[]
  connectorEventLogs       ConnectorEventLog[]
  connectorSyncCheckpoints ConnectorSyncCheckpoint[]

  @@index([workspaceId, updatedAt(sort: Desc)])
}

model IntegrationLog {
  id             String   @id @default(uuid())
  integrationId  String
  workspaceId    String
  level          String   @default("info")
  direction      String   @default("outbound")
  statusCode     Int?
  durationMs     Int?
  idempotencyKey String?
  method         String?
  path           String?
  meta           Json?
  message        String
  createdAt      DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

/// N0VA1O MCP - governed tool access requests (blocked destructive tools).
enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model IntegrationAccessRequest {
  id                String              @id @default(uuid())
  integrationId     String
  workspaceId       String
  requestedById     String?
  requesterLabel    String              @default("mcp-agent")
  tool              String
  reason            String              @default("")
  /// The exact arguments the agent passed (JSON object). Stored for review
  /// so an approver can see the precise parameters that were blocked.
  toolArguments     Json?
  /// The agent's chain-of-thought / reasoning that led to the request,
  /// if provided by the caller. Enables the Interrogation Room review panels.
  reasoningChain    Json?
  /// A compact lineage of prior tool calls in the same session, so reviewers
  /// can see what data the agent accessed before requesting the action.
  sessionContext    Json?
  status            AccessRequestStatus @default(PENDING)
  decidedById       String?
  decidedAt         DateTime?
  /// Cryptographic signature (base64) over the decision, applied at approval
  /// time. Lets admins digitally sign off via the Interrogation Room.
  approvedSignature String?
  createdAt         DateTime            @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/// N0VA1O JIT authentication — tenant-isolated per-account credential envelopes.
model IntegrationConnection {
  id                    String           @id @default(uuid())
  integrationId         String
  workspaceId           String
  /// Human-readable label for this account (e.g. "prod Meta BM #1").
  accountLabel          String?
  /// OAuth2 / apiKey / basic / webhook — mirrors the catalog auth type.
  authType              String
  /// Encrypted token envelope (AES-256-GCM per tenant key). Never plaintext.
  encryptedToken        String
  /// OAuth2 refresh token (encrypted). Enables transparent token refresh.
  refreshToken          String?
  /// When the refresh token itself expires (if the provider rotates it).
  refreshTokenExpiresAt DateTime?
  /// The plaintext scopes this connection is authorized for (scope pruning).
  allowedScopes         Json?            @default("[]")
  /// Action-level allowlist from the catalog (e.g. ["read_campaigns", "update_budget"]).
  allowedActions        Json?            @default("[]")
  /// Action-level blocklist (e.g. ["delete_account", "modify_billing"]).
  blockedActions        Json?            @default("[]")
  /// Token lifecycle state machine state.
  tokenState            TokenState       @default(ACTIVE)
  /// Monotonic token version — bumped on every refresh/rotation (spec §token rotation).
  tokenVersion          Int              @default(1)
  /// When the access token expires (for proactive refresh).
  expiresAt             DateTime?
  /// When the credential was last refreshed / verified.
  lastRefreshed         DateTime?
  status                ConnectionStatus @default(ACTIVE)
  /// Health-score 0..1 surfaced by the self-improving auth optimizer.
  healthScore           Float?           @default(1.0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  integration          Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activeForIntegration Integration? @relation("ActiveConnection")

  @@index([workspaceId, integrationId])
  @@index([expiresAt])
  @@index([tokenState])
}

/// Token lifecycle state machine (spec §3.1.1)
enum TokenState {
  PROVISIONING
  ACTIVE
  REFRESHING
  DEGRADED
  FAILED
  REVOKED
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// Per-connector circuit breaker state (spec §reliability).
model ConnectorCircuit {
  id            String    @id @default(uuid())
  integrationId String    @unique
  workspaceId   String
  state         String    @default("CLOSED") // CLOSED | OPEN | HALF_OPEN
  failureCount  Int       @default(0)
  openedAt      DateTime?
  cooldownUntil DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Replayable gateway event log + dead-letter queue (status FAILED).
model ConnectorEventLog {
  id              String    @id @default(uuid())
  integrationId   String?
  workspaceId     String
  direction       String    @default("OUTBOUND") // INBOUND | OUTBOUND | RELAY
  canonicalObject String?
  actionType      String
  payload         Json      @default("{}")
  provenance      Json? // { origin, sourceMessageId, sourceId, trust }
  status          String    @default("SUCCESS") // PENDING | SUCCESS | FAILED | RETRYING
  retryCount      Int       @default(0)
  error           String?
  idempotencyKey  String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([workspaceId, direction, status])
  @@index([integrationId, createdAt(sort: Desc)])
}

/// Bidirectional sync checkpoint + conflict policy (spec §bidirectional sync).
model ConnectorSyncCheckpoint {
  id             String   @id @default(uuid())
  integrationId  String
  workspaceId    String
  objectType     String
  cursor         Json     @default("{}")
  conflictPolicy String   @default("LWW") // LWW | REMOTE_WINS | LOCAL_WINS | NONE
  lastSyncedAt   DateTime @default(now())
  lastError      String?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([integrationId, objectType])
  @@index([workspaceId])
}

/// N0VA ANI - assistant conversations.
model AniConversation {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages  AniMessage[]

  @@index([workspaceId, updatedAt(sort: Desc)])
}

model AniMessage {
  id             String   @id @default(uuid())
  conversationId String
  workspaceId    String
  role           String   @default("user")
  content        String
  citations      String   @default("[]")
  confidence     Float?
  toolCalls      String   @default("[]")
  depth          String   @default("balanced")
  intent         String   @default("conversational")
  thoughtSummary String?
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  latencyMs      Int      @default(0)
  costUsd        Float    @default(0)
  createdAt      DateTime @default(now())

  conversation AniConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// N0VA ANI - persisted memory marks across sessions.
model AniMemoryMark {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  type        String   @default("fact")
  content     String
  context     String   @default("")
  importance  Float    @default(0.5)
  tags        String[] @default([])
