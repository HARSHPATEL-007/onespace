enum VoiceSource {
  NOTE
  MEMO
  HUDDLE
  UPLOAD
  LIVE
}

enum VoiceStatus {
  RECORDING
  PENDING
  TRANSCRIBING
  EXTRACTED
  DONE
  FAILED
}

enum VoiceConsent {
  NONE
  INFORMED
  GUEST_DISCLOSED
  ON_DEVICE
}

enum VoiceExtractionKind {
