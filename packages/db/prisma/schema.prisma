model DocComment {
  id          String   @id @default(uuid())
  docId       String
  workspaceId String
  createdById String
  authorName  String
  text        String
  createdAt   DateTime @default(now())

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

