generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A N0VA Workspace is the tenant boundary. Every business entity belongs to exactly one.
model Workspace {
  id        String  @id @default(uuid())
  slug      String  @unique
  name      String
  plan      String  @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      WorkspaceMember[]
  permissions  WorkspacePermission[]
  auditLogs    AuditLog[]
  attachments  Attachment[]
  notifications Notification[]
  contacts     Contact[]
  storageItems StorageItem[]
  notes        Note[]
  taskLists    TaskList[]
  calendarEvents CalendarEvent[]
  forms        Form[]
  docs         Doc[]
  chatChannels ChatChannel[]
  chatMessages ChatMessage[]
  mailMessages MailMessage[]
  mailLabels   MailLabel[]
  sheetWorkbooks SheetWorkbook[]
  groups         Group[]
  presentations  Presentation[]
  drawings       Drawing[]
  albums         Album[]
  photos         Photo[]
  videos         Video[]
  meetRooms      MeetRoom[]
  meetMessages   MeetMessage[]
  sites          Site[]
  sitePages      SitePage[]
  mfaEnabled     Boolean       @default(false)
  sessionTimeoutMin Int       @default(60)
  integrationRetentionDays Int @default(90)
  mcpKey         String?
  learningSets   LearningSet[]
  learningItems  LearningItem[]
  callLogs       CallLog[]
  vaultEntries    VaultEntry[]
  automations     Automation[]
  automationRuns  AutomationRun[]
integrations    Integration[]
  integrationLogs IntegrationLog[]
   integrationAccessRequests IntegrationAccessRequest[]
   integrationConnections   IntegrationConnection[]
  aniConversations AniConversation[]
  aniMessages     AniMessage[]
  scripts         Script[]
  scriptRuns      ScriptRun[]
  endpointDevices EndpointDevice[]
  invoices        Invoice[]
  employees       Employee[]
  leaveRequests   LeaveRequest[]
  legalDocuments  LegalDocument[]
  opsRunbooks     OpsRunbook[]
  incidents       Incident[]
  tickets         Ticket[]
  ticketReplies   TicketReply[]
  deals           Deal[]
  subscriptions   Subscription[]
  payments        Payment[]
  campaigns       Campaign[]
  healthCheckins  HealthCheckin[]
  videoPlaylists  VideoPlaylist[]
  legalDocRevisions LegalDocRevision[]
  dealNotes       DealNote[]
  incidentUpdates IncidentUpdate[]
  moduleSettings  WorkspaceModuleSetting[]
  invites         Invite[]
  mailThreads     MailThread[]
  mailDrafts      MailDraft[]
  mailRules       MailRule[]
  mailAttachments MailAttachment[]
  mailDomains     MailDomain[]
  mailContacts    MailContact[]
  mailSignatures  MailSignature[]
  mailAutoResponders MailAutoResponder[]
  mailUserFolders MailUserFolder[]
}

/// A user is global; they belong to workspaces via WorkspaceMember.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   WorkspaceMember[]
  auditLogs     AuditLog[]
  attachments   Attachment[]
  notifications Notification[]
  createdContacts Contact[]
  createdStorageItems StorageItem[]
  createdNotes Note[]
  createdTaskLists TaskList[]
createdCalendarEvents CalendarEvent[]
  createdForms Form[]
  createdDocs Doc[]
  chatMemberships ChatMember[]
  createdWorkbooks SheetWorkbook[]
  groupMemberships GroupMember[]
  createdPresentations Presentation[]
  createdDrawings Drawing[]
  createdAlbums Album[]
  createdPhotos Photo[]
  createdVideos Video[]
  meetParticipations MeetParticipant[]
  createdGroups      Group[]
  createdMeetRooms   MeetRoom[]
  createdSites       Site[]
  createdLearningSets LearningSet[]
  createdVaultEntries  VaultEntry[]
  createdAutomations   Automation[]
  createdIntegrations  Integration[]
  createdAniConversations AniConversation[]
  createdScripts       Script[]
  devices              EndpointDevice[]
  createdInvoices      Invoice[]
  createdLegalDocuments LegalDocument[]
  createdRunbooks      OpsRunbook[]
  createdIncidents     Incident[]
  createdTickets       Ticket[]
  ticketReplies        TicketReply[]
  createdDeals         Deal[]
  createdSubscriptions Subscription[]
  createdPayments      Payment[]
  createdCampaigns     Campaign[]
  healthCheckins       HealthCheckin[]
  createdVideoPlaylists VideoPlaylist[] @relation("createdVideoPlaylists")
  createdLegalDocRevisions LegalDocRevision[] @relation("createdLegalDocRevisions")
  createdDealNotes      DealNote[] @relation("createdDealNotes")
  createdIncidentUpdates IncidentUpdate[] @relation("createdIncidentUpdates")
  createdInvites        Invite[] @relation("createdInvites")
  createdMailDrafts     MailDraft[] @relation("createdMailDrafts")
  createdMailRules      MailRule[] @relation("createdMailRules")
  createdMailContacts   MailContact[] @relation("createdMailContacts")
  createdMailSignatures MailSignature[] @relation("createdMailSignatures")
  createdMailAutoResponders MailAutoResponder[] @relation("createdMailAutoResponders")
  createdMailUserFolders MailUserFolder[] @relation("createdMailUserFolders")
}

/// Seat within a workspace + assigned role.
model WorkspaceMember {
  id          String       @id @default(uuid())
  workspaceId String
  userId      String
  role        Role         @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Per-workspace RBAC matrix override per module + action.
model WorkspacePermission {
  id        String   @id @default(uuid())
  workspaceId String
  role      Role
  module    String
  action    PermissionAction
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role, module, action])
  @@index([workspaceId])
}

/// Immutable, tenant-scoped provenance trail.
model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  actorId     String?
  module      String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorId])
}

/// Shared asset references used by every content and communication module.
model Attachment {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String
  filename    String
  mimeType    String
  sizeBytes   Int      @default(0)
  storageKey  String
  kind        AttachmentKind @default(FILE)
  checksum    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdById])
}

/// Cross-module in-app notifications.
model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  type        String?
  title       String
  body        String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  ADMIN
}

enum AttachmentKind {
  FILE
  LINK
}
/// N0VA CALENDAR — events.
model CalendarEvent {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  attendees   String[] @default([])
  recurrence  CalendarRecurrence @default(NONE)
  repeatUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
}

enum CalendarRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}


/// N0VA CONTACTS — unified people model.
model Contact {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  company     String?
  title       String?
  avatarUrl   String?
  notes       String?
  labels      String[]  @default([])
  isFavorite  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([workspaceId, isFavorite])
  @@index([workspaceId, firstName])
}


/// N0VA FORMS — builders and responses.
model Form {
  id          String         @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  description String?
  fields      Json
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  responses FormResponse[]

  @@index([workspaceId])
}

model FormResponse {
  id          String   @id @default(uuid())
  formId      String
  workspaceId String
  answers     Json
  submittedAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}


/// N0VA KEEP — notes and lists.
model Note {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  title       String    @default("")
  body        String    @default("")
  color       String    @default("default")
  pinned      Boolean   @default(false)
  archived    Boolean   @default(false)
  labels      String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, pinned, archived])
}


/// N0VA CLOUD STORAGE — files, folders, versions.
model StorageItem {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  isFolder    Boolean   @default(false)
  parentId    String?
  mimeType    String    @default("application/octet-stream")
  sizeBytes   Int       @default(0)
  storageKey  String?
  checksum    String?
  version     Int       @default(1)
  trashedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  parent    StorageItem? @relation("StorageFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  StorageItem[] @relation("StorageFolder")
  versions  StorageFileVersion[]

  @@index([workspaceId, parentId, trashedAt])
}

model StorageFileVersion {
  id          String   @id @default(uuid())
  itemId      String
  workspaceId String
  sizeBytes   Int      @default(0)
  storageKey  String
  createdAt   DateTime @default(now())

  item StorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}


/// N0VA TASKS — lists and tasks.
model TaskList {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  color       String    @default("default")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([workspaceId])
}

model Task {
  id          String     @id @default(uuid())
  listId      String
  workspaceId String
  createdById String?
  title       String
  notes       String?
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String?
  priority    Priority   @default(MEDIUM)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  list TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([workspaceId, completedAt])
  @@index([listId, position])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// N0VA DOCS - rich documents.
model Doc {
  id          String    @id @default(uuid())
  workspaceId String
  createdById String?
  title       String    @default("Untitled")
  content     String    @default("")
  version     Int       @default(1)
  pinned      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  revisions DocRevision[]
  comments  DocComment[]

  @@index([workspaceId, updatedAt(sort: Desc)])
}

model DocRevision {
  id          String   @id @default(uuid())
  docId       String
  workspaceId String
  content     String
  createdById String?
  createdAt   DateTime @default(now())

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt(sort: Desc)])
}

model DocComment {
  id          String   @id @default(uuid())
  docId       String
  workspaceId String
  createdById String
  authorName  String
  text        String
  createdAt   DateTime @default(now())

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
}

/// N0VA CHAT - channels and messages.
model ChatChannel {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  kind        ChatChannelKind @default(CHANNEL)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  members   ChatMember[]

  @@index([workspaceId, updatedAt(sort: Desc)])
}

model ChatMessage {
  id          String   @id @default(uuid())
  channelId   String
  workspaceId String
  createdById String
  authorName  String
  body        String
  reactions   Json     @default("[]")
  createdAt   DateTime @default(now())

channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)])
}

model ChatMember {
  id         String    @id @default(uuid())
  channelId  String
  userId     String
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

enum ChatChannelKind {
  CHANNEL
  DM
}

/// N0VA MAIL - messages, threads and labels.
model MailMessage {
  id          String        @id @default(uuid())
  workspaceId String
  threadId    String
  direction   MailDirection @default(IN)
  folder      MailFolder    @default(INBOX)
  status      MailStatus    @default(SENT)
  fromName    String        @default("")
  fromEmail   String
  toEmails    Json
  ccEmails    Json          @default("[]")
  bccEmails   Json          @default("[]")
  subject     String        @default("(no subject)")
  body        String        @default("")
  bodyHtml    String?       @default("")
  isRead      Boolean       @default(false)
  isStarred   Boolean       @default(false)
  isForwarded Boolean       @default(false)
  inReplyToId String?
  signatureId String?
  autoRespond Boolean       @default(false)
   snoozeUntil DateTime?
   scheduledAt DateTime?
   sentAt      DateTime      @default(now())
   /// AI fields
   aiPriority  MailPriority  @default(MEDIUM)
   aiCategory  MailCategory  @default(WORK)
   aiSentiment String        @default("neutral")
   aiSummary   String?       @default("")
   aiProcessed Boolean       @default(false)
   createdAt   DateTime      @default(now())

    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
   labels    MailLabelMap[]
   attachments MailAttachment[]

   @@index([workspaceId, folder, sentAt(sort: Desc)])
   @@index([workspaceId, threadId])
   @@index([workspaceId, status, scheduledAt])
   @@index([workspaceId, snoozeUntil])
   @@index([workspaceId, aiPriority])
   @@index([workspaceId, aiCategory])
}

enum MailStatus {
   DRAFT
   SCHEDULED
   SENT
   FAILED
}

enum MailPriority {
   HIGH
   MEDIUM
   LOW
}

enum MailCategory {
   PERSONAL
   WORK
   NEWSLETTER
   NOTIFICATION
   PROMOTIONAL
   SPAM
}

model MailLabel {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  color       String         @default("#7c5cfc")
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  MailLabelMap[]
}

model MailLabelMap {
  id          String @id @default(uuid())
  messageId   String
  labelId     String
  workspaceId String

  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  label   MailLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([messageId, labelId])
}

enum MailDirection {
  IN
  OUT
}

enum MailFolder {
  INBOX
  SENT
  ARCHIVE
  TRASH
}

/// N0VA MAIL — thread-level conversation aggregate (denormalized for fast list rendering).
model MailThread {
  id          String     @id @default(uuid())
  workspaceId String
  threadId    String
  folder      MailFolder @default(INBOX)
  subject      String     @default("(no subject)")
  isRead       Boolean    @default(false)
  isStarred    Boolean    @default(false)
  unreadCount  Int        @default(0)
  messageCount Int        @default(0)
  participants Json       @default("[]")
  latestSentAt DateTime   @default(now())
  latestMsgId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, folder, latestSentAt(sort: Desc)])
  @@index([workspaceId, isRead, unreadCount])
  @@unique([workspaceId, threadId])
}

/// N0VA MAIL — saved draft messages.
model MailDraft {
  id          String            @id @default(uuid())
  workspaceId String
  createdById String?
  subject     String            @default("(no subject)")
  toEmails    String[]          @default([])
  ccEmails    String[]          @default([])
  body        String            @default("")
  status      MailDraftStatus   @default(DRAFT)
  threadId    String?
  scheduledAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailDrafts", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt(sort: Desc)])
}

enum MailDraftStatus {
  DRAFT
  SCHEDULED
  SENDING
}

/// N0VA MAIL — automation rules for auto-label, auto-archive, forward, webhook.
model MailRule {
  id           String        @id @default(uuid())
  workspaceId  String
  createdById  String?
  name         String
  description  String        @default("")
  enabled      Boolean       @default(true)
  priority     Int           @default(100)
  /// Array of condition clauses, each { field, operator, value(s), not?: boolean }
  conditions   Json          @default("[]")
  /// Array of action objects, each { type, ...params }
  actions      Json          @default("[]")
  lastRunAt    DateTime?
  runCount     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailRules", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, priority, enabled])
  @@index([workspaceId, createdAt(sort: Desc)])
}

/// N0VA MAIL — attachment references (metadata in DB, blobs in object storage).
model MailAttachment {
  id          String   @id @default(uuid())
  workspaceId String
  messageId   String
  filename    String
  mimeType    String
  sizeBytes   Int      @default(0)
  storageKey  String
  checksum    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// N0VA MAIL — custom domain configuration for inbound/outbound routing.
model MailDomain {
  id            String   @id @default(uuid())
  workspaceId   String
  domain        String
  dkimKey       String?
  spfRecord     String?
  dmarcPolicy   String?
  mtaSts        String?
  tlsRpt        String?
  bimiUrl       String?
  verified      Boolean  @default(false)
  healthStatus  String   @default("unknown")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
}

/// N0VA MAIL — contact / address book entries per workspace.
model MailContact {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  firstName   String   @default("")
  lastName    String   @default("")
  email       String
  phone       String   @default("")
  company     String   @default("")
  jobTitle    String   @default("")
  notes       String   @default("")
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailContacts", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, lastName, firstName])
  @@index([workspaceId, isFavorite])
}

/// N0VA MAIL — custom signatures for outgoing mail.
model MailSignature {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  content     String   @default("")
  contentHtml String?  @default("")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailSignatures", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, isDefault])
}

/// N0VA MAIL — auto-responder / out-of-office configuration.
model MailAutoResponder {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  enabled     Boolean  @default(false)
  subject     String   @default("Out of Office")
  body        String   @default("I am currently out of office.")
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("createdMailAutoResponders", fields: [createdById], references: [id], onDelete: SetNull)
}

/// N0VA MAIL — user-created nested folders.
model MailUserFolder {
  id          String   @id @default(uuid())
  workspaceId String
  createdById String?
  name        String
  parentFolderId String?
  color       String   @default("#7c5cfc")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("createdMailUserFolders", fields: [createdById], references: [id], onDelete: SetNull)
  parentFolder MailUserFolder? @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders MailUserFolder[]  @relation("FolderHierarchy")

  @@unique([workspaceId, parentFolderId, name])
  @@index([workspaceId, parentFolderId])
}

/// N0VA SHEETS - workbooks with JSON cell grids.
model SheetWorkbook {
