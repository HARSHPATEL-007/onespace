  numericValue    Float?
  unit            String?
  referenceRange  String?
  status          String   @default("final") // preliminary | final | amended | cancelled
  abnormal        Boolean  @default(false)
  specimenId      String?
  performer       String?
  fhirObservation Json?
  resultedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId, resultedAt(sort: Desc)])
  @@index([workspaceId, testName])
}

/// Medical Imaging — DICOMweb, HL7 FHIR ImagingStudy, WADO-RS / STOW-RS.
model HealthImagingStudy {
  id               String   @id @default(uuid())
  workspaceId      String
  patientId        String
  encounterId      String?
  modality         String   @default("CT") // CT | MRI | XRAY | US | PET | MG | DX
