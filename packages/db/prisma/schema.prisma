  PENDING
  SENT
  FAILED
  DLQ
}

enum SagaStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  COMPENSATED
}

enum DLQStatus {
  QUARANTINED
  REQUEUED
  DROPPED
}

model EventEnvelope {
  id           String          @id @default(uuid())
  eventId      String          @unique
  eventType    String
  version      String
  schemaVersion Int            @default(1)
  timestamp    DateTime        @default(now())
  producer     String
  tenantId     String?
  aggregateId  String?
  correlationId String?
  causationId  String?
  traceId      String?
  idempotencyKey String?
  partitionKey String?
  visibility   EventVisibility @default(INTERNAL)
  payload      Json            @default("{}")
  retryCount   Int             @default(0)
  published    Boolean         @default(false)
  publishedAt  DateTime?
  consumedHops Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([eventType, timestamp])
  @@index([correlationId])
  @@index([traceId])
  @@index([aggregateId])
  @@index([tenantId])
}

model EventOutbox {
  id          String           @id @default(uuid())
  eventId     String           @unique
  envelopeId  String?
  tenantId    String?
  eventType   String
  topic       String
  broker      String           @default("memory")
  envelope    Json             @default("{}")
  status      EventOutboxStatus @default(PENDING)
  attempts    Int              @default(0)
  nextRetryAt DateTime?
  error       String?
  enqueuedAt  DateTime         @default(now())
  publishedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@index([status, nextRetryAt])
  @@index([tenantId, eventType])
}

model IdempotencyRecord {
  id          String   @id @default(uuid())
  handlerKey  String
  eventId     String
  effect      String?
  status      String   @default("APPLIED")
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@unique([handlerKey, eventId])
  @@index([expiresAt])
}

model EventTraceHop {
  id            String   @id @default(uuid())
  traceId       String
  correlationId String?
  eventId       String
  producer      String?
  consumer      String
  broker        String?
  hop           Int      @default(0)
  status        String   @default("OK")
  latencyMs     Int?
  retryCount    Int      @default(0)
  detail        String?
  at            DateTime @default(now())

  @@index([traceId])
  @@index([correlationId])
  @@index([eventId])
}

model EventDLQ {
  id            String    @id @default(uuid())
  eventId       String    @unique
  eventType     String
  topic         String
  payload       Json      @default("{}")
  reason        String?
  attempts      Int       @default(0)
  status        DLQStatus @default(QUARANTINED)
  quarantinedAt DateTime  @default(now())
  requeuedAt    DateTime?
  resolvedAt    DateTime?
  error         String?

  @@index([status])
  @@index([eventType])
}

model SagaInstance {
  id              String     @id @default(uuid())
  sagaType        String
  tenantId        String?
  correlationId   String
  title           String?
  status          SagaStatus @default(PENDING)
  payload         Json       @default("{}")
  currentStep     Int        @default(0)
  steps           Json       @default("[]")
  compensationStack Json     @default("[]")
  history         Json       @default("[]")
  error           String?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  updatedAt       DateTime   @updatedAt

  @@index([sagaType, status])
  @@index([correlationId])
}

model ProjectionCursor {
  name        String   @id
  lastEventId String?
  lastEventAt DateTime?
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model ThreadViewProjection {
  id            String   @id @default(uuid())
  threadId      String   @unique
  tenantId      String?
  channelId     String?
  title         String   @default("")
  summary       String   @default("")
  participantIds String[] @default([])
  messageCount  Int      @default(0)
  decisionCount Int      @default(0)
  openActionCount Int     @default(0)
  lastSpeakerId String?
  lastActivity  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([lastActivity])
}

model TaskDashboardProjection {
  id             String @id @default(uuid())
  tenantId       String
  assigneeId     String
  total          Int    @default(0)
  open           Int    @default(0)
  inProgress     Int    @default(0)
  done           Int    @default(0)
  overdue        Int    @default(0)
  highPriority   Int    @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, assigneeId])
}

model InboxProjectionItem {
  id          String   @id @default(uuid())
  tenantId    String?
  userId      String
  sourceEvent String
  sourceId    String?
  kind        String
  title       String
  body        String?
  link        String?
  urgent      Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, read])
  @@index([tenantId])
}

model ComplianceProjection {
  id         String   @id @default(uuid())
  tenantId   String?
  kind       String
  objectId   String?
  title      String
  status     String   @default("WATCH")
  severity   String   @default("INFO")
  linkedEvents String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, status])
  @@index([kind])
}

model EventSubscription {
  id            String   @id @default(uuid())
  consumerKey   String
  eventTypes    String[] @default([])
  handlerVersion Int     @default(1)
  filterJson    Json     @default("{}")
  enabled       Boolean  @default(true)
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

@@unique([consumerKey])
}

// ═══════════════════════════════════════════════════════════════════════
// N0VA VOICE (Project Echo) — transcribed, searchable, executable audio.
// Every voice message becomes a structured input stream: transcript +
// extracted tasks/events/follow-ups with timestamps, speakers, and links.
// ═══════════════════════════════════════════════════════════════════════

enum VoiceSource {
  NOTE
  MEMO
  HUDDLE
  UPLOAD
  LIVE
}

enum VoiceStatus {
  RECORDING
  PENDING
  TRANSCRIBING
  EXTRACTED
  DONE
  FAILED
}

enum VoiceConsent {
  NONE
  INFORMED
  GUEST_DISCLOSED
  ON_DEVICE
}

enum VoiceExtractionKind {
  TASK
  FOLLOW_UP
  REMINDER
  DECISION
  APPROVAL
  DELEGATE
  RESEARCH
  EVENT
}

enum VoiceExtractionState {
  DRAFT
  CONFIRMED
  REJECTED
  AUTO_CREATED
}

/// N0VA VOICE (Project Echo) — a transcribed recording (note/memo/huddle/upload/live).
model VoiceRecording {
  id           String   @id @default(uuid())
  voiceId      String   @unique
  workspaceId  String
  createdById  String
  source       VoiceSource   @default(NOTE)
  status       VoiceStatus   @default(PENDING)
  title        String   @default("")
  audioKey     String   @default("")
  audioSizeBytes Int    @default(0)
  audioDurationMs Int   @default(0)
  mimeType     String   @default("audio/webm")
  language     String   @default("en")
  consent      VoiceConsent  @default(INFORMED)
  retentionDays Int     @default(90)
  roomRef      String?
  threadRef    String?
  timezone     String?
  transcriptText String @default("")
  correctedTranscript String?
  transcriptVersion Int @default(1)
  confidenceAvg Float?
  qualityStats Json?
  summary     Json?
  meta        Json?
  transcribedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  segments   VoiceTranscriptSegment[]
  extractions VoiceExtraction[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([status])
  @@index([source])
  @@index([roomRef])
}

/// Timestamped, speaker-labeled transcript segment (original + corrected versions).
model VoiceTranscriptSegment {
  id            String   @id @default(uuid())
  recordingId   String
  order         Int
  startMs       Int
  endMs         Int
  speaker       String   @default("SPEAKER_00")
  text          String
  correctedText String?
  confidence    Float    @default(0)

  recording VoiceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId, order])
}

/// Extracted action items / calendar intents / decisions from a transcript.
model VoiceExtraction {
  id            String   @id @default(uuid())
  workspaceId   String
  recordingId   String
  kind          VoiceExtractionKind
  category      String
  title         String
  ownerId       String?
  assigneeName  String?
  dueAt         DateTime?
  startAt       DateTime?
  endAt         DateTime?
  durationMin   Int?
  confidence    Float
  priority      String   @default("MEDIUM")
  attendees     Json?
  sourceStartMs Int
  sourceEndMs   Int
  sourceText    String
  state         VoiceExtractionState @default(DRAFT)
  targetType    String?
  targetId      String?
  meta          Json?
  createdAt     DateTime @default(now())
  confirmedAt   DateTime?

  recording VoiceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
  @@index([state])
  @@index([workspaceId])
  @@index([priority])
}

enum WellbeingScope {
  ROOM
  TEAM
  WORKSPACE
}

enum InterventionKind {
  BREAK_HUDDLE
  FOCUS_MODE
  MODERATION_REVIEW
  WORKLOAD_REBALANCE
  MANAGER_CHECKIN
  ENVIRONMENT_ALERT
  REST_SUGGESTION
  CELEBRATE_WINS
}

enum InterventionStatus {
  SUGGESTED
  ACKNOWLEDGED
  DISMISSED
  SNOOZED
  APPLIED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

/// Unified well-being health object: fuses sentiment, toxicity, engagement, burnout,
/// culture and environment signals for a scope (room / team / workspace) over a window.
model HealthSnapshot {
  id                  String          @id @default(uuid())
  workspaceId         String
  scope               WellbeingScope
  scopeId             String
  scopeLabel          String?
  windowHours         Int             @default(24)
  windowStart         DateTime
  windowEnd           DateTime
  messages            Int             @default(0)
  senders             Int             @default(0)
  members             Int             @default(0)
  sentimentScore      Float           @default(0)
  sentimentTrend      Float           @default(0)
  sentimentConfidence Float           @default(0)
  sentimentSampleSize Int             @default(0)
  toxicityScore       Float           @default(0)
  toxicityTrend       Float           @default(0)
  toxicityConfidence  Float           @default(0)
  toxicitySampleSize  Int             @default(0)
  engagementScore     Float           @default(0)
  engagementDetails   Json?
  burnoutRisk         Float           @default(0)
  burnoutComponents   Json?
  cultureAlignment    Float           @default(0)
  cultureComponents   Json?
  environmentComfort  Float           @default(0)
  environmentDetails  Json?
  roomHealthScore     Float           @default(0)
  teamStressScore     Float           @default(0)
  riskLevel           RiskLevel       @default(LOW)
  contributingFactors Json?
  createdById         String?
  createdAt           DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scopeId, windowStart(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

/// Recommendation generated by the observatory when signal thresholds cross.
model WellnessIntervention {
  id          String              @id @default(uuid())
  workspaceId String
  scope       WellbeingScope      @default(WORKSPACE)
  scopeId     String              @default("workspace")
  kind        InterventionKind
  severity    RiskLevel           @default(MODERATE)
  title       String
  message     String
  actions     Json?
  status      InterventionStatus  @default(SUGGESTED)
  snoozedUntil DateTime?
  dismissedBy String?
  dismissedAt DateTime?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, scopeId, createdAt(sort: Desc)])
}

/// Raw environmental sensor reading from a physical room / space.
model EnvironmentalReading {
  id            String   @id @default(uuid())
  workspaceId   String
  roomRef       String
  co2           Int?
  voc           Int?
  pm25          Float?
  temperatureC  Float?
  humidity      Float?
  lightLux      Float?
  noiseDb       Float?
  occupancy     Int?
  source        String   @default("sensor")
  recordedAt    DateTime
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, roomRef, recordedAt(sort: Desc)])
}

/// Aggregated biometric sample. Stored only for users with active consent.
model BiometricReading {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  signals     Json     @default("{}")
  source      String   @default("device")
  recordedAt  DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recordedAt(sort: Desc)])
  @@index([userId, recordedAt(sort: Desc)])
}

/// Explicit, revocable consent for biometric data. Aggregates only; never raw per-user exposure.
model BiometricConsent {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  granted     Boolean   @default(false)
  signals     String[]  @default([])
  sharedWith  String[]  @default([])
  optOutAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}
