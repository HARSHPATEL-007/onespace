// Event Bus (Project Nexus) - canonical cross-module nervous system
// ============================================================

enum EventVisibility {
  INTERNAL
  EXTERNAL
  CONFIDENTIAL
}

enum EventOutboxStatus {
  PENDING
  SENT
  FAILED
  DLQ
}

enum SagaStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  COMPENSATED
}

enum DLQStatus {
  QUARANTINED
  REQUEUED
  DROPPED
}

model EventEnvelope {
  id             String          @id @default(uuid())
  eventId        String          @unique
  eventType      String
  version        String
  schemaVersion  Int             @default(1)
  timestamp      DateTime        @default(now())
  producer       String
  tenantId       String?
  aggregateId    String?
  correlationId  String?
  causationId    String?
  traceId        String?
  idempotencyKey String?
  partitionKey   String?
  visibility     EventVisibility @default(INTERNAL)
  payload        Json            @default("{}")
  retryCount     Int             @default(0)
  published      Boolean         @default(false)
  publishedAt    DateTime?
  consumedHops   Int             @default(0)
  createdAt      DateTime        @default(now())

  @@index([eventType, timestamp])
  @@index([correlationId])
  @@index([traceId])
  @@index([aggregateId])
  @@index([tenantId])
}

model EventOutbox {
  id          String            @id @default(uuid())
  eventId     String            @unique
  envelopeId  String?
  tenantId    String?
  eventType   String
  topic       String
  broker      String            @default("memory")
  envelope    Json              @default("{}")
  status      EventOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  nextRetryAt DateTime?
  error       String?
  enqueuedAt  DateTime          @default(now())
  publishedAt DateTime?
  updatedAt   DateTime          @updatedAt

  @@index([status, nextRetryAt])
  @@index([tenantId, eventType])
}

model IdempotencyRecord {
  id         String    @id @default(uuid())
  handlerKey String
  eventId    String
  effect     String?
  status     String    @default("APPLIED")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([handlerKey, eventId])
  @@index([expiresAt])
}

model EventTraceHop {
  id            String   @id @default(uuid())
  traceId       String
  correlationId String?
  eventId       String
  producer      String?
  consumer      String
  broker        String?
  hop           Int      @default(0)
  status        String   @default("OK")
  latencyMs     Int?
  retryCount    Int      @default(0)
  detail        String?
  at            DateTime @default(now())

  @@index([traceId])
  @@index([correlationId])
  @@index([eventId])
}

model EventDLQ {
  id            String    @id @default(uuid())
  eventId       String    @unique
  eventType     String
  topic         String
  payload       Json      @default("{}")
  reason        String?
  attempts      Int       @default(0)
  status        DLQStatus @default(QUARANTINED)
  quarantinedAt DateTime  @default(now())
  requeuedAt    DateTime?
  resolvedAt    DateTime?
  error         String?

  @@index([status])
  @@index([eventType])
}

model SagaInstance {
  id                String     @id @default(uuid())
  sagaType          String
  tenantId          String?
  correlationId     String
  title             String?
  status            SagaStatus @default(PENDING)
  payload           Json       @default("{}")
  currentStep       Int        @default(0)
  steps             Json       @default("[]")
  compensationStack Json       @default("[]")
  history           Json       @default("[]")
  error             String?
  startedAt         DateTime   @default(now())
  completedAt       DateTime?
  updatedAt         DateTime   @updatedAt

  @@index([sagaType, status])
  @@index([correlationId])
}

model ProjectionCursor {
  name        String    @id
  lastEventId String?
  lastEventAt DateTime?
  version     Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

model ThreadViewProjection {
  id              String   @id @default(uuid())
