// N0VA NEURAL BCI — Brain-Computer Interface integration for Huddles & Flow
// ═══════════════════════════════════════════════════════════════════════════════

/// Granular consent scopes for neural data sharing per user.
model NeuralConsentScope {
  id              String   @id @default(uuid())
  userId          String
  workspaceId     String
  feature         NeuralFeature
  recipient       NeuralRecipient
  duration        ConsentDuration
  privacyMode     PrivacyMode @default(LOCAL_ONLY)
  retentionDays   Int      @default(30)
  epsilon         Float    @default(1.0)
  enabled         Boolean  @default(true)
  revokedAt       DateTime?
  lastConfirmedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stateRecords NeuralStateRecord[]

  @@unique([userId, workspaceId, feature, recipient])
  @@index([userId, workspaceId])
  @@index([userId, feature])
}

/// Ingested neural state records (differentially-private embeddings only).
model NeuralStateRecord {
  id              String   @id @default(uuid())
  userId          String
  workspaceId     String
  source          NeuralSource
  modality        NeuralModality
  samplingRate    Int      @default(250)
  attention       Float    @default(0)
  stress          Float    @default(0)
  cognitiveLoad   Float    @default(0)
  flowProb        Float    @default(0)
  blinkRate       Int      @default(0)
  heartRate       Int?
  embedding       Json
  provenanceHash  String
  consentScopeId  String?
  localOnly       Boolean  @default(true)
  createdAt       DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consentScope NeuralConsentScope? @relation(fields: [consentScopeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, flowProb(sort: Desc)])
}

/// Neural-augmented huddle sessions.
model NeuralHuddleSession {
  id                    String   @id @default(uuid())
  workspaceId           String
  roomId                String?
  createdById           String
  title                 String
  subvocalEnabled       Boolean  @default(false)
  neuralStreamEnabled   Boolean  @default(false)
  latencyTargetMs       Int      @default(25)
