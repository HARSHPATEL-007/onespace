// ═══════════════════════════════════════════════════════════════════════════════
// N0VA NOTIFICATION ENGINE — Policy-Driven Attention System
// ═══════════════════════════════════════════════════════════════════════════════

/// Canonical notification event with scoring metadata.
model NotificationEvent {
  id              String   @id @default(uuid())
  recipientId     String
  workspaceId     String
  sourceType      String
  sourceId        String?
  roomId          String?
  threadId        String?
  title           String
  body            String?
  link            String?
  signals         Json     @default("{}")
  priorityScore   Int      @default(0)
  channelPlan     String[] @default([])
  ruleHits        String[] @default([])
  status          NotificationStatus @default(QUEUED)
  digestId        String?
  escalationLevel Int      @default(0)
  acknowledgedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

   recipient       User    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
   workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
   deliveries      DeliveryRecord[]
   digest          NotificationDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)
   escalationRecords EscalationRecord[]

  @@index([recipientId, status])
  @@index([recipientId, priorityScore(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([digestId])
}

/// Delivery records per channel for reliability tracking.
model DeliveryRecord {
  id              String   @id @default(uuid())
  notificationId  String
  channel         DeliveryChannel
  status          DeliveryStatus @default(PENDING)
  attemptCount    Int      @default(0)
  lastAttemptAt   DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  notification    NotificationEvent @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel])
  @@index([status, createdAt])
}

/// User-defined notification rules with operator-based filters.
model NotificationRule {
  id              String   @id @default(uuid())
  userId          String
  workspaceId     String
  name            String
  enabled         Boolean  @default(true)
  priority        RulePriority @default(NORMAL)
  conditions      Json     @default("[]")
  actions         Json     @default("[]")
  stopProcessing  Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, order])
}

/// User notification preferences per channel and category.
model UserNotificationPrefs {
  id                String   @id @default(uuid())
  userId            String
  workspaceId       String
  channelPrefs      Json     @default("{}")
  quietHoursStart   String?
  quietHoursEnd     String?
  focusModeEnabled  Boolean  @default(false)
  digestFrequency   DigestFrequency @default(HOURLY)
  escalationLevel   Int      @default(2)
  perRoomOverrides  Json     @default("{}")
  perSenderOverrides Json    @default("{}")
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

/// AI-generated digests for burst compression.
model NotificationDigest {
  id              String   @id @default(uuid())
  workspaceId     String
  userId          String
  roomId          String?
  title           String
  summary         String
  highlights      Json     @default("[]")
  decisionChanges Json     @default("[]")
  actionItems     Json     @default("[]")
  mentions        Json     @default("[]")
  messageCount    Int      @default(0)
  status          DigestStatus @default(PENDING)
  createdAt       DateTime @default(now())
  deliveredAt     DateTime?

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          NotificationEvent[]

  @@index([userId, status])
}

/// Escalation tracking for unacknowledged critical alerts.
model EscalationRecord {
  id              String   @id @default(uuid())
  notificationId  String
  userId          String
  workspaceId   String
  currentLevel    Int      @default(0)
  maxLevel        Int      @default(3)
  nextEscalationAt DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  notification    NotificationEvent @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, currentLevel])
}

