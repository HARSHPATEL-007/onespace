  @@index([recordingId, order])
}

/// Extracted action items / calendar intents / decisions from a transcript.
model VoiceExtraction {
  id            String               @id @default(uuid())
  workspaceId   String
  recordingId   String
  kind          VoiceExtractionKind
  category      String
  title         String
  ownerId       String?
  assigneeName  String?
  dueAt         DateTime?
  startAt       DateTime?
  endAt         DateTime?
  durationMin   Int?
  confidence    Float
  priority      String               @default("MEDIUM")
  attendees     Json?
  sourceStartMs Int
  sourceEndMs   Int
  sourceText    String
  state         VoiceExtractionState @default(DRAFT)
  targetType    String?
  targetId      String?
  meta          Json?
  createdAt     DateTime             @default(now())
  confirmedAt   DateTime?

  recording VoiceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
  @@index([state])
  @@index([workspaceId])
  @@index([priority])
}

enum WellbeingScope {
