  @@index([workspaceId, status])
  @@index([workspaceId, kind])
}

/// Evidence-based conformance report with expiry — never "conformant" from a few test messages.
model InteropConformanceReport {
  id           String                   @id @default(uuid())
  workspaceId  String
  interfaceId  String
  interfaceRef InteropInterface         @relation(fields: [interfaceId], references: [id], onDelete: Cascade)
  reportDate   DateTime                 @default(now())
  status       InteropConformanceStatus @default(NOT_TESTED)
  protocol     String?
  capabilities Json                     @default("{}")
  failures     Json                     @default("[]")
  warnings     String[]                 @default([])
  evidence     String[]                 @default([]) // test-run refs
  owner        String?
  expiresAt    DateTime?
  createdById  String?
  createdAt    DateTime                 @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, interfaceId])
  @@index([workspaceId, status])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — OFFLINE-FIRST EDGE RUNTIME
// Secure offline clinical runtime for rural clinics, ambulances, emergency teams,
// mobile outreach, disaster response, field workers. Approved capabilities only when
// disconnected; stale/local labels; queued sync; never unsupervised clinical authority.
// Local data is never globally accepted until server-side validation + sync succeed.
// ═══════════════════════════════════════════════════════════════════════════════

enum OfflineMode {
  ONLINE
  DEGRADED
  OFFLINE
  EMERGENCY_OFFLINE
  RECONNECTING
  SYNCING
  QUARANTINED_SYNC
}

enum OfflineOutboxStatus {
  QUEUED
  UPLOADED
  ACCEPTED
  REJECTED
  CONFLICTED
}

enum OfflineSyncStatus {
  STARTED
  COMPLETED
  COMPLETED_WITH_CONFLICTS
  FAILED
}

enum OfflineConflictStatus {
  OPEN
  HUMAN_REVIEW
  RESOLVED
  ESCALATED
}

enum OfflineStoreForwardStatus {
  CAPTURED
  QUEUED
  UPLOADED
  RECEIVED
  ASSIGNED
  VIEWED
  RESPONDED
  DELIVERED
  ESCALATED
  EXPIRED
  FAILED
  CLOSED
}

/// Enrolled edge device — attested runtime, encryption posture, revocation.
model OfflineDevice {
  id            String      @id @default(uuid())
  workspaceId   String
  deviceId      String // stable hardware/app identifier
  name          String // Community Clinic Tablet 04
  role          String // rural_clinic | ambulance | emergency_team | outreach | disaster | field_worker | hub
  mode          OfflineMode @default(ONLINE)
  status        String      @default("active") // active | locked | wiped | retired | compromised
  lastSeenAt    DateTime    @default(now())
  batteryPct    Int?
  storageFreeMb Int?
  appVersion    String?
  bundleVersion String?
  integrity     String      @default("unverified") // verified | unverified | tampered
  encryption    Json        @default("{}") // { app_level, device_level, key_separation, rotation }
  revokedAt     DateTime?
  wipedAt       DateTime?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, deviceId])
  @@index([workspaceId, status])
  @@index([workspaceId, mode])
}

/// Time-boxed offline credential — expiry + revocation state always visible.
model OfflineCredential {
  id                  String    @id @default(uuid())
  workspaceId         String
  subject             String // authorized-worker-token
  role                String // community_health_worker
  scope               String[]  @default([]) // view_emergency_summary, capture_observations, create_referral
  deviceId            String?
  issuedAt            DateTime  @default(now())
  expiresAt           DateTime
  offlineAllowed      Boolean   @default(true)
  revocationStatus    String    @default("valid") // valid | revoked | last_checked:<ts>
  lastRevocationCheck DateTime?
  signature           String?
  emergencyOnly       Boolean   @default(false)
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, subject])
  @@index([workspaceId, expiresAt])
  @@index([revocationStatus])
}

/// Signed offline knowledge bundle — refuse unsigned/expired/incompatible, fail safe.
model OfflineKnowledgeBundle {
  id           String    @id @default(uuid())
  workspaceId  String
  bundleId     String // nova-cds-rural-2026-09
  version      String // 4.2.0
  scope        String[]  @default([]) // approved low-risk functions
  jurisdiction String?
  approvedBy   String? // clinical-governance-board
  validFrom    DateTime?
  expiresAt    DateTime?
  hash         String? // sha256:...
  signature    String? // digital-signature
  offlineUse   Boolean   @default(true)
  status       String    @default("active") // active | expired | revoked | rolled_back
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, bundleId, version])
  @@index([workspaceId, status])
  @@index([expiresAt])
}

/// Emergency read-only summary (IPS concept) — freshness + limitation labels, server-signed.
model OfflineEmergencySummary {
  id          String    @id @default(uuid())
  workspaceId String
  patientId   String
  summaryRef  String? // ips-...
  generatedAt DateTime  @default(now())
  dataAsOf    DateTime
  payload     Json      @default("{}") // allergies, meds, conditions, procedures, devices, results, contacts, preferences, uncertainties
  provenance  String    @default("server_signed")
  status      String    @default("active") // active | expired | superseded
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([expiresAt])
}

/// Break-glass emergency access — time-limited, minimum necessary, audited, synced.
model OfflineEmergencyAccess {
  id          String    @id @default(uuid())
  workspaceId String
  patientId   String
  workerToken String
  role        String?
  reason      String
  scope       String[]  @default([])
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime
  lockedAt    DateTime? // automatic lock after episode
  syncedAt    DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([expiresAt])
}

/// Append-only sync journal — events, never overwrites. Signed, hashed, sequenced.
model OfflineOutboxEvent {
  id            String              @id @default(uuid()) // globally unique event id
  workspaceId   String
  deviceId      String
  patientId     String?
  resourceRef   String? // patient + resource reference
  operation     String // create | update | delete | message | media | observation
  payload       Json                @default("{}")
  payloadHash   String?
  parentVersion String?
  logicalClock  Int                 @default(0)
  signature     String?
  consentCtx    Json                @default("{}")
  priority      String              @default("routine") // safety | critical | high | routine | bulk
  status        OfflineOutboxStatus @default(QUEUED)
  attempts      Int                 @default(0)
  lastError     String?
  syncedAt      DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, deviceId, status])
  @@index([workspaceId, patientId])
  @@index([status])
  @@index([priority])
}

/// Sync run — counts, integrity checks, conflicts; never display "Synced" with loose ends.
model OfflineSyncSession {
  id                String            @id @default(uuid()) // sync-...
  workspaceId       String
  deviceId          String
  status            OfflineSyncStatus @default(STARTED)
  uploaded          Int               @default(0)
  accepted          Int               @default(0)
  rejected          Int               @default(0)
  conflicts         Int               @default(0)
  downloaded        Int               @default(0)
  hashCheck         String? // passed | failed | pending
  sequenceCheck     String?
  identityCheck     String?
  mediaCheck        String? // passed | pending | failed
  lastServerVersion String?
  nextAction        String?
  finishedAt        DateTime?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deviceId])
  @@index([workspaceId, status])
}

/// Sync conflict — typed default handling; meds/allergies/identity always human-reviewed.
model OfflineSyncConflict {
  id              String                @id @default(uuid())
  workspaceId     String
  deviceId        String?
  type            String // independent_additions | same_field_edits | delete_vs_update | med_start_vs_stop | allergy_add_vs_remove | duplicate_observation | identity_conflict | careplan_versions | terminology_changed | stale_summary
  recordRefs      String[]              @default([])
  patientId       String?
  defaultHandling String? // per data-type rule
  owner           String?
  status          OfflineConflictStatus @default(OPEN)
  resolution      Json                  @default("{}")
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

/// Store-and-forward telehealth object — visible delivery state end to end.
model OfflineStoreForward {
  id                 String                    @id @default(uuid())
  workspaceId        String
  deviceId           String
  patientId          String?
  kind               String // text | voice | image | wound_photo | vitals | video | questionnaire | referral | response | consent | escalation
  payloadRef         String? // encrypted object reference + hash
  payloadHash        String?
  consentRef         String?
  priority           String                    @default("routine") // emergency | urgent | routine
  status             OfflineStoreForwardStatus @default(CAPTURED)
  receiverRole       String?
  respondedAt        DateTime?
  receiptConfirmedAt DateTime?
  expiresAt          DateTime?
  createdById        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, deviceId, status])
  @@index([workspaceId, patientId])
  @@index([status])
}

/// Retention policy per device profile — time/event/hold distinguished; crypto-erase.
model OfflineRetentionPolicy {
  id            String   @id @default(uuid())
  workspaceId   String
  deviceProfile String // rural_field_worker | ambulance | ...
  retention     Json     @default("{}") // per data-type rules
  deletion      Json     @default("{}") // { method, requires_server_ack, legal_hold_override }
  active        Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, deviceProfile])
  @@index([workspaceId, active])
}

/// Security incident — lost/stolen/tamper; revoke/lock/wipe/erase + reconcile + notify.
model OfflineSecurityIncident {
  id          String    @id @default(uuid())
  workspaceId String
  deviceId    String
  kind        String // lost | stolen | failed_logins | rooted | tampered | bad_signature | unexpected_export | clock_manipulation | cert_failure | suspicious_sync | data_mismatch | unauthorized_emergency
  detail      String?
  actions     Json      @default("[]") // revoke_device, revoke_credentials, lock_app, wipe_key, crypto_erase, block_sync, preserve_forensics, notify_owners, reconcile_events, notify_patients
  status      String    @default("open") // open | contained | resolved | closed
  resolvedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, deviceId])
}

/// Observability snapshot — never used to penalize workers for network/power gaps.
model OfflineDeviceReport {
  id                 String   @id @default(uuid())
  workspaceId        String
  deviceId           String
  offlineMinutes     Int      @default(0)
  batteryPct         Int?
  storageFreeMb      Int?
  queueSize          Int      @default(0)
  criticalBacklog    Int      @default(0)
  syncDurationMs     Int?
  syncSuccess        Boolean?
  conflictCount      Int      @default(0)
  rejectionCount     Int      @default(0)
  duplicateCount     Int      @default(0)
  integrityFails     Int      @default(0)
  credentialDaysLeft Int?
  bundleExpired      Boolean  @default(false)
  emergencyAccesses  Int      @default(0)
  cdsUses            Int      @default(0)
  mediaFailures      Int      @default(0)
  createdAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deviceId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA HEALTH — EVENT-DRIVEN TRANSACTION RELIABILITY
// Healthcare Transaction Reliability Layer: cross-module operations stay safe when
// services fail, messages duplicate, networks break, or humans must intervene.
// "Accepted / in progress / partially completed / needs review / completed" are
// visible states, never hidden implementation details. Local transactions + durable
// events + idempotent participants + explicit compensation + approval gates +
// reconciliation. Never confuse "request accepted" with "patient safe".
// ═══════════════════════════════════════════════════════════════════════════════

enum TxnSagaStatus {
  RECEIVED
  VALIDATING
  AWAITING_AUTHORIZATION
  AWAITING_PATIENT_CONFIRMATION
  ACCEPTED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  AWAITING_DEPENDENCY
  AWAITING_HUMAN_REVIEW
  COMPENSATING
  RECONCILIATION_REQUIRED
  COMPLETED
  COMPLETED_WITH_EXCEPTION
  FAILED_SAFELY
  CANCELLED
}

enum TxnStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  RETRYING
  AWAITING_CHECKPOINT
  COMPENSATED
  SKIPPED
  NOT_STARTED
  UNKNOWN_OUTCOME
}

enum TxnOutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD
}

enum TxnInboxStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

enum TxnCheckpointDecision {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

enum TxnCompensationKind {
  TECHNICAL_UNDO
  CLINICAL_CORRECTION
  PATIENT_NOTIFICATION
  ADMINISTRATIVE_CORRECTION
  FORWARD_RECOVERY
}

enum TxnCompensationStatus {
  PLANNED
  EXECUTING
  COMPLETED
  FAILED
}

enum TxnDlqStatus {
  OPEN
  ASSIGNED
  DRY_RUN
  REDRIVEN
  RESOLVED
  EXPIRED
}

/// Saga instance — one orchestrated multi-step clinical business process.
model HealthTxnSaga {
  id            String        @id @default(uuid())
  workspaceId   String
  sagaId        String // txn-... / saga-...
  commandType   String // create_medication_order, create_referral, ...
  aggregateType String // medication_plan, referral, discharge_plan, ...
  aggregateId   String
  patientId     String?
  initiator     String?
  purpose       String        @default("care_delivery")
  priority      String        @default("routine") // critical | urgent | high | routine | administrative | analytics
  status        TxnSagaStatus @default(RECEIVED)
  currentStep   String?
  deadline      DateTime?
  owner         String?
  lastError     String?
  auditRef      String?
  consentRef    String?
  correlationId String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient       HealthPatient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  steps         HealthTxnStep[]
  checkpoints   HealthTxnCheckpoint[]
  compensations HealthTxnCompensation[]

  @@unique([workspaceId, sagaId])
  @@index([workspaceId, status])
  @@index([workspaceId, commandType])
  @@index([workspaceId, patientId])
  @@index([workspaceId, aggregateType, aggregateId])
  @@index([deadline])
}

/// One saga step — local action, checkpoint gate, retry, or compensation link.
model HealthTxnStep {
  id              String        @id @default(uuid())
  workspaceId     String
  sagaId          String
  saga            HealthTxnSaga @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  seq             Int
  name            String // validate_patient, pharmacy_notify, patient_confirmation, ...
  kind            String        @default("local_action") // local_action | human_checkpoint | compensation | notification | reconciliation
  status          TxnStepStatus @default(PENDING)
  attempts        Int           @default(0)
  maxAttempts     Int           @default(3)
  owner           String?
  result          Json          @default("{}")
  compensationFor String? // step id this compensates, if kind == compensation
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([sagaId, seq])
  @@index([workspaceId, sagaId])
  @@index([workspaceId, status])
}

/// Idempotency registry — repeat key returns original result, never duplicates side effects.
model HealthTxnCommand {
  id             String    @id @default(uuid())
  workspaceId    String
  idempotencyKey String // tenant:command:aggregate:nonce
  commandType    String
  aggregateType  String
  aggregateId    String
  requestHash    String
  actor          String?
  firstSeenAt    DateTime  @default(now())
  response       Json      @default("{}")
  resultRef      String? // saga id
  status         String    @default("accepted") // accepted | in_progress | completed | failed
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, commandType])
  @@index([workspaceId, aggregateType, aggregateId])
  @@index([expiresAt])
}

/// Transactional outbox — DB update + event insert commit atomically; publisher sends later.
model HealthTxnOutbox {
  id            String          @id @default(uuid())
  workspaceId   String
  eventId       String // event-...
  aggregateType String
  aggregateId   String
  eventType     String // referral.created, pharmacy.notify, ...
  payload       Json            @default("{}")
  schemaVersion String          @default("1.0")
  causationId   String?
  correlationId String?
  sagaId        String?
  status        TxnOutboxStatus @default(PENDING)
  attemptCount  Int             @default(0)
  nextAttemptAt DateTime?
  publishedAt   DateTime?
  payloadHash   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventId])
  @@index([workspaceId, status])
  @@index([workspaceId, aggregateType, aggregateId])
  @@index([nextAttemptAt])
}

/// Consumer inbox — processed-event registry; duplicates return prior result.
model HealthTxnInbox {
  id          String         @id @default(uuid())
  workspaceId String
  consumer    String // pharmacy-notification-service, ...
  eventId     String // event-...
  eventHash   String?
  status      TxnInboxStatus @default(RECEIVED)
  resultRef   String?
  attempts    Int            @default(0)
  receivedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, consumer, eventId])
  @@index([workspaceId, consumer])
  @@index([workspaceId, status])
}

/// Append-only, hash-chained event history — corrections are new events, never edits.
model HealthTxnEvent {
  id                 String   @id @default(uuid())
  workspaceId        String
  eventId            String // event-...
  eventType          String
  schemaVersion      String   @default("1.0")
  aggregateType      String
  aggregateId        String
  patientId          String?
  actor              String?
  sagaId             String?
  causationId        String?
  correlationId      String?
  purpose            String   @default("clinical_care")
  consentRef         String?
  source             String?
  payload            Json     @default("{}")
  payloadHash        String?
  previousHash       String?
  signature          String?
  dataClassification String   @default("phi")
  retentionClass     String   @default("clinical")
  createdAt          DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, eventId])
  @@index([workspaceId, aggregateType, aggregateId])
  @@index([workspaceId, sagaId])
  @@index([workspaceId, patientId])
  @@index([workspaceId, eventType])
  @@index([createdAt])
}

/// Human approval checkpoint — mandatory for treatment/rights/understanding actions.
model HealthTxnCheckpoint {
  id           String                @id @default(uuid())
  workspaceId  String
  sagaId       String
  saga         HealthTxnSaga         @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  step         String // patient_confirmation, clinician_approval, ...
  requiredRole String // patient, clinician, pharmacist, ...
  fallbackRole String?
  evidence     Json                  @default("[]")
  decision     TxnCheckpointDecision @default(PENDING)
  decidedBy    String?
  decidedAt    DateTime?
  expiresAt    DateTime?
  auditRef     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sagaId])
  @@index([workspaceId, decision])
  @@index([expiresAt])
}

/// Compensation — technical undo vs clinical correction vs forward recovery (never silent delete).
model HealthTxnCompensation {
  id          String                @id @default(uuid())
  workspaceId String
  sagaId      String
  saga        HealthTxnSaga         @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  stepId      String?
  kind        TxnCompensationKind
  action      String // keep_order_retry_pharmacy, send_correction, escalate_owner, ...
  detail      Json                  @default("{}")
  status      TxnCompensationStatus @default(PLANNED)
  owner       String?
  auditRef    String?
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sagaId])
  @@index([workspaceId, status])
}

/// Dead-letter queue — encrypted, owned, SLA'd; critical-clinical escalates immediately.
model HealthTxnDlq {
  id           String       @id @default(uuid())
  workspaceId  String
  category     String // critical-clinical-dlq | medication-dlq | referral-dlq | ...
  eventRef     String? // outbox event id
  payload      Json         @default("{}")
  metadata     Json         @default("{}")
  reason       String
  priority     String       @default("routine") // critical | urgent | high | routine
  owner        String?
  sla          String?
  status       TxnDlqStatus @default(OPEN)
  redriveCount Int          @default(0)
  lastRedrive  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@index([workspaceId, priority])
}

/// Reconciliation run — intended vs recorded vs external vs patient-visible vs audit.
model HealthTxnReconciliation {
  id          String   @id @default(uuid())
  workspaceId String
  scope       String // saga id, aggregate ref, or cadence label (continuous|urgent|hourly|daily|deep)
  status      String   @default("running") // running | completed | issues_found
  findings    Json     @default("[]") // [{ kind, ref, detail, resolution }]
  resolved    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, scope])
}

/// Service dependency policy — required/optional deps, degraded + emergency fallback.
model HealthTxnDependency {
  id                String   @id @default(uuid())
  workspaceId       String
  module            String // medication_service, ...
  required          String[] @default([])
  optional          String[] @default([])
  degradedModes     Json     @default("{}") // { dependency: { behavior, patient_message, max_stale_time } }
  emergencyFallback String?
  cacheable         String[] @default([])
  maxStaleTime      String?
  humanFallback     String?
  recoveryAction    String?
  patientMessage    String?
  active            Boolean  @default(true)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, module])
  @@index([workspaceId, active])
}

/// N0VA LEGAL - revision history.
model LegalDocRevision {
  id          String   @id @default(uuid())
  docId       String
  workspaceId String
  createdById String?
  content     String
  createdAt   DateTime @default(now())

  doc       LegalDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull, name: "createdLegalDocRevisions")

  @@index([docId, createdAt(sort: Desc)])
}

/// N0VA SALES - activity notes on deals.
model DealNote {
  id          String   @id @default(uuid())
  dealId      String
  workspaceId String
  createdById String?
  body        String
  createdAt   DateTime @default(now())

  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull, name: "createdDealNotes")

  @@index([dealId, createdAt(sort: Desc)])
}

/// N0VA OPERATIONS & TEAMS - incident timeline.
model IncidentUpdate {
  id          String   @id @default(uuid())
  incidentId  String
  workspaceId String
  createdById String?
  body        String
  createdAt   DateTime @default(now())

  incident  Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull, name: "createdIncidentUpdates")

  @@index([incidentId, createdAt(sort: Desc)])
}

/// N0VA ADMIN - persisted per-workspace module enablement.
model WorkspaceModuleSetting {
  id          String   @id @default(uuid())
  workspaceId String
  moduleId    String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleId])
}

/// N0VA ADMIN CONSOLE - member invites.
model Invite {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        String    @default("MEMBER")
  token       String
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull, name: "createdInvites")

  @@unique([workspaceId, email])
  @@index([token])
}

// ═══════════════════════════════════════════════════════════════════════════════
// N0VA NEURAL BCI — Brain-Computer Interface integration for Huddles & Flow
// ═══════════════════════════════════════════════════════════════════════════════

/// Granular consent scopes for neural data sharing per user.
model NeuralConsentScope {
  id              String          @id @default(uuid())
  userId          String
  workspaceId     String
  feature         NeuralFeature
  recipient       NeuralRecipient
  duration        ConsentDuration
  privacyMode     PrivacyMode     @default(LOCAL_ONLY)
  retentionDays   Int             @default(30)
  epsilon         Float           @default(1.0)
  enabled         Boolean         @default(true)
  revokedAt       DateTime?
  expiresAt       DateTime? // §10 — expiry-bound consent (null = PERSISTENT)
  lastConfirmedAt DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stateRecords NeuralStateRecord[]

  @@unique([userId, workspaceId, feature, recipient])
  @@index([userId, workspaceId])
  @@index([userId, feature])
}

/// Ingested neural state records (differentially-private embeddings only).
model NeuralStateRecord {
  id             String         @id @default(uuid())
  userId         String
  workspaceId    String
  source         NeuralSource
  modality       NeuralModality
  samplingRate   Int            @default(250)
  attention      Float          @default(0)
  stress         Float          @default(0)
  cognitiveLoad  Float          @default(0)
  flowProb       Float          @default(0)
  blinkRate      Int            @default(0)
  heartRate      Int?
  confidence     Float          @default(0) // §6 — probabilistic estimate, not ground truth
  corrected      Boolean        @default(false) // §6 — user-corrected via self-report/feedback
  selfReport     Boolean        @default(false) // §6 — signal came from voluntary user feedback
  embedding      Json
  provenanceHash String
  consentScopeId String?
  localOnly      Boolean        @default(true)
  createdAt      DateTime       @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consentScope NeuralConsentScope? @relation(fields: [consentScopeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, flowProb(sort: Desc)])
}

/// Neural-augmented huddle sessions.
model NeuralHuddleSession {
  id                  String       @id @default(uuid())
  workspaceId         String
  roomId              String?
  createdById         String
  title               String
  subvocalEnabled     Boolean      @default(false)
  neuralStreamEnabled Boolean      @default(false)
  latencyTargetMs     Int          @default(25)
  codecProfile        String       @default("opus_48k_stereo")
  privacyPolicyId     String       @default("neural_v1")
  status              HuddleStatus @default(SCHEDULED)
  startedAt           DateTime?
  endedAt             DateTime?
  eventStreamTopic    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User                      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  room         MeetRoom?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participants NeuralHuddleParticipant[]
  streams      NeuralStreamEndpoint[]

  @@index([workspaceId, status])
  @@index([createdById])
}

model NeuralHuddleParticipant {
  id               String    @id @default(uuid())
  sessionId        String
  userId           String
  role             String    @default("participant")
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?
  neuralStreamOk   Boolean   @default(false)
  subvocalOk       Boolean   @default(false)
  sharedState      String? // §2/§4 — coarse user-controlled state
  sharedConfidence Float? // §8 — decoding confidence for the shared state
  handRaised       Boolean   @default(false) // §2 — silent "raise hand"
  paused           Boolean   @default(false) // §8 — neural signal pause
  consentVersion   Int       @default(1) // §8 — consent indicator (which consent version joined with)

  session NeuralHuddleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
}

model NeuralStreamEndpoint {
  id           String             @id @default(uuid())
  sessionId    String
  userId       String
  endpointType StreamEndpointType
  endpointUrl  String
  ephemeralKey String?
  expiresAt    DateTime
  createdAt    DateTime           @default(now())

  session NeuralHuddleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

/// Attention maps fusing model attention with neural correlation.
model AttentionMap {
  id                    String      @id @default(uuid())
  contextId             String
  contextType           ContextType
  workspaceId           String
  userId                String?
  tokenPositions        Json        @default("[]")
  modelAttentionWeights Json        @default("[]")
  neuralAttentionCorr   Json        @default("[]")
  relevanceScore        Float       @default(0)
  createdAt             DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contextId])
  @@index([workspaceId, contextType])
  @@index([userId, relevanceScore(sort: Desc)])
}

/// Flow-state change events for UI adaptation and analytics.
model FlowStateEvent {
  id          String      @id @default(uuid())
  userId      String
  workspaceId String
  fromState   FlowState
  toState     FlowState
  flowProb    Float
  trigger     FlowTrigger
  actionTaken String?
  createdAt   DateTime    @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, toState])
}

/// Sub-vocal command decoding results.
model SubVocalCommand {
  id           String   @id @default(uuid())
  userId       String
  workspaceId  String
  sessionId    String?
  rawText      String
  command      String?
  confidence   Float
  latencyMs    Int
  executed     Boolean  @default(false)
  fallbackUsed Boolean  @default(false)
  createdAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId])
}

