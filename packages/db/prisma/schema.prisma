/// FHIR Consent + N0VA extensions — WHO/WHAT/WHY/HOW/WHEN/WHERE/CONDITIONS.
model HealthWalletConsent {
  id                        String               @id @default(uuid())
  workspaceId               String
  patientId                 String
  consentId                 String               @unique // FHIR Consent.id
  status                    WalletConsentStatus  @default(ACTIVE)
  version                   Int                  @default(1)
  // WHO
  recipientType             String // organization | practitioner | care_team | research_team | insurer | device_provider | emergency_responder | n0va_service
  recipientId               String
  recipientRoles            String[]             @default([])
  // WHAT
  dataDomains               WalletDataDomain[]   @default([])
  excludedDomains           WalletDataDomain[]   @default([])
  specificRecords           String[]             @default([]) // resource IDs
  derivedAllow              Json                 @default("{}") // { health_summary, risk_scores, embeddings, model_training: bool }
  // WHY
  purposes                  WalletPurpose[]      @default([])
  // HOW
  actions                   WalletAction[]       @default([])
  // WHEN
  validFrom                 DateTime?
  validUntil                DateTime?
  oneTimeUse                Boolean              @default(false)
  reconsentInterval         Int? // days
  // WHERE
  jurisdictions             String[]             @default([]) // IN-GJ, US-CA, etc.
  institutions              String[]             @default([])
  // CONDITIONS
  minimumNecessary          Boolean              @default(true)
  deidentification          String? // none | pseudonymized | anonymized
  aggregation               String? // none | aggregated
  humanReviewRequired       Boolean              @default(false)
  noOnwardSharing           Boolean              @default(false)
  noAutomatedClinicalAction Boolean              @default(false)
  noCommercialUse           Boolean              @default(false)
  processingMode            WalletProcessingMode @default(CONFIDENTIAL_CLOUD)
  // Provenance — layered UX
  language                  String               @default("en")
  consentVersion            String               @default("patient-consent-3.1")
  explanationShown          Boolean              @default(false)
  understandingConfirmed    Boolean              @default(false)
  signedAt                  DateTime?
  // Inheritance
  inheritanceEnabled        Boolean              @default(false)
  inheritanceRules          Json                 @default("{}")
  // FHIR + N0VA
  fhirConsent               Json? // full FHIR R4 Consent resource
  policyVersion             String               @default("wallet-policy-4.2")
  createdById               String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  revokedAt                 DateTime?
  revokedReason             String?

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  events    HealthWalletConsentEvent[]
  accesses  HealthWalletAccessLedger[]

  @@index([workspaceId, patientId])
  @@index([workspaceId, status])
  @@index([patientId, status])
  @@index([validUntil])
}

/// Immutable consent event ledger — SHA256 hash chain per patient.
model HealthWalletConsentEvent {
  id             String   @id @default(uuid())
  workspaceId    String
  patientId      String
  consentId      String
  eventType      String // CONSENT_GRANTED | CONSENT_REVOKED | CONSENT_MODIFIED | CONSENT_EXPIRED | BREAK_GLASS_USED | CORRECTION_REQUESTED | EXPORT_CREATED | DELETION_REQUESTED | RESTRICTION_APPLIED | RESEARCH_WITHDRAWN
  actor          String // patient | caregiver | clinician | system
  authentication String? // passkey_step_up, etc.
  scope          Json     @default("{}")
  effectiveAt    DateTime @default(now())
  enforcement    Json     @default("{}") // { api_tokens_revoked, subscriptions_cancelled, model_processing_blocked, downstream_notifications_sent, deletion_jobs_created }
  previousHash   String?
  eventHash      String
  createdAt      DateTime @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consent   HealthWalletConsent @relation(fields: [consentId], references: [consentId], onDelete: Cascade)

  @@index([workspaceId, patientId])
  @@index([consentId])
  @@index([eventType])
}

/// Patient-visible access history — who accessed what, translated.
model HealthWalletAccessLedger {
  id              String           @id @default(uuid())
  workspaceId     String
  patientId       String
  consentId       String? // null = denied / break-glass
  accessorId      String?
  accessorName    String?
  organization    String?
  role            String?
  timestamp       DateTime         @default(now())
  location        String?
  device          String?
  dataCategory    WalletDataDomain
  recordsViewed   String[]         @default([])
  purpose         WalletPurpose?
  action          WalletAction?
  downloaded      Boolean          @default(false)
  aiInferenceRun  Boolean          @default(false)
  onwardSharing   Boolean          @default(false)
  breakGlass      Boolean          @default(false)
  denied          Boolean          @default(false)
  anomalyDetected Boolean          @default(false)
  anomalyReason   String?
  explanation     String? // human-readable: "A cardiology nurse viewed your BP trend to prepare for your appointment."
  createdAt       DateTime         @default(now())

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   HealthPatient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
